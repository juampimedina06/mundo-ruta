<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <!-- Fuentes del Sistema de Diseño: Plus Jakarta Sans, Manrope, Inter y Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
