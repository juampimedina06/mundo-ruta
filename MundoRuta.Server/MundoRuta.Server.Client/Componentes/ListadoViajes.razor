<div class="row g-2 mb-3">
    <div class="col-12 col-md-4">
        <input type="search" class="form-control" placeholder="Buscar por origen, destino o pasajero..."
               @bind="textoBusqueda" @bind:event="oninput" />
    </div>
    <div class="col-6 col-md-2">
        <select class="form-select" @bind="estadoFiltro">
            <option value="">Todos los estados</option>
            @foreach (var e in Estados)
            {
                <option value="@e">@e</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <input type="date" class="form-control" title="Fecha desde" @bind="fechaDesde" />
    </div>
    <div class="col-6 col-md-2">
        <input type="date" class="form-control" title="Fecha hasta" @bind="fechaHasta" />
    </div>
    <div class="col-6 col-md-2">
        <button class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltros">Limpiar</button>
    </div>
</div>

@if (Viajes is null)
{
    <p><em>Cargando...</em></p>
}
else if (!Filtrados.Any())
{
    <div class="alert alert-light border">@MensajeVacio</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Ruta</th>
                    <th>Fecha</th>
                    <th>Pasajero</th>
                    <th>Estado</th>
                    <th class="text-end">Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Filtrados)
                {
                    <tr>
                        <td>@v.Origen &rarr; @v.Destino</td>
                        <td>@v.Fecha.ToFechaCorta() <small class="text-muted">@v.Hora.ToHoraCorta()</small></td>
                        <td>@v.NombrePasajero</td>
                        <td><span class="badge @ClaseEstado(v.Estado)">@v.Estado</span></td>
                        <td class="text-end">@((v.Monto > 0 ? v.Monto : v.MontoEstimado).ToMonto())</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <small class="text-muted">@Filtrados.Count() de @Viajes.Count resultado(s)</small>
}

@code {
    [Parameter] public List<ViajePrestadorDTO>? Viajes { get; set; }
    [Parameter] public string MensajeVacio { get; set; } = "No hay viajes para mostrar.";

    private string textoBusqueda = "";
    private string estadoFiltro = "";
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;

    private IEnumerable<string> Estados =>
        (Viajes ?? new()).Select(v => v.Estado).Where(e => !string.IsNullOrWhiteSpace(e)).Distinct().OrderBy(e => e);

    private IEnumerable<ViajePrestadorDTO> Filtrados
    {
        get
        {
            var q = (Viajes ?? new()).AsEnumerable();

            if (!string.IsNullOrWhiteSpace(textoBusqueda))
            {
                var t = textoBusqueda.Trim();
                q = q.Where(v =>
                    v.Origen.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                    v.Destino.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                    v.NombrePasajero.Contains(t, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrEmpty(estadoFiltro))
                q = q.Where(v => v.Estado == estadoFiltro);

            if (fechaDesde.HasValue)
                q = q.Where(v => v.Fecha.Date >= fechaDesde.Value.Date);

            if (fechaHasta.HasValue)
                q = q.Where(v => v.Fecha.Date <= fechaHasta.Value.Date);

            return q;
        }
    }

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        estadoFiltro = "";
        fechaDesde = null;
        fechaHasta = null;
    }

    private static string ClaseEstado(string estado) => estado?.ToUpperInvariant() switch
    {
        "PENDIENTE" => "bg-warning text-dark",
        "ACEPTADO" => "bg-primary",
        "CONTRAOFERTADO" => "bg-info text-dark",
        "FINALIZADO" => "bg-success",
        "RECHAZADO" or "CANCELADO" => "bg-danger",
        _ => "bg-secondary"
    };
}
