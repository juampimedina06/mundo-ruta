@inject SesionEstado Sesion
@inject NavigationManager Navegacion
@implements IDisposable

<header class="mr-navbar">
    <div class="mr-navbar__inner">
        <a class="mr-navbar__brand" href="@(Sesion.EstaLogueado ? RutaInicioPorRol.Obtener(Sesion.Rol) : "/")">
            <div class="mr-navbar__logo-box">
                <span class="material-symbols-outlined mr-navbar__logo-icon">local_shipping</span>
            </div>
            <div class="mr-navbar__brand-copy">
                <span class="mr-navbar__brand-title">Mundo Ruta</span>
                <span class="mr-navbar__brand-subtitle">Logística Integral</span>
            </div>
        </a>

        <button type="button" class="mr-navbar__toggle" aria-label="Abrir menú" @onclick="AlternarMenu">
            <span class="mr-navbar__toggle-linea"></span>
            <span class="mr-navbar__toggle-linea"></span>
            <span class="mr-navbar__toggle-linea"></span>
        </button>

        <nav class="mr-navbar__nav @(_menuAbierto ? "mr-navbar__nav--abierto" : string.Empty)">
            @foreach (MenuItem item in MenuPorRol.Obtener(Sesion.Rol))
            {
                <NavLink class="mr-navbar__link" href="@item.Href" Match="@ObtenerCoincidencia(item.Href)" @onclick="CerrarMenu">
                    @item.Texto
                </NavLink>
            }
            @if (!Sesion.EstaLogueado)
            {
                <a class="mr-navbar__link" href="/#como-funciona" @onclick="CerrarMenu">Nosotros</a>
            }
        </nav>

        <div class="mr-navbar__acciones">
            @if (Sesion.EstaLogueado)
            {
                <div class="mr-navbar__user-wrap">
                    <div class="mr-navbar__user-info">
                        <span class="mr-navbar__user-name">@Sesion.Nombre</span>
                        <span class="mr-navbar__user-role">@Sesion.Rol</span>
                    </div>
                    <div class="mr-navbar__user-avatar">
                        <span class="material-symbols-outlined mr-navbar__user-icon">person</span>
                    </div>
                    <button type="button" class="mr-navbar__btn-logout" @onclick="CerrarSesion">
                        Cerrar sesión
                    </button>
                </div>
            }
            else
            {
                <a class="mr-navbar__btn-login" href="/login">Iniciar sesión</a>
                <a class="mr-navbar__btn-register" href="/registro">Registrarse</a>
            }
        </div>
    </div>
</header>

@code {
    private bool _menuAbierto;

    protected override void OnInitialized()
    {
        Sesion.CambioSesion += AlCambiarSesion;
    }

    public void Dispose()
    {
        Sesion.CambioSesion -= AlCambiarSesion;
    }

    private void AlCambiarSesion()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void AlternarMenu()
    {
        _menuAbierto = !_menuAbierto;
    }

    private void CerrarMenu()
    {
        _menuAbierto = false;
    }

    private void CerrarSesion()
    {
        Sesion.Cerrar();
        Navegacion.NavigateTo("/");
    }

    private static NavLinkMatch ObtenerCoincidencia(string href)
    {
        return href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix;
    }
}
