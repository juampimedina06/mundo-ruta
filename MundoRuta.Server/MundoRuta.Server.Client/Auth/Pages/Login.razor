@page ""/login""
@layout MundoRuta.Server.Client.Auth.Layouts.AuthLayout
@inject IAuthClientService AuthClientService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class=""auth-card"">
    <h2 class=""auth-title"">Iniciar Sesión</h2>
    <EditForm Model=""this"" OnValidSubmit=""HandleLogin"">
        <DataAnnotationsValidator />
        <div class=""form-group"">
            <label class=""form-label"">Correo electrónico</label>
            <InputText class=""input"" @bind-Value=""Email"" type=""email"" />
        </div>
        <div class=""form-group"">
            <label class=""form-label"">Contraseña</label>
            <InputText class=""input"" @bind-Value=""Password"" type=""password"" />
        </div>
        <button class=""btn btn-primary"" style=""width:100%"" type=""submit"">Iniciar Sesión</button>
    </EditForm>
    @if (!string.IsNullOrEmpty(Error))
    {
        <div style=""color: #d33; margin-top: 1rem; text-align:center;"">@Error</div>
    }
    <div style=""text-align:center; margin-top:1rem;"">
        <a href=""/registro"">¿No tienes cuenta? Regístrate</a>
    </div>
</div>

@code {
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string Error { get; set; } = string.Empty;

    private async Task HandleLogin()
    {
        Error = string.Empty;
        var ok = await AuthClientService.LoginAsync(Email, Password);
        if (!ok)
        {
            Error = ""Credenciales inválidas o usuario no habilitado"";
            return;
        }

        var rol = await JS.InvokeAsync<string>("localStorage.getItem", "mr_rol");
        rol = rol?.Trim() ?? string.Empty;

        if (string.Equals(rol, "Admin", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/admin");
            return;
        }
        if (string.Equals(rol, "Prestador", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/prestador");
            return;
        }
        if (string.Equals(rol, "Chofer", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/chofer");
            return;
        }

        Navigation.NavigateTo("/pasajero");
    }
}
