@page "/chofer/login"
@using MundoRuta.Shared
@using MundoRuta.Shared.DTO
@using MundoRuta.Servicios.Auth
@using MundoRuta.Servicios.Sesion
@using MundoRuta.Servicios.ServiciosHTTP
@inject IAuthServicio Auth
@inject SesionEstado Sesion
@inject NavigationManager Navegacion

<PageTitle>Ingreso Chofer | Mundo Ruta</PageTitle>

<div class="mr-page">
    <div class="mr-container mr-auth">
        <div class="mr-card mr-auth__card" style="max-width: 420px; margin: 40px auto; padding: 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); background: #ffffff;">
            <div style="text-align: center; margin-bottom: 24px;">
                <div style="display: inline-block; background: #e0f2fe; color: #0284c7; padding: 12px 18px; border-radius: 50%; font-size: 28px; margin-bottom: 12px;">
                    🚚
                </div>
                <h1 style="font-size: 24px; font-weight: 700; color: #1e293b; margin: 0;">Portal del Conductor</h1>
                <p style="font-size: 14px; color: #64748b; margin-top: 6px;">Acceso exclusivo para choferes asignados</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger" style="border-radius: 8px; font-size: 14px; padding: 10px 14px;" role="alert">
                    @_error
                </div>
            }

            <EditForm Model="_modelo" OnSubmit="IngresarChoferAsync">
                <div class="mb-3">
                    <label class="form-label" for="email" style="font-weight: 600; font-size: 13px; color: #334155;">Email del conductor</label>
                    <InputText id="email" class="form-control" type="email" autocomplete="email" placeholder="chofer@ejemplo.com" @bind-Value="_modelo.Email" />
                </div>

                <div class="mb-4">
                    <label class="form-label" for="password" style="font-weight: 600; font-size: 13px; color: #334155;">Contraseña</label>
                    <InputText id="password" class="form-control" type="password" autocomplete="current-password" placeholder="••••••••" @bind-Value="_modelo.Password" />
                </div>

                <button type="submit" class="btn btn-primary w-100" style="padding: 10px; font-weight: 600; border-radius: 8px;" disabled="@_cargando">
                    @(_cargando ? "Validando acceso..." : "Iniciar Sesión como Chofer")
                </button>
            </EditForm>

            <div style="margin-top: 20px; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 15px;">
                <span style="font-size: 13px; color: #64748b;">¿Sos prestador o pasajero? </span>
                <a href="/login" style="font-size: 13px; color: #0284c7; text-decoration: none; font-weight: 600;">Ingreso general</a>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginRequestDto _modelo = new LoginRequestDto();
    private bool _cargando;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Sesion.EstaLogueado && Sesion.Rol == Roles.Chofer)
        {
            Navegacion.NavigateTo("/chofer/home");
        }
    }

    private async Task IngresarChoferAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_modelo.Email) || string.IsNullOrWhiteSpace(_modelo.Password))
        {
            _error = "Ingresá tu email y contraseña.";
            return;
        }

        _cargando = true;

        try
        {
            HttpResp<LoginResponseDto> respuesta = await Auth.LoginAsync(_modelo);

            if (respuesta.Error)
            {
                _error = await respuesta.ObtenerMensajeAsync("Credenciales incorrectas o acceso no autorizado.");
                return;
            }

            if (!string.Equals(Sesion.Rol, Roles.Chofer, StringComparison.OrdinalIgnoreCase))
            {
                Auth.Logout();
                _error = "Esta cuenta no tiene rol de Chofer. Accedé por el login general.";
                return;
            }

            Navegacion.NavigateTo("/chofer/home");
        }
        catch (Exception ex)
        {
            _error = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }
}
