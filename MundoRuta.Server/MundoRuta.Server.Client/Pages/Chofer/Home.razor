@page "/chofer/home"
@page "/chofer"
@layout ChoferLayout
@using MundoRuta.Shared
@using MundoRuta.Shared.DTO
@using MundoRuta.Servicios.Chofer
@using MundoRuta.Servicios.Sesion
@using MundoRuta.Servicios.Realtime
@using MundoRuta.Server.Client.Components
@inject IChoferServicio ChoferServicio
@inject SesionEstado Sesion
@inject IViajeHubService ViajeHubService
@inject NavigationManager Navegacion
@implements IDisposable

<PageTitle>Panel Conductor | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Chofer">
    <div class="cn-map-stage">
        <div class="cn-map-canvas">
            <!-- Mapa Cartográfico Nocturno -->
            <svg class="cn-map-svg"
                 style="transform: scale(@_zoom.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));"
                 preserveAspectRatio="xMidYMid slice"
                 viewBox="0 0 1600 1000"
                 xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <pattern id="cnUrbanGrid" width="55" height="55" patternUnits="userSpaceOnUse">
                        <rect x="2" y="2" width="23" height="23" rx="2" fill="#131d33" opacity="0.85" />
                        <rect x="28" y="2" width="24" height="23" rx="2" fill="#131d33" opacity="0.85" />
                        <rect x="2" y="28" width="23" height="24" rx="2" fill="#131d33" opacity="0.85" />
                        <rect x="28" y="28" width="24" height="24" rx="2" fill="#15213b" opacity="0.9" />
                    </pattern>
                    <radialGradient id="cnHeatZone" cx="65%" cy="38%" r="28%">
                        <stop offset="0%" stop-color="#ffb95f" stop-opacity="0.30" />
                        <stop offset="45%" stop-color="#ca8100" stop-opacity="0.14" />
                        <stop offset="100%" stop-color="#0b1326" stop-opacity="0" />
                    </radialGradient>
                    <radialGradient id="cnTelemetryPulse" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#4c8eff" stop-opacity="0.32" />
                        <stop offset="60%" stop-color="#4c8eff" stop-opacity="0.08" />
                        <stop offset="100%" stop-color="#4c8eff" stop-opacity="0" />
                    </radialGradient>
                    <linearGradient id="cnHeadingCone" x1="0%" y1="100%" x2="0%" y2="0%">
                        <stop offset="0%" stop-color="#4c8eff" stop-opacity="0.65" />
                        <stop offset="100%" stop-color="#4edea3" stop-opacity="0" />
                    </linearGradient>
                </defs>

                <rect width="1600" height="1000" fill="#0e172a" />
                <rect x="0" y="0" width="1120" height="1000" fill="url(#cnUrbanGrid)" />

                <!-- Río de la Plata y dársenas -->
                <path d="M1120,0 Q1160,260 1190,440 T1260,1000 L1600,1000 L1600,0 Z" fill="#0a162b" />
                <path d="M1120,0 Q1160,260 1190,440 T1260,1000" fill="none" stroke="#1d2e4d" stroke-width="3.5" />
                <g fill="#0b172d" stroke="#1c2c49" stroke-width="2">
                    <rect x="1070" y="215" width="46" height="120" rx="3" />
                    <rect x="1080" y="355" width="46" height="120" rx="3" />
                    <rect x="1090" y="495" width="46" height="120" rx="3" />
                    <rect x="1100" y="635" width="46" height="110" rx="3" />
                </g>

                <!-- Áreas verdes -->
                <path d="M1165,220 C1240,240 1280,310 1290,450 C1300,590 1260,720 1205,745 C1160,735 1145,550 1140,420 C1138,320 1145,230 1165,220 Z" fill="#122a2c" stroke="#1c3d40" stroke-width="1.5" />
                <rect x="880" y="440" width="38" height="52" rx="3" fill="#143234" />
                <circle cx="1030" cy="290" r="240" fill="url(#cnHeatZone)" />

                <!-- Red vial principal -->
                <g fill="none" stroke="#1b253b" stroke-width="1.4" opacity="0.75">
                    <line x1="100" y1="180" x2="920" y2="180" />
                    <line x1="80" y1="280" x2="980" y2="280" />
                    <line x1="80" y1="380" x2="1030" y2="380" />
                    <line x1="80" y1="480" x2="1055" y2="480" />
                    <line x1="80" y1="580" x2="1065" y2="580" />
                    <line x1="100" y1="680" x2="1075" y2="680" />
                    <line x1="110" y1="780" x2="1085" y2="780" />
                    <line x1="420" y1="50" x2="420" y2="920" />
                    <line x1="570" y1="50" x2="570" y2="920" />
                    <line x1="720" y1="50" x2="720" y2="920" />
                    <line x1="870" y1="180" x2="870" y2="900" />
                </g>

                <!-- Corredores y flujo de tráfico -->
                <g fill="none" stroke-linecap="round">
                    <line x1="380" y1="40" x2="1030" y2="490" stroke="#2a3c5e" stroke-width="6" />
                    <line x1="540" y1="30" x2="1040" y2="380" stroke="#3f5888" stroke-width="3" />
                    <line x1="790" y1="50" x2="910" y2="920" stroke="#223352" stroke-width="14" />
                    <line x1="790" y1="50" x2="910" y2="920" stroke="#4a5f87" stroke-width="8" />
                    <line x1="798" y1="110" x2="830" y2="350" stroke="#4edea3" stroke-width="3" />
                    <line x1="830" y1="350" x2="860" y2="560" stroke="#ffb95f" stroke-width="3.2" />
                    <line x1="860" y1="560" x2="900" y2="850" stroke="#4edea3" stroke-width="3" />
                    <path d="M120,830 L450,730 Q680,660 840,640 T1100,640" stroke="#ffb95f" stroke-width="4.5" opacity="0.9" />
                    <path d="M980,210 Q1025,410 1045,550 T1065,800" stroke="#4edea3" stroke-dasharray="14 4" stroke-width="4" opacity="0.85" />
                </g>

                <!-- Etiquetas -->
                <g font-family="Inter, sans-serif" font-size="13" font-weight="700" letter-spacing="1">
                    <text x="730" y="160" fill="#8c9cb8">RECOLETA</text>
                    <text x="910" y="275" fill="#a4b7d6">RETIRO</text>
                    <text x="680" y="380" fill="#7588a8">SAN NICOLÁS</text>
                    <text x="1100" y="470" fill="#adc6ff" font-size="14">PUERTO MADERO</text>
                </g>

                <!-- Radar del conductor 5.0 km -->
                <g transform="translate(920, 470)">
                    <circle cx="0" cy="0" r="230" fill="url(#cnTelemetryPulse)" />
                    <circle cx="0" cy="0" r="230" fill="none" stroke="#4c8eff" stroke-dasharray="6 6" stroke-width="1.2" opacity="0.35" />
                    <circle cx="0" cy="0" r="150" fill="none" stroke="#4c8eff" stroke-width="1" opacity="0.25" />
                    <circle cx="0" cy="0" r="80" fill="none" stroke="#adc6ff" stroke-dasharray="4 4" stroke-width="1" opacity="0.4" />
                    <circle class="cn-radar-ping" cx="0" cy="0" r="35" fill="none" stroke="#4c8eff" stroke-width="1.8" />
                    <text x="125" y="-165" fill="#adc6ff" font-family="Inter, sans-serif" font-size="10" font-weight="700" letter-spacing="1" opacity="0.85">RADIO 5.0 KM</text>
                    <g transform="rotate(32)">
                        <polygon points="0,0 -40,-130 40,-130" fill="url(#cnHeadingCone)" opacity="0.45" />
                        <circle cx="0" cy="0" r="14" fill="#4c8eff" stroke="#ffffff" stroke-width="2.5" />
                        <polygon points="0,-10 6,6 0,3 -6,6" fill="#00285d" />
                    </g>
                </g>
            </svg>

            <!-- Barra flotante superior sobre el mapa -->
            <div class="cn-map-topbar">
                <div class="cn-map-search">
                    <span class="material-symbols-outlined" style="color: var(--cn-primary); font-size: 20px;">search</span>
                    <input type="text"
                           placeholder="Zona operativa conectada • GPS en línea"
                           @bind="_zonaBusqueda"
                           @bind:event="oninput" />
                </div>

                <div class="cn-map-pills">
                    <button type="button"
                            class="cn-map-pill @(_filtroRadar == "todos" ? "cn-map-pill--active" : string.Empty)"
                            @onclick='() => _filtroRadar = "todos"'>
                        <span class="material-symbols-outlined" style="font-size: 16px; color: var(--cn-secondary);">local_shipping</span>
                        <span>Despacho Activo</span>
                    </button>
                    <button type="button"
                            class="cn-map-pill @(_filtroRadar == "centros" ? "cn-map-pill--active" : string.Empty)"
                            @onclick='() => _filtroRadar = "centros"'>
                        <span class="material-symbols-outlined" style="font-size: 16px;">warehouse</span>
                        <span>Nodos de Carga</span>
                    </button>
                    <button type="button"
                            class="cn-map-pill"
                            @onclick="ConsultarViajeActivoAsync"
                            disabled="@_cargando">
                        <span class="material-symbols-outlined" style="font-size: 16px; color: var(--cn-amber);">refresh</span>
                        <span>@(_cargando ? "Sincronizando..." : "Actualizar estado")</span>
                    </button>
                </div>
            </div>

            <!-- Indicador de zona / monitoreo -->
            <div class="cn-map-surge">
                <div class="cn-map-surge__icon">
                    <span class="material-symbols-outlined" style="font-size: 20px;">radar</span>
                </div>
                <div class="d-flex flex-column">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="cn-label-caps" style="color: var(--cn-amber);">Monitoreo Activo</span>
                        <span class="cn-chip cn-chip--amber" style="padding: 1px 6px; font-size: 9px;">Tiempo Real</span>
                    </div>
                    <strong class="cn-display" style="font-size: 15px; color: var(--cn-text-white);">
                        @(_viajeActivo != null ? "Despacho Asignado" : "Radar de Espera")
                    </strong>
                    <span style="font-size: 12px; color: var(--cn-on-surface-variant); margin-top: 2px;">
                        @(_viajeActivo != null
                            ? $"Viaje #{_viajeActivo.Id} listo para operar en hoja de ruta."
                            : "Cuando tu empresa asigne un flete, aparecerá aquí al instante.")
                    </span>
                </div>
            </div>

            <!-- Beacon flotante sobre vehículo -->
            <div class="cn-vehicle-beacon-pill">
                <span class="cn-pulse-dot cn-pulse-dot--emerald"></span>
                <span style="color: var(--cn-secondary);">GPS Activo</span>
                <span style="color: var(--cn-on-surface-variant);">• @(_perfil?.Empresa ?? "Mundo Ruta")</span>
            </div>

            <!-- Controles de zoom -->
            <div class="cn-map-controls">
                <button type="button" class="cn-map-ctrl-btn" title="Centrar posición" @onclick="RecentrarMapa">
                    <span class="material-symbols-outlined" style="font-size: 20px; color: var(--cn-secondary);">my_location</span>
                </button>
                <div class="cn-map-zoom-stack">
                    <button type="button" title="Acercar" @onclick="AcercarMapa">
                        <span class="material-symbols-outlined" style="font-size: 20px;">add</span>
                    </button>
                    <div style="height: 1px; background: rgba(255,255,255,0.08);"></div>
                    <button type="button" title="Alejar" @onclick="AlejarMapa">
                        <span class="material-symbols-outlined" style="font-size: 20px;">remove</span>
                    </button>
                </div>
            </div>

            <!-- Barra inferior de telemetría -->
            <div class="cn-bottom-telemetry">
                <div class="d-flex align-items-center gap-2">
                    <span class="cn-pulse-dot cn-pulse-dot--emerald"></span>
                    <span style="font-size: 12px; font-weight: 600; color: var(--cn-text-white);">Estado de Cabina:</span>
                    <span style="font-size: 12px; font-weight: 700; color: var(--cn-secondary);">
                        @(_viajeActivo != null ? "Viaje Asignado" : "Disponible — Esperando asignación")
                    </span>
                </div>
                <span style="width: 1px; height: 14px; background: var(--cn-outline-variant);"></span>
                <span class="d-flex align-items-center gap-1" style="font-size: 12px; color: var(--cn-on-surface-variant);">
                    <span class="material-symbols-outlined" style="font-size: 16px; color: var(--cn-primary);">sensors</span>
                    SignalR conectado
                </span>
            </div>
        </div>

        <!-- Panel flotante izquierdo de Cabina -->
        <div class="cn-cockpit-overlay">
            <div class="cn-cockpit-stack">
                <!-- Tarjeta de Perfil y Estado Operativo -->
                <div class="cn-card cn-card--glass p-3 d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="cn-avatar-box">
                            @if (!string.IsNullOrWhiteSpace(_perfil?.FotoPerfil))
                            {
                                <img src="@_perfil.FotoPerfil" alt="Foto del conductor" />
                            }
                            else
                            {
                                <div class="cn-avatar-box__fallback">
                                    @ObtenerInicial(_perfil?.Nombre ?? Sesion.Nombre)
                                </div>
                            }
                            <div class="cn-avatar-box__rating">
                                <span class="material-symbols-outlined" style="font-size: 11px; color: var(--cn-amber); font-variation-settings: 'FILL' 1;">star</span>
                                <span class="cn-tnum">@((_perfil?.PromedioCalificacion ?? 0).ToString("0.0"))</span>
                            </div>
                        </div>

                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <span class="cn-display text-truncate" style="font-size: 16px; font-weight: 700; color: var(--cn-text-white);">
                                    @NombreConductor
                                </span>
                                <span class="cn-chip cn-chip--sky" style="padding: 2px 7px; font-size: 10px;">Pro</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 mt-1 text-truncate" style="font-size: 12px; color: var(--cn-on-surface-variant);">
                                <span class="material-symbols-outlined" style="font-size: 15px; color: var(--cn-primary);">local_shipping</span>
                                <span class="text-truncate">@(_perfil?.Empresa ?? "Mundo Ruta")</span>
                                @if (!string.IsNullOrWhiteSpace(_perfil?.Licencia))
                                {
                                    <span>• @_perfil.Licencia</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Indicador de Disponibilidad -->
                    <div class="cn-service-box">
                        <div class="d-flex align-items-center gap-2 min-w-0">
                            <span class="cn-pulse-dot cn-pulse-dot--emerald"></span>
                            <div class="d-flex flex-column min-w-0">
                                <span class="cn-display" style="font-size: 12px; font-weight: 800; color: var(--cn-secondary); letter-spacing: 0.04em;">
                                    @(_viajeActivo != null ? "VIAJE EN CURSO" : "EN SERVICIO")
                                </span>
                                <span class="text-truncate" style="font-size: 11px; color: var(--cn-on-surface-variant);">
                                    @(_viajeActivo != null ? $"Viaje #{_viajeActivo.Id} • {_viajeActivo.Estado}" : "Disponible — Esperando asignación")
                                </span>
                            </div>
                        </div>
                        <span class="cn-chip cn-chip--emerald" style="font-size: 10px;">Activo</span>
                    </div>

                    <!-- Barra de Radar Telemático -->
                    <div class="cn-radar-bar">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="cn-label-caps d-flex align-items-center gap-1">
                                <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--cn-primary);"></span>
                                Radar Telemático Activo
                            </span>
                            <span class="cn-label-caps" style="color: var(--cn-secondary);">WS OK</span>
                        </div>
                        <div class="cn-radar-track">
                            <div class="cn-radar-fill"></div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between" style="font-size: 11px; color: var(--cn-outline);">
                            <span>Cobertura: 5.0 km</span>
                            <span style="color: var(--cn-primary); font-weight: 600;">
                                @(_viajeActivo != null ? "1 despacho activo" : "Listo para despachar")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Resumen de Actividad Real -->
                <div class="cn-card cn-card--glass p-3 d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="cn-label-caps">Resumen Operativo</span>
                        <a href="/chofer/historial" style="font-size: 11px; font-weight: 600; color: var(--cn-secondary);">
                            Ver historial →
                        </a>
                    </div>
                    <div class="cn-kpi-mini-grid">
                        <div class="cn-kpi-mini-tile">
                            <span class="cn-label-caps">Ingresos</span>
                            <span class="cn-display cn-tnum mt-1" style="font-size: 16px; font-weight: 800; color: var(--cn-text-white);">
                                $@TotalGanancias.ToString("N0")
                            </span>
                            <span class="cn-label-caps" style="color: var(--cn-outline); font-size: 9px;">ARS</span>
                        </div>
                        <div class="cn-kpi-mini-tile">
                            <span class="cn-label-caps">Viajes</span>
                            <span class="cn-display cn-tnum mt-1" style="font-size: 16px; font-weight: 800; color: var(--cn-primary);">
                                @_historial.Count
                            </span>
                            <span class="cn-label-caps" style="color: var(--cn-outline); font-size: 9px;">Completados</span>
                        </div>
                        <div class="cn-kpi-mini-tile">
                            <span class="cn-label-caps">Reseñas</span>
                            <span class="cn-display cn-tnum mt-1" style="font-size: 16px; font-weight: 800; color: var(--cn-amber);">
                                @(_perfil?.TotalCalificaciones ?? 0)
                            </span>
                            <span class="cn-label-caps" style="color: var(--cn-outline); font-size: 9px;">Valoraciones</span>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Inferior: Viaje Asignado o Espera -->
                @if (_cargando)
                {
                    <div class="cn-card cn-card--high p-4 text-center">
                        <div class="spinner-border text-info spinner-border-sm mb-2" role="status"></div>
                        <div style="font-size: 13px; color: var(--cn-on-surface-variant);">Sincronizando estado operativo...</div>
                    </div>
                }
                else if (_viajeActivo != null)
                {
                    <div class="cn-dispatch-card d-flex flex-column gap-3">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <span class="cn-chip cn-chip--emerald">
                                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--cn-secondary);"></span>
                                Viaje Asignado #@_viajeActivo.Id
                            </span>
                            <span class="cn-chip cn-chip--sky">@_viajeActivo.Estado</span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div>
                                <div class="cn-display cn-tnum" style="font-size: 22px; font-weight: 800; color: var(--cn-text-white);">
                                    $@_viajeActivo.Monto.ToString("N2")
                                </div>
                                <div style="font-size: 12px; color: var(--cn-on-surface-variant);">
                                    Pasajero: <strong style="color: var(--cn-text-white);">@_viajeActivo.NombrePasajero</strong>
                                </div>
                            </div>
                            <div style="width: 40px; height: 40px; border-radius: 12px; background: var(--cn-surface-high); display: flex; align-items: center; justify-content: center; color: var(--cn-primary);">
                                <span class="material-symbols-outlined">inventory_2</span>
                            </div>
                        </div>

                        <div class="cn-inset p-2 d-flex flex-column gap-1" style="font-size: 12px;">
                            <div class="d-flex align-items-center gap-2 text-truncate">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--cn-sky); flex-shrink: 0;"></span>
                                <span class="text-truncate" style="color: var(--cn-text-white);">@_viajeActivo.Origen</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-truncate">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--cn-amber); flex-shrink: 0;"></span>
                                <span class="text-truncate" style="color: var(--cn-on-surface-variant);">@_viajeActivo.Destino</span>
                            </div>
                        </div>

                        <button type="button" class="cn-btn cn-btn--primary cn-btn--lg w-100" @onclick="IrAlViajeActivo">
                            <span>Ir a la Hoja de Ruta Operativa</span>
                            <span class="material-symbols-outlined" style="font-size: 20px;">arrow_forward</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="cn-card cn-card--high p-3 d-flex flex-column gap-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="cn-chip cn-chip--emerald">Disponible</span>
                            <span class="cn-label-caps">GPS Conectado</span>
                        </div>
                        <div class="cn-display" style="font-size: 15px; font-weight: 700; color: var(--cn-text-white);">
                            Esperando asignación de viaje
                        </div>
                        <p class="mb-1" style="font-size: 12px; color: var(--cn-on-surface-variant); line-height: 1.45;">
                            Cuando tu empresa te asigne un nuevo flete, el despacho aparecerá aquí para abrir la hoja de ruta.
                        </p>
                        <div class="d-grid gap-2" style="grid-template-columns: 1fr 1fr;">
                            <button type="button" class="cn-btn cn-btn--ghost" style="font-size: 12px; padding: 0.6rem;" @onclick="ConsultarViajeActivoAsync" disabled="@_cargando">
                                <span class="material-symbols-outlined" style="font-size: 17px; color: var(--cn-primary);">refresh</span>
                                <span>Actualizar</span>
                            </button>
                            <a href="/chofer/historial" class="cn-btn cn-btn--ghost" style="font-size: 12px; padding: 0.6rem;">
                                <span class="material-symbols-outlined" style="font-size: 17px; color: var(--cn-amber);">history</span>
                                <span>Historial</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</RoleGuard>

@code {
    private bool _cargando = true;
    private ViajeChoferDTO? _viajeActivo;
    private ChoferPerfilDTO? _perfil;
    private List<ChoferViajeHistorialDTO> _historial = new();
    private double _zoom = 1.0;
    private string _filtroRadar = "todos";
    private string _zonaBusqueda = string.Empty;

    private string NombreConductor =>
        _perfil != null && !string.IsNullOrWhiteSpace(_perfil.Nombre)
            ? $"{_perfil.Nombre} {_perfil.Apellido}".Trim()
            : (Sesion.Nombre ?? "Conductor");

    private decimal TotalGanancias => _historial.Sum(v => v.Monto);

    protected override async Task OnInitializedAsync()
    {
        ViajeHubService.EstadoViajeActualizado += OnEstadoViajeActualizado;
        ViajeHubService.ViajeAsignado += OnViajeAsignado;
        await Task.WhenAll(
            ConsultarViajeActivoAsync(),
            CargarContextoConductorAsync()
        );
    }

    private async Task CargarContextoConductorAsync()
    {
        try
        {
            var perfilResp = await ChoferServicio.ObtenerPerfilAsync(Sesion.Id);
            if (!perfilResp.Error && perfilResp.Respuesta != null)
            {
                _perfil = perfilResp.Respuesta;
            }
        }
        catch
        {
            // Fallback silencioso para no bloquear la cabina
        }

        try
        {
            var histResp = await ChoferServicio.ObtenerHistorialAsync(Sesion.Id);
            if (!histResp.Error && histResp.Respuesta != null)
            {
                _historial = histResp.Respuesta;
            }
        }
        catch
        {
            // Fallback silencioso
        }
    }

    private async Task ConsultarViajeActivoAsync()
    {
        _cargando = true;
        try
        {
            var resp = await ChoferServicio.ObtenerViajeActivoAsync(Sesion.Id);
            if (!resp.Error && resp.Respuesta != null)
            {
                _viajeActivo = resp.Respuesta;
            }
            else
            {
                _viajeActivo = null;
            }
        }
        catch
        {
            _viajeActivo = null;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void OnEstadoViajeActualizado(EstadoViajeActualizadoDTO dto)
    {
        InvokeAsync(async () =>
        {
            await ConsultarViajeActivoAsync();
            StateHasChanged();
        });
    }

    private void OnViajeAsignado(ViajeAsignadoDTO dto)
    {
        InvokeAsync(async () =>
        {
            await ConsultarViajeActivoAsync();
            StateHasChanged();
        });
    }

    private void IrAlViajeActivo()
    {
        if (_viajeActivo != null)
        {
            Navegacion.NavigateTo($"/chofer/viaje-activo/{_viajeActivo.Id}");
        }
    }

    private void AcercarMapa()
    {
        _zoom = Math.Min(_zoom + 0.15, 1.6);
    }

    private void AlejarMapa()
    {
        _zoom = Math.Max(_zoom - 0.15, 0.85);
    }

    private void RecentrarMapa()
    {
        _zoom = 1.0;
    }

    private static string ObtenerInicial(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
        {
            return "C";
        }

        return char.ToUpperInvariant(nombre.Trim()[0]).ToString();
    }

    public void Dispose()
    {
        ViajeHubService.EstadoViajeActualizado -= OnEstadoViajeActualizado;
        ViajeHubService.ViajeAsignado -= OnViajeAsignado;
    }
}
