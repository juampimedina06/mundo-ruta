@page "/admin/comisiones"
@page "/admin/viajes"
@inject IAdminServicio Admin

<PageTitle>Auditoría de Viajes y Comisiones | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="@Roles.Admin">
    <div class="mr-page">
        <div class="mr-container">
            <!-- Context Header & Breadcrumb -->
            <div class="mr-context-header">
                <nav class="mr-breadcrumb" aria-label="Ruta de navegación">
                    <a href="/admin/dashboard">Inicio</a>
                    <span class="mr-breadcrumb__sep">/</span>
                    <span>Administración</span>
                    <span class="mr-breadcrumb__sep">/</span>
                    <span class="mr-breadcrumb__current">Auditoría y Comisiones</span>
                </nav>

                <div class="mr-header-main">
                    <div>
                        <div class="mr-header-title-wrap">
                            <h1 class="mr-header-title">Auditoría de Viajes y Comisiones</h1>
                            <span class="mr-header-tag">
                                <span class="mr-header-tag__dot"></span>
                                Control Financiero &amp; Operativo
                            </span>
                        </div>
                        <p class="mr-header-desc">
                            Seguimiento de operaciones cerradas, montos acordados en subastas/fletes y liquidación de comisiones de la plataforma.
                        </p>
                    </div>
                </div>
            </div>

            @if (_cargando && _reporte is null)
            {
                <div class="mr-loading">
                    <span class="spinner-border text-primary me-2" role="status"></span>
                    Cargando reporte de comisiones...
                </div>
            }
            else if (_error is not null)
            {
                <div class="mr-alert mr-alert--error mb-4">@_error</div>
            }
            else
            {
                <!-- Totalizadores / KPIs superiores -->
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <div class="mr-kpi flex-fill" style="min-width: 250px;">
                        <div class="mr-kpi__top">
                            <div>
                                <span class="mr-kpi__label">Total Facturado en Fletes</span>
                                <div class="mr-kpi__value">@FormatoPanel.Moneda(_reporte?.TotalFacturado ?? 0m)</div>
                            </div>
                            <div class="mr-kpi__icon mr-kpi__icon--navy">
                                <span class="material-symbols-outlined text-[24px]">payments</span>
                            </div>
                        </div>
                        <div class="mr-kpi__footer">
                            <span class="mr-kpi__pill mr-kpi__pill--success">
                                <span class="material-symbols-outlined text-[14px]">done_all</span>
                                @((_reporte?.CantidadOperaciones ?? 0)) operaciones
                            </span>
                            <span>Auditadas</span>
                        </div>
                    </div>

                    <div class="mr-kpi flex-fill" style="min-width: 250px;">
                        <div class="mr-kpi__top">
                            <div>
                                <span class="mr-kpi__label">Comisiones Retenidas / Cobradas</span>
                                <div class="mr-kpi__value text-success">@FormatoPanel.Moneda(_reporte?.TotalComisionesRetenidas ?? 0m)</div>
                            </div>
                            <div class="mr-kpi__icon mr-kpi__icon--green">
                                <span class="material-symbols-outlined text-[24px]">verified</span>
                            </div>
                        </div>
                        <div class="mr-kpi__footer">
                            <span class="mr-kpi__pill mr-kpi__pill--success">
                                Pago confirmado
                            </span>
                            <span>Acreditadas</span>
                        </div>
                    </div>

                    <div class="mr-kpi flex-fill" style="min-width: 250px;">
                        <div class="mr-kpi__top">
                            <div>
                                <span class="mr-kpi__label">Comisiones Pendientes</span>
                                <div class="mr-kpi__value text-warning">@FormatoPanel.Moneda(_reporte?.TotalComisionesPendientes ?? 0m)</div>
                            </div>
                            <div class="mr-kpi__icon mr-kpi__icon--amber">
                                <span class="material-symbols-outlined text-[24px]">schedule</span>
                            </div>
                        </div>
                        <div class="mr-kpi__footer">
                            <span class="mr-kpi__pill mr-kpi__pill--warning">
                                En gestión de cobro
                            </span>
                            <span>Por liquidar</span>
                        </div>
                    </div>
                </div>

                <!-- Barra de filtros estilizada -->
                <div class="mr-filter-card">
                    <div class="mr-filter-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Fecha desde</label>
                                <input type="date" class="form-control mr-search-input" style="padding-left: 1rem;" @bind="_fechaDesde" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Fecha hasta</label>
                                <input type="date" class="form-control mr-search-input" style="padding-left: 1rem;" @bind="_fechaHasta" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Empresa prestadora</label>
                                <select class="form-select mr-select w-100" @bind="_prestadorId">
                                    <option value="0">Todas las empresas</option>
                                    @foreach (AdminUsuarioListadoDTO prestador in _prestadores)
                                    {
                                        <option value="@prestador.Id">@prestador.Nombre @prestador.Apellido</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label small fw-semibold text-muted">Estado del viaje</label>
                                <select class="form-select mr-select w-100" @bind="_estadoViaje">
                                    <option value="">Todos los estados</option>
                                    <option value="@EstadosViaje.Buscando">Buscando</option>
                                    <option value="@EstadosViaje.Asignado">Asignado</option>
                                    <option value="@EstadosViaje.CargaSubida">Carga subida</option>
                                    <option value="@EstadosViaje.EnTransito">En tránsito</option>
                                    <option value="@EstadosViaje.LlegadaDestino">Llegada a destino</option>
                                    <option value="@EstadosViaje.Finalizado">Finalizado</option>
                                    <option value="@EstadosViaje.Cancelado">Cancelado</option>
                                </select>
                            </div>
                            <div class="col-12 d-flex gap-2 justify-content-end mt-3">
                                <button type="button" class="btn btn-sm btn-primary" @onclick="AplicarFiltrosAsync" disabled="@_cargando">
                                    @if (_cargando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    <span class="material-symbols-outlined text-[16px]">filter_alt</span>
                                    Filtrar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LimpiarFiltrosAsync" disabled="@_cargando">
                                    Limpiar filtros
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Desglose de operaciones -->
                @if (_reporte is null || _reporte.Operaciones.Count == 0)
                {
                    <EmptyState Titulo="Sin operaciones registradas"
                                Descripcion="No se encontraron viajes o comisiones que coincidan con los filtros aplicados." />
                }
                else
                {
                    <div class="mr-tabla-card">
                        <div class="mr-tabla-contenedor">
                            <table class="mr-tabla">
                                <thead>
                                    <tr>
                                        <th scope="col">ID Viaje</th>
                                        <th scope="col">Prestador</th>
                                        <th scope="col">Pasajero</th>
                                        <th scope="col">Fecha</th>
                                        <th scope="col" class="text-end">Monto total</th>
                                        <th scope="col" class="text-end">Comisión (%)</th>
                                        <th scope="col" class="text-end">Monto comisión</th>
                                        <th scope="col">Estado viaje</th>
                                        <th scope="col">Estado pago</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (AdminComisionFilaDTO op in _reporte.Operaciones)
                                    {
                                        <tr @key="op.ViajeId">
                                            <td>
                                                <span class="fw-bold font-monospace text-primary">#VJ-@op.ViajeId</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="mr-avatar mr-avatar--amber" style="width: 30px; height: 30px; font-size: .7rem;">
                                                        @ObtenerIniciales(op.PrestadorNombre)
                                                    </div>
                                                    <div>
                                                        <div class="mr-cell-title" style="font-size: .85rem;">@op.PrestadorNombre</div>
                                                        @if (!string.IsNullOrWhiteSpace(op.PrestadorRazonSocial))
                                                        {
                                                            <div class="mr-cell-sub">@op.PrestadorRazonSocial</div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="text-dark font-medium">@op.PasajeroNombre</span>
                                            </td>
                                            <td>
                                                <span class="mr-cell-mono">@FormatoPanel.Fecha(op.Fecha)</span>
                                            </td>
                                            <td class="text-end fw-semibold text-dark">
                                                @FormatoPanel.Moneda(op.MontoTotal)
                                            </td>
                                            <td class="text-end text-muted font-monospace small">
                                                @op.PorcentajeComision%
                                            </td>
                                            <td class="text-end fw-bold text-success font-monospace">
                                                @FormatoPanel.Moneda(op.MontoComision)
                                            </td>
                                            <td>
                                                <EstadoBadge Estado="@op.EstadoViaje" />
                                            </td>
                                            <td>
                                                <EstadoBadge Estado="@op.EstadoPago" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between text-muted small">
                            <span>
                                Total de operaciones auditadas: <strong class="text-dark">@_reporte.Operaciones.Count</strong>
                            </span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</RoleGuard>

@code {
    private bool _cargando = true;
    private string? _error;
    private AdminComisionesReporteDTO? _reporte;
    private List<AdminUsuarioListadoDTO> _prestadores = new List<AdminUsuarioListadoDTO>();

    private DateTime? _fechaDesde;
    private DateTime? _fechaHasta;
    private int _prestadorId = 0;
    private string _estadoViaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarPrestadoresAsync(), CargarReporteAsync());
    }

    private async Task CargarPrestadoresAsync()
    {
        try
        {
            HttpResp<List<AdminUsuarioListadoDTO>> respuesta = await Admin.ObtenerUsuariosAsync();
            if (!respuesta.Error && respuesta.Respuesta != null)
            {
                _prestadores = respuesta.Respuesta
                    .Where(u => u.Rol == Roles.Prestador)
                    .OrderBy(u => u.Nombre)
                    .ToList();
            }
        }
        catch (Exception)
        {
            // Error silencioso al cargar lista de prestadores para el filtro
        }
    }

    private async Task CargarReporteAsync()
    {
        _cargando = true;
        _error = null;

        try
        {
            AdminFiltroComisionesDTO filtro = new AdminFiltroComisionesDTO
            {
                FechaDesde = _fechaDesde,
                FechaHasta = _fechaHasta,
                PrestadorId = _prestadorId > 0 ? _prestadorId : null,
                EstadoViaje = string.IsNullOrWhiteSpace(_estadoViaje) ? null : _estadoViaje
            };

            HttpResp<AdminComisionesReporteDTO> respuesta = await Admin.ObtenerComisionesAsync(filtro);
            if (!respuesta.Error && respuesta.Respuesta != null)
            {
                _reporte = respuesta.Respuesta;
            }
            else
            {
                _error = "No se pudo cargar el reporte de comisiones. Intente nuevamente.";
            }
        }
        catch (Exception)
        {
            _error = "Ocurrió un error de red al intentar consultar el reporte.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AplicarFiltrosAsync()
    {
        await CargarReporteAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        _fechaDesde = null;
        _fechaHasta = null;
        _prestadorId = 0;
        _estadoViaje = string.Empty;
        await CargarReporteAsync();
    }

    private static string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "PR";
        string[] partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2)
        {
            return $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant();
        }
        return nombre.Length >= 2 ? nombre.Substring(0, 2).ToUpperInvariant() : "PR";
    }
}
