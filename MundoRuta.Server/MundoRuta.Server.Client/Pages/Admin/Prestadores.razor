@page "/admin/prestadores"

<PageTitle>Prestadores pendientes | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Admin">
    <div class="mr-page">
        <div class="mr-container">
            <PageHeader Titulo="Prestadores pendientes"
                        Descripcion="Altas que esperan aprobación." />

            <EmptyState Titulo="No hay prestadores pendientes"
                        Descripcion="Cuando una empresa se registre va a aparecer acá para aprobar o rechazar.">
                <a class="btn btn-outline-primary" href="/admin">Volver al panel</a>
            </EmptyState>
        </div>
    </div>
</RoleGuard>
