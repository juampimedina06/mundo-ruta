@page "/prestador/vehiculos"
@layout PrestadorLayout
@using System.Globalization
@using System.Net.Http.Json
@using MundoRuta.Shared
@using MundoRuta.Shared.DTO
@using MundoRuta.Servicios.Sesion
@inject IVehiculoServicio Flota
@inject HttpClient Http
@inject SesionEstado Sesion
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Gestión de Vehículos y Tarifas | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Prestador">
    <div class="d-flex flex-column gap-4">
        <!-- 1. Cabecera Ejecutiva -->
        <div class="pr-header-block">
            <div>
                <div class="pr-header-meta">
                    <span class="pr-tag pr-tag--mono">OPERACIONES / PARQUE AUTOMOTOR</span>
                    <span class="pr-tag pr-tag--emerald">Flota Operativa</span>
                </div>
                <h1 class="pr-page-title">Gestión de Vehículos de la Flota</h1>
                <p class="pr-page-subtitle">
                    Control de unidades operativas, tarifas base por kilómetro recorrido y habilitaciones vigentes.
                </p>
            </div>
            <div class="pr-header-actions">
                <button type="button" class="pr-btn pr-btn--outline" @onclick='() => IrASeccionAsync("seccion-tarifa")'>
                    <span class="material-symbols-outlined text-[18px]">tune</span>
                    <span>Ajustar Tarifa Global</span>
                </button>
                <button type="button" class="pr-btn pr-btn--emerald" @onclick="AbrirModalAlta">
                    <span class="material-symbols-outlined text-[20px]">add</span>
                    <span>Registrar Vehículo</span>
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_mensaje))
        {
            <div class="pr-alert pr-alert--success">
                <div class="d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    <span>@_mensaje</span>
                </div>
                <button type="button" class="pr-icon-btn" @onclick="() => _mensaje = null">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="pr-alert pr-alert--error">
                <div class="d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">error</span>
                    <span>@_error</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (_errorCarga)
                    {
                        <button type="button" class="pr-btn pr-btn--outline pr-btn-sm" disabled="@_cargando" @onclick="ReintentarAsync">
                            Reintentar
                        </button>
                    }
                    <button type="button" class="pr-icon-btn pr-icon-btn--danger" @onclick="() => _error = null">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                </div>
            </div>
        }

        <!-- 2. KPIs de Flota -->
        <div class="pr-kpi-grid">
            <div class="pr-kpi-card">
                <div class="pr-kpi-header">
                    <span class="pr-kpi-label">Total de Unidades</span>
                    <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--navy">
                        <span class="material-symbols-outlined text-[20px]">directions_car</span>
                    </div>
                </div>
                <div class="pr-kpi-body">
                    <div class="pr-kpi-value-row">
                        <span class="pr-kpi-value pr-tnum">@_vehiculos.Count</span>
                        <span class="pr-kpi-badge pr-kpi-badge--emerald">Flota</span>
                    </div>
                    <div class="pr-kpi-subtext">Unidades registradas</div>
                    <div class="pr-kpi-progress">
                        <div class="pr-kpi-progress-bar pr-kpi-progress-bar--navy" style="width: 100%;"></div>
                    </div>
                </div>
            </div>

            <div class="pr-kpi-card">
                <div class="pr-kpi-header">
                    <span class="pr-kpi-label">Tarifa Base por KM</span>
                    <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--emerald">
                        <span class="material-symbols-outlined text-[20px]">payments</span>
                    </div>
                </div>
                <div class="pr-kpi-body">
                    <div class="pr-kpi-value-row">
                        <span class="pr-kpi-value pr-tnum" style="font-size: 24px;">@(_tarifaCargada ? FormatearMoneda(_tarifaActual) : "$ 0,00")</span>
                        <span class="pr-kpi-badge pr-kpi-badge--emerald">/ km</span>
                    </div>
                    <div class="pr-kpi-subtext">Piso tarifario contractual</div>
                    <div class="pr-kpi-progress">
                        <div class="pr-kpi-progress-bar pr-kpi-progress-bar--emerald" style="width: 100%;"></div>
                    </div>
                </div>
            </div>

            <div class="pr-kpi-card">
                <div class="pr-kpi-header">
                    <span class="pr-kpi-label">Unidades Disponibles</span>
                    <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--emerald">
                        <span class="material-symbols-outlined text-[20px]">route</span>
                    </div>
                </div>
                <div class="pr-kpi-body">
                    <div class="pr-kpi-value-row">
                        <span class="pr-kpi-value pr-tnum">@TotalDisponibles</span>
                        <span class="pr-kpi-badge pr-kpi-badge--emerald">@PorcentajeDisponibles% en base</span>
                    </div>
                    <div class="pr-kpi-subtext">@TotalEnUso en servicio activo</div>
                    <div class="pr-kpi-progress">
                        <div class="pr-kpi-progress-bar pr-kpi-progress-bar--emerald" style="width: @(PorcentajeDisponibles)%;"></div>
                    </div>
                </div>
            </div>

            <div class="pr-kpi-card">
                <div class="pr-kpi-header">
                    <span class="pr-kpi-label">Mantenimiento y Taller</span>
                    <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--amber">
                        <span class="material-symbols-outlined text-[20px]">build</span>
                    </div>
                </div>
                <div class="pr-kpi-body">
                    <div class="pr-kpi-value-row">
                        <span class="pr-kpi-value pr-tnum">@TotalMantenimiento</span>
                        <span class="pr-kpi-badge pr-kpi-badge--amber">En taller</span>
                    </div>
                    <div class="pr-kpi-subtext">@(_vehiculos.Count > 0 ? "Revisión técnica programada" : "Sin unidades registradas")</div>
                    <div class="pr-kpi-progress">
                        <div class="pr-kpi-progress-bar pr-kpi-progress-bar--amber" style="width: @(_vehiculos.Count > 0 ? (TotalMantenimiento * 100 / _vehiculos.Count) : 0)%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Barra de Búsqueda y Filtros -->
        <div class="pr-toolbar">
            <div class="pr-toolbar-row">
                <div class="pr-search-box">
                    <span class="material-symbols-outlined">search</span>
                    <input type="text"
                           class="pr-search-input"
                           placeholder="Buscar por patente, nombre, marca o modelo..."
                           @bind="_busqueda"
                           @bind:event="oninput" />
                </div>

                <div class="pr-filter-pills">
                    <button type="button"
                            class="pr-filter-pill @(string.IsNullOrEmpty(_filtroEstado) ? "active" : "")"
                            @onclick='() => _filtroEstado = string.Empty'>
                        <span>Todos</span>
                        <span class="pr-filter-pill__count">@_vehiculos.Count</span>
                    </button>
                    <button type="button"
                            class="pr-filter-pill @(_filtroEstado == "DISPONIBLE" ? "active" : "")"
                            @onclick='() => _filtroEstado = "DISPONIBLE"'>
                        <span>Disponibles</span>
                        <span class="pr-filter-pill__count">@TotalDisponibles</span>
                    </button>
                    <button type="button"
                            class="pr-filter-pill @(_filtroEstado == "EN_USO" ? "active" : "")"
                            @onclick='() => _filtroEstado = "EN_USO"'>
                        <span>En Uso</span>
                        <span class="pr-filter-pill__count">@TotalEnUso</span>
                    </button>
                    <button type="button"
                            class="pr-filter-pill @(_filtroEstado == "MANTENIMIENTO" ? "active" : "")"
                            @onclick='() => _filtroEstado = "MANTENIMIENTO"'>
                        <span>Mantenimiento</span>
                        <span class="pr-filter-pill__count">@TotalMantenimiento</span>
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <select class="pr-input" style="min-width: 170px; height: 38px;" @bind="_filtroTipo">
                        <option value="">Todas las categorías</option>
                        <option value="Camión">Camión</option>
                        <option value="Camioneta">Camioneta</option>
                        <option value="Utilitario">Utilitario</option>
                        <option value="Furgón">Furgón</option>
                        <option value="Acoplado">Acoplado</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <button type="button"
                            class="pr-icon-btn"
                            title="Recargar flota"
                            disabled="@_cargando"
                            @onclick="ReintentarAsync">
                        <span class="material-symbols-outlined text-[18px]">refresh</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- 4. Tabla Principal de Vehículos -->
        @if (_cargando)
        {
            <div class="pr-table-card p-5 text-center">
                <div class="d-inline-flex align-items-center gap-2 text-muted">
                    <span class="material-symbols-outlined mr-fleet-spin">sync</span>
                    <span>Cargando flota de vehículos...</span>
                </div>
            </div>
        }
        else if (_vehiculos.Count == 0)
        {
            <div class="pr-table-card p-4">
                <EmptyState Titulo="Todavía no cargaste vehículos"
                            Descripcion="Registrá la unidad desde el botón Registrar Vehículo para verla en el listado.">
                    <button type="button" class="pr-btn pr-btn--emerald mt-2" @onclick="AbrirModalAlta">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        <span>Registrar Vehículo</span>
                    </button>
                </EmptyState>
            </div>
        }
        else if (VehiculosFiltrados.Count == 0)
        {
            <div class="pr-table-card p-4">
                <EmptyState Titulo="No se encontraron unidades"
                            Descripcion="Probá modificando el texto de búsqueda o los filtros seleccionados.">
                    <button type="button" class="pr-btn pr-btn--outline mt-2" @onclick="LimpiarFiltros">
                        Limpiar filtros
                    </button>
                </EmptyState>
            </div>
        }
        else
        {
            <div class="pr-table-card">
                <div class="table-responsive">
                    <table class="pr-table">
                        <thead>
                            <tr>
                                <th>Patente</th>
                                <th>Unidad / Marca y Modelo</th>
                                <th>Categoría</th>
                                <th>Capacidad</th>
                                <th>Estado Operativo</th>
                                <th>Conductor</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (VehiculoDTO vehiculo in VehiculosFiltrados)
                            {
                                <tr @key="vehiculo.Id">
                                    <td>
                                        <span class="pr-tag pr-tag--mono">@vehiculo.Patente</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--navy" style="width: 34px; height: 34px;">
                                                <span class="material-symbols-outlined text-[18px]">@ObtenerIconoVehiculo(vehiculo.TipoVehiculo)</span>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-family: var(--pr-font-display);">@NombreVisible(vehiculo)</div>
                                                <div class="text-muted" style="font-size: 12px;">
                                                    @ValorVisible(vehiculo.Marca) · @ValorVisible(vehiculo.MarcaModelo)
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@ValorVisible(vehiculo.TipoVehiculo)</td>
                                    <td class="pr-tnum">@ValorVisible(vehiculo.CapacidadCarga)</td>
                                    <td>
                                        <span class="pr-status-chip @ObtenerClaseChipEstado(vehiculo.Estado)">
                                            <span class="dot"></span>
                                            <span>@EtiquetaEstado(vehiculo.Estado)</span>
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            string nombreConductor = NombreConductorVisible(vehiculo);
                                        }
                                        @if (nombreConductor != "Sin asignar")
                                        {
                                            <span class="fw-semibold">@nombreConductor</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin asignar</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <button type="button"
                                                    class="pr-icon-btn"
                                                    title="Editar vehículo y conductor"
                                                    @onclick="() => AbrirModalEdicion(vehiculo)">
                                                <span class="material-symbols-outlined text-[18px]">edit</span>
                                            </button>
                                            <button type="button"
                                                    class="pr-btn pr-btn--outline pr-btn-sm"
                                                    @onclick="() => VerDetalle(vehiculo)">
                                                <span>Ver Detalle</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pr-table-footer">
                    <span>Mostrando @VehiculosFiltrados.Count de @_vehiculos.Count unidades registradas</span>
                    <span class="pr-tag pr-tag--emerald">Flota Activa</span>
                </div>
            </div>
        }

        <!-- 5. Estructura Tarifaria Asignada -->
        <section id="seccion-tarifa" class="pr-card p-4">
            <div class="d-flex align-items-start gap-3 mb-3">
                <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--navy">
                    <span class="material-symbols-outlined text-[20px]">payments</span>
                </div>
                <div>
                    <h2 class="h5 fw-bold mb-1" style="font-family: var(--pr-font-display);">Estructura Tarifaria Asignada</h2>
                    <p class="text-muted mb-0" style="font-size: 13px;">
                        Precio base por kilómetro recorrido utilizado como parámetro contractual para tus ofertas de servicio.
                    </p>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-end gap-3">
                <div style="min-width: 240px; flex: 1; max-width: 340px;">
                    <label class="pr-label" for="tarifa">Tarifa Base por KM (ARS $)</label>
                    <input id="tarifa"
                           type="number"
                           min="0"
                           step="0.01"
                           class="pr-input pr-tnum fw-bold"
                           @bind="_tarifa"
                           @bind:culture="CulturaInvariante" />
                </div>

                <button type="button"
                        class="pr-btn pr-btn--navy"
                        disabled="@_guardandoTarifa"
                        @onclick="GuardarTarifaAsync">
                    @if (_guardandoTarifa)
                    {
                        <span class="material-symbols-outlined mr-fleet-spin text-[18px]">sync</span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        <span>Guardar Tarifa</span>
                    }
                </button>
            </div>

            @if (_tarifaCargada)
            {
                <div class="mt-3 d-inline-flex align-items-center gap-2 text-success" style="font-size: 13px;">
                    <span class="material-symbols-outlined text-[18px]">verified</span>
                    <span>
                        Tarifa contractual activa: <strong class="pr-tnum">@FormatearMoneda(_tarifaActual)</strong> por kilómetro recorrido.
                    </span>
                </div>
            }
        </section>
    </div>

    <!-- MODAL REGISTRAR VEHÍCULO -->
    @if (_mostrarModalAlta)
    {
        <div class="pr-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="alta-titulo" @onclick="CerrarModalAlta">
            <div class="pr-modal" style="max-width: 680px; border-radius: 16px;" @onclick:stopPropagation>
                <div class="pr-modal__header">
                    <div>
                        <h2 id="alta-titulo" class="pr-modal__title">@(_vehiculoEditandoId.HasValue ? "Editar Vehículo" : "Registrar Vehículo")</h2>
                        <p class="pr-modal__subtitle">
                            @(_vehiculoEditandoId.HasValue
                                ? "Modificá los datos de la unidad o asignale otro conductor."
                                : "Completa los campos correspondientes a la entidad técnica del vehículo.")
                        </p>
                    </div>
                    <button type="button"
                            class="pr-modal__close-btn"
                            aria-label="Cerrar ventana"
                            disabled="@_guardando"
                            @onclick="CerrarModalAlta">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>

                <EditForm Model="_alta" OnSubmit="RegistrarAsync">
                    <div class="pr-modal__body" style="max-height: 70vh; overflow-y: auto;">
                        @if (!string.IsNullOrWhiteSpace(_errorAlta))
                        {
                            <div class="pr-alert pr-alert--error">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="material-symbols-outlined text-[20px]">error</span>
                                    <span>@_errorAlta</span>
                                </div>
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="patente">Patente <span class="required">*</span></label>
                                <InputText id="patente" class="pr-input pr-tnum text-uppercase" @bind-Value="_alta.Patente" placeholder="Ej: AB123CD" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="marca">Marca <span class="required">*</span></label>
                                <InputText id="marca" class="pr-input" @bind-Value="_alta.Marca" placeholder="Ej: Mercedes-Benz" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="marca-modelo">Marca y Modelo <span class="required">*</span></label>
                                <InputText id="marca-modelo" class="pr-input" @bind-Value="_alta.MarcaModelo" placeholder="Ej: Sprinter 516 CDI" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="tipo">Categoría de Servicio <span class="required">*</span></label>
                                <InputSelect id="tipo" class="pr-input" @bind-Value="_alta.TipoVehiculo">
                                    <option value="">Seleccionar categoría</option>
                                    <option value="Camión">Camión</option>
                                    <option value="Camioneta">Camioneta</option>
                                    <option value="Utilitario">Utilitario</option>
                                    <option value="Furgón">Furgón</option>
                                    <option value="Acoplado">Acoplado</option>
                                    <option value="Otro">Otro</option>
                                </InputSelect>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="capacidad">Capacidad de Carga <span class="required">*</span></label>
                                <InputText id="capacidad" class="pr-input" @bind-Value="_alta.CapacidadCarga" placeholder="Ej: 2100 kg" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="licencia">Licencia Habilitante <span class="required">*</span></label>
                                <InputText id="licencia" class="pr-input" @bind-Value="_alta.Licencia" placeholder="Ej: L-CNRT-884920" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="estado">Estado Operativo <span class="required">*</span></label>
                                <InputSelect id="estado" class="pr-input" @bind-Value="_alta.Estado">
                                    <option value="DISPONIBLE">Disponible en Base</option>
                                    <option value="EN_USO">En Servicio Activo</option>
                                    <option value="MANTENIMIENTO">Taller / Mantenimiento</option>
                                </InputSelect>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="fecha-fabricacion">Fecha de Fabricación <span class="required">*</span></label>
                                <InputDate id="fecha-fabricacion" class="pr-input" @bind-Value="_alta.FechaFabricación" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="nombre">Nombre o Identificador</label>
                                <InputText id="nombre" class="pr-input" @bind-Value="_alta.Nombre" placeholder="Ej: V-104 o Sprinter Central" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="pr-label" for="select-chofer">Conductor</label>
                                <select id="select-chofer"
                                        class="pr-input"
                                        value="@_alta.IdChofer"
                                        @onchange="AlSeleccionarChofer">
                                    <option value="0">Sin conductor asignado</option>
                                    @foreach (ChoferDTO chofer in _choferes)
                                    {
                                        <option value="@chofer.Id">
                                            @chofer.Nombre @chofer.Apellido@(string.IsNullOrWhiteSpace(chofer.Licencia) ? "" : $" · Lic. {chofer.Licencia}")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="pr-label" for="caracteristicas">Características del Conductor y Observaciones</label>
                                <InputText id="caracteristicas"
                                           class="pr-input"
                                           @bind-Value="_alta.CaracteristicasConductor"
                                           placeholder="Ej: LNT Vigente, Cargas Generales e Interprovincial" />
                            </div>
                        </div>
                    </div>

                    <div class="pr-modal__footer">
                        <button type="button" class="pr-btn pr-btn--subtle" disabled="@_guardando" @onclick="CerrarModalAlta">
                            Cancelar
                        </button>
                        <button type="submit" class="pr-btn pr-btn--emerald" disabled="@_guardando">
                            @if (_guardando)
                            {
                                <span class="material-symbols-outlined mr-fleet-spin text-[18px]">sync</span>
                                <span>@(_vehiculoEditandoId.HasValue ? "Guardando..." : "Registrando...")</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-[18px]">check</span>
                                <span>@(_vehiculoEditandoId.HasValue ? "Guardar Cambios" : "Registrar Unidad")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- MODAL DETALLE DE UNIDAD -->
    @if (_detalle is not null)
    {
        <div class="pr-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="detalle-titulo" @onclick="CerrarDetalle">
            <div class="pr-modal" style="max-width: 660px;" @onclick:stopPropagation>
                <div class="pr-modal__stripe"></div>

                <div class="pr-modal__header">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="pr-tag pr-tag--mono">V-@_detalle.Id</span>
                            <span class="pr-status-chip @ObtenerClaseChipEstado(_detalle.Estado)">
                                <span class="dot"></span>
                                <span>@EtiquetaEstado(_detalle.Estado)</span>
                            </span>
                        </div>
                        <h2 id="detalle-titulo" class="pr-modal__title">Detalle de Unidad</h2>
                        <p class="pr-modal__subtitle">@_detalle.Marca · @ValorVisible(_detalle.MarcaModelo)</p>
                    </div>
                    <button type="button"
                            class="pr-modal__close-btn"
                            aria-label="Cerrar detalle"
                            @onclick="CerrarDetalle">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>

                <div class="pr-modal__body">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="pr-label">Placa / Matrícula Oficial</label>
                            <div class="pr-input d-flex align-items-center pr-tnum fw-bold">@_detalle.Patente</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="pr-label">Categoría de Servicio</label>
                            <div class="pr-input d-flex align-items-center">@ValorVisible(_detalle.TipoVehiculo)</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="pr-label">Capacidad de Carga</label>
                            <div class="pr-input d-flex align-items-center">@ValorVisible(_detalle.CapacidadCarga)</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="pr-label">Licencia Habilitante</label>
                            <div class="pr-input d-flex align-items-center">@ValorVisible(_detalle.Licencia)</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="pr-label">Fecha de Fabricación</label>
                            <div class="pr-input d-flex align-items-center pr-tnum">@FormatearFecha(_detalle.FechaFabricación)</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="pr-label">Conductor Asignado</label>
                            <div class="pr-input d-flex align-items-center">@NombreConductorVisible(_detalle)</div>
                        </div>
                        <div class="col-12">
                            <label class="pr-label">Observaciones Técnicas</label>
                            <div class="pr-input" style="min-height: 68px; padding-top: 0.5rem;">
                                @(string.IsNullOrWhiteSpace(_detalle.CaracteristicasConductor)
                                    ? "Unidad habilitada para traslados y fletes sin observaciones técnicas adicionales registradas."
                                    : _detalle.CaracteristicasConductor)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pr-modal__footer">
                    <button type="button" class="pr-btn pr-btn--outline" @onclick="CerrarDetalle">
                        Cerrar
                    </button>
                    <button type="button" class="pr-btn pr-btn--emerald" @onclick="EditarDesdeDetalle">
                        <span class="material-symbols-outlined text-[18px]">edit</span>
                        <span>Editar / Asignar Conductor</span>
                    </button>
                </div>
            </div>
        </div>
    }
</RoleGuard>

@code {
    private const string EstadoDisponible = "DISPONIBLE";

    private static readonly CultureInfo CulturaMoneda = CultureInfo.GetCultureInfo("es-AR");
    private static readonly CultureInfo CulturaInvariante = CultureInfo.InvariantCulture;

    private List<VehiculoDTO> _vehiculos = new List<VehiculoDTO>();
    private List<ChoferDTO> _choferes = new List<ChoferDTO>();
    private RegistroVehiculoDTO _alta = CrearModeloAlta();
    private VehiculoDTO? _detalle;
    private decimal _tarifa;
    private decimal _tarifaActual;
    private bool _cargando = true;
    private bool _cargado;
    private bool _guardando;
    private bool _guardandoTarifa;
    private bool _tarifaCargada;
    private bool _errorCarga;
    private bool _mostrarModalAlta;
    private int? _vehiculoEditandoId;
    private string? _mensaje;
    private string? _error;
    private string? _errorAlta;

    // Filtros de búsqueda y categorización operativa
    private string _busqueda = string.Empty;
    private string _filtroEstado = string.Empty;
    private string _filtroTipo = string.Empty;

    private List<VehiculoDTO> VehiculosFiltrados
    {
        get
        {
            IEnumerable<VehiculoDTO> consulta = _vehiculos;

            if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                string b = _busqueda.Trim();
                consulta = consulta.Where(v =>
                    (!string.IsNullOrEmpty(v.Nombre) && v.Nombre.Contains(b, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(v.Patente) && v.Patente.Contains(b, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(v.Marca) && v.Marca.Contains(b, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(v.MarcaModelo) && v.MarcaModelo.Contains(b, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(v.Licencia) && v.Licencia.Contains(b, StringComparison.OrdinalIgnoreCase))
                );
            }

            if (!string.IsNullOrWhiteSpace(_filtroEstado))
            {
                consulta = consulta.Where(v => string.Equals(v.Estado, _filtroEstado, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_filtroTipo))
            {
                consulta = consulta.Where(v => string.Equals(v.TipoVehiculo, _filtroTipo, StringComparison.OrdinalIgnoreCase));
            }

            return consulta.ToList();
        }
    }

    private int TotalDisponibles => _vehiculos.Count(v => string.Equals(v.Estado, EstadoDisponible, StringComparison.OrdinalIgnoreCase));

    private int TotalEnUso => _vehiculos.Count(v => string.Equals(v.Estado, "EN_USO", StringComparison.OrdinalIgnoreCase));

    private int TotalMantenimiento => _vehiculos.Count(v => string.Equals(v.Estado, "MANTENIMIENTO", StringComparison.OrdinalIgnoreCase));

    private int PorcentajeDisponibles => _vehiculos.Count == 0 ? 0 : (int)Math.Round((double)TotalDisponibles / _vehiculos.Count * 100);

    protected override void OnInitialized()
    {
        Sesion.CambioSesion += AlCambiarSesion;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await CargarSiCorrespondeAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        Sesion.CambioSesion -= AlCambiarSesion;
    }

    private void AlCambiarSesion()
    {
        _ = InvokeAsync(async () =>
        {
            await CargarSiCorrespondeAsync();
            StateHasChanged();
        });
    }

    // Espera a que la sesión esté restaurada y con un prestador identificado.
    private async Task CargarSiCorrespondeAsync()
    {
        if (_cargado || !Sesion.Restaurada || !Sesion.EstaLogueado || Sesion.Id <= 0)
        {
            return;
        }

        _cargado = true;
        await CargarVehiculosAsync();
        await CargarTarifaAsync();
        await CargarChoferesAsync();
    }

    private async Task CargarChoferesAsync()
    {
        try
        {
            _choferes = await Http.GetFromJsonAsync<List<ChoferDTO>>($"api/prestador/{Sesion.Id}/choferes") ?? new List<ChoferDTO>();
        }
        catch
        {
            _choferes = new List<ChoferDTO>();
        }
    }

    private async Task CargarVehiculosAsync()
    {
        _cargando = true;
        _error = null;

        HttpResp<List<VehiculoDTO>> respuesta = await Flota.ListarAsync(Sesion.Id);

        _cargando = false;

        if (respuesta.Error)
        {
            _error = await respuesta.ObtenerMensajeAsync("No pudimos cargar los vehículos.");
            _errorCarga = true;
            return;
        }

        _vehiculos = respuesta.Respuesta ?? new List<VehiculoDTO>();
    }

    private async Task CargarTarifaAsync()
    {
        HttpResp<TarifaKmDTO> respuesta = await Flota.ObtenerTarifaAsync(Sesion.Id);

        if (respuesta.Error || respuesta.Respuesta is null)
        {
            if (string.IsNullOrWhiteSpace(_error))
            {
                _error = await respuesta.ObtenerMensajeAsync("No pudimos cargar la tarifa base por kilómetro.");
            }

            _errorCarga = true;
            return;
        }

        _tarifaActual = respuesta.Respuesta.TarifaBaseKm;
        _tarifa = respuesta.Respuesta.TarifaBaseKm;
        _tarifaCargada = true;
    }

    private async Task ReintentarAsync()
    {
        _error = null;
        _errorCarga = false;
        _cargado = false;

        await CargarSiCorrespondeAsync();
    }

    private async Task RegistrarAsync()
    {
        _errorAlta = null;
        _mensaje = null;

        string? validacion = ValidarAlta();

        if (validacion is not null)
        {
            _errorAlta = validacion;
            return;
        }

        _alta.IdUsuario = Sesion.Id;
        _alta.Nombre = _alta.Nombre?.Trim();
        _alta.Patente = _alta.Patente.Trim().ToUpperInvariant();
        _alta.Marca = _alta.Marca.Trim();
        _alta.MarcaModelo = _alta.MarcaModelo.Trim();
        _alta.Licencia = _alta.Licencia.Trim();
        _alta.CapacidadCarga = _alta.CapacidadCarga.Trim();
        _alta.CaracteristicasConductor = _alta.CaracteristicasConductor.Trim();

        _guardando = true;

        bool esEdicion = _vehiculoEditandoId.HasValue;
        HttpResp<VehiculoDTO> respuesta = esEdicion
            ? await Flota.ActualizarAsync(_vehiculoEditandoId!.Value, _alta)
            : await Flota.RegistrarAsync(_alta);

        _guardando = false;

        if (respuesta.Error)
        {
            _errorAlta = await respuesta.ObtenerMensajeAsync(esEdicion
                ? "No pudimos actualizar el vehículo."
                : "No pudimos registrar el vehículo.");
            return;
        }

        _mensaje = esEdicion
            ? "El vehículo se actualizó correctamente."
            : "El vehículo se registró correctamente.";
        _alta = CrearModeloAlta();
        _vehiculoEditandoId = null;
        _mostrarModalAlta = false;
        await CargarVehiculosAsync();
    }

    private async Task GuardarTarifaAsync()
    {
        _error = null;
        _mensaje = null;

        if (_tarifa < 0)
        {
            _error = "La tarifa base por kilómetro no puede ser negativa.";
            return;
        }

        _guardandoTarifa = true;

        HttpResp<TarifaKmDTO> respuesta = await Flota.GuardarTarifaAsync(Sesion.Id, _tarifa);

        _guardandoTarifa = false;

        if (respuesta.Error)
        {
            _error = await respuesta.ObtenerMensajeAsync("No pudimos guardar la tarifa base por kilómetro.");
            return;
        }

        _tarifaActual = respuesta.Respuesta is not null ? respuesta.Respuesta.TarifaBaseKm : _tarifa;
        _mensaje = "La tarifa base por kilómetro se guardó correctamente.";
    }

    private void AbrirModalAlta()
    {
        _vehiculoEditandoId = null;
        _alta = CrearModeloAlta();
        _errorAlta = null;
        _mensaje = null;
        _mostrarModalAlta = true;

        if (_choferes.Count == 0 && Sesion.Id > 0)
        {
            _ = InvokeAsync(async () =>
            {
                await CargarChoferesAsync();
                StateHasChanged();
            });
        }
    }

    private void AbrirModalEdicion(VehiculoDTO vehiculo)
    {
        int idChoferActual = vehiculo.IdChofer ?? vehiculo.NumeroConductor;
        _vehiculoEditandoId = vehiculo.Id;
        _alta = new RegistroVehiculoDTO
        {
            IdUsuario = vehiculo.IdUsuario > 0 ? vehiculo.IdUsuario : Sesion.Id,
            IdChofer = idChoferActual > 0 ? idChoferActual : 0,
            NumeroConductor = idChoferActual > 0 ? idChoferActual : 0,
            Patente = vehiculo.Patente ?? string.Empty,
            Nombre = vehiculo.Nombre ?? string.Empty,
            Marca = vehiculo.Marca ?? string.Empty,
            MarcaModelo = vehiculo.MarcaModelo ?? string.Empty,
            TipoVehiculo = vehiculo.TipoVehiculo ?? string.Empty,
            CapacidadCarga = vehiculo.CapacidadCarga ?? string.Empty,
            Licencia = vehiculo.Licencia ?? string.Empty,
            Estado = string.IsNullOrWhiteSpace(vehiculo.Estado) ? EstadoDisponible : vehiculo.Estado,
            FechaFabricación = !vehiculo.FechaFabricación.HasValue || vehiculo.FechaFabricación.Value == default
                ? DateTime.Today
                : vehiculo.FechaFabricación.Value,
            CaracteristicasConductor = vehiculo.CaracteristicasConductor ?? string.Empty
        };
        _errorAlta = null;
        _mensaje = null;
        _mostrarModalAlta = true;

        if (_choferes.Count == 0 && Sesion.Id > 0)
        {
            _ = InvokeAsync(async () =>
            {
                await CargarChoferesAsync();
                StateHasChanged();
            });
        }
    }

    private void EditarDesdeDetalle()
    {
        if (_detalle is null)
        {
            return;
        }

        VehiculoDTO vehiculo = _detalle;
        _detalle = null;
        AbrirModalEdicion(vehiculo);
    }

    private void AlSeleccionarChofer(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idChofer) && idChofer > 0)
        {
            _alta.IdChofer = idChofer;
            _alta.NumeroConductor = idChofer;
        }
        else
        {
            _alta.IdChofer = 0;
            _alta.NumeroConductor = 0;
        }
    }

    private string NombreConductorVisible(VehiculoDTO vehiculo)
    {
        int idBuscado = vehiculo.IdChofer ?? vehiculo.NumeroConductor;
        if (idBuscado <= 0)
        {
            return "Sin asignar";
        }

        ChoferDTO? chofer = _choferes.FirstOrDefault(c => c.Id == idBuscado);
        if (chofer is not null)
        {
            return $"{chofer.Nombre} {chofer.Apellido}".Trim();
        }

        return $"Conductor N° {idBuscado}";
    }

    private void CerrarModalAlta()
    {
        if (_guardando)
        {
            return;
        }

        _mostrarModalAlta = false;
        _vehiculoEditandoId = null;
        _errorAlta = null;
    }

    private async Task IrASeccionAsync(string idSeccion)
    {
        await JS.InvokeVoidAsync("eval", $"document.getElementById('{idSeccion}')?.scrollIntoView({{ behavior: 'smooth', block: 'start' }});");
    }

    private void LimpiarAlta()
    {
        _alta = CrearModeloAlta();
        _error = null;
        _mensaje = null;
    }

    private void LimpiarFiltros()
    {
        _busqueda = string.Empty;
        _filtroEstado = string.Empty;
        _filtroTipo = string.Empty;
    }

    private void VerDetalle(VehiculoDTO vehiculo)
    {
        _detalle = vehiculo;
    }

    private void CerrarDetalle()
    {
        _detalle = null;
    }

    private string? ValidarAlta()
    {
        if (string.IsNullOrWhiteSpace(_alta.Nombre))
        {
            return "Ingresá un nombre o identificador para el vehículo.";
        }

        if (string.IsNullOrWhiteSpace(_alta.Patente))
        {
            return "Ingresá la patente del vehículo.";
        }

        if (string.IsNullOrWhiteSpace(_alta.Marca))
        {
            return "Ingresá la marca del vehículo.";
        }

        if (string.IsNullOrWhiteSpace(_alta.MarcaModelo))
        {
            return "Ingresá la marca y el modelo del vehículo.";
        }

        if (string.IsNullOrWhiteSpace(_alta.TipoVehiculo))
        {
            return "Seleccioná el tipo de vehículo.";
        }

        if (string.IsNullOrWhiteSpace(_alta.CapacidadCarga))
        {
            return "Ingresá la capacidad de carga.";
        }

        if (string.IsNullOrWhiteSpace(_alta.Licencia))
        {
            return "Ingresá la licencia del vehículo.";
        }

        if (_alta.FechaFabricación == default)
        {
            return "Seleccioná la fecha de fabricación.";
        }

        if (_alta.FechaFabricación.Date > DateTime.Today)
        {
            return "La fecha de fabricación no puede ser futura.";
        }

        if (_alta.NumeroConductor < 0)
        {
            return "El número de conductor no puede ser negativo.";
        }

        return null;
    }

    private static RegistroVehiculoDTO CrearModeloAlta()
    {
        return new RegistroVehiculoDTO
        {
            Nombre = string.Empty,
            Patente = string.Empty,
            Marca = string.Empty,
            MarcaModelo = string.Empty,
            TipoVehiculo = string.Empty,
            CapacidadCarga = string.Empty,
            Licencia = string.Empty,
            Estado = EstadoDisponible,
            FechaFabricación = DateTime.Today,
            NumeroConductor = 0,
            CaracteristicasConductor = string.Empty,
            IdUsuario = 0,
            IdChofer = 0
        };
    }

    // El nombre del vehículo puede no estar cargado en registros anteriores.
    private static string NombreVisible(VehiculoDTO vehiculo)
    {
        if (!string.IsNullOrWhiteSpace(vehiculo.Nombre))
        {
            return vehiculo.Nombre;
        }

        return ValorVisible(vehiculo.MarcaModelo);
    }

    private static string ValorVisible(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "Sin datos" : valor;
    }

    private static string FormatearFecha(DateTime? fecha)
    {
        return !fecha.HasValue || fecha.Value == default ? "Sin datos" : fecha.Value.ToString("dd/MM/yyyy", CulturaInvariante);
    }

    private static string FormatearMoneda(decimal valor)
    {
        return "$ " + valor.ToString("N2", CulturaMoneda);
    }

    private static string ObtenerIconoVehiculo(string? tipo)
    {
        if (string.IsNullOrWhiteSpace(tipo))
        {
            return "directions_car";
        }

        string t = tipo.ToLowerInvariant();
        if (t.Contains("camión") || t.Contains("camion") || t.Contains("acoplado") || t.Contains("furgón") || t.Contains("furgon") || t.Contains("carga"))
        {
            return "local_shipping";
        }

        return "directions_car";
    }

    private static string EtiquetaEstado(string? estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "Sin estado";
        }

        return estado.ToUpperInvariant() switch
        {
            "DISPONIBLE" => "Disponible en Base",
            "EN_USO" => "En Servicio Activo",
            "MANTENIMIENTO" => "Taller / Mantenimiento",
            _ => estado
        };
    }

    private static string ObtenerClaseChipEstado(string? estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "pr-status-chip--inactivo";
        }

        return estado.ToUpperInvariant() switch
        {
            "DISPONIBLE" => "pr-status-chip--disponible",
            "EN_USO" => "pr-status-chip--transito",
            "MANTENIMIENTO" => "pr-status-chip--ocupado",
            _ => "pr-status-chip--inactivo"
        };
    }
}
