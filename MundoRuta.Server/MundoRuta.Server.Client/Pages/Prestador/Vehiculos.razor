@page "/prestador/vehiculos"

<PageTitle>Vehículos | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Prestador">
    <div class="mr-page">
        <div class="mr-container">
            <PageHeader Titulo="Vehículos"
                        Descripcion="Flota disponible para operar." />

            <EmptyState Titulo="Todavía no cargaste vehículos"
                        Descripcion="Desde acá vas a poder registrar patente, marca y modelo de cada vehículo.">
                <a class="btn btn-outline-primary" href="/prestador">Volver al panel</a>
            </EmptyState>
        </div>
    </div>
</RoleGuard>
