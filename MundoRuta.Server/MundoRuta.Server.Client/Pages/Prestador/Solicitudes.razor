@page "/prestador/solicitudes"

<PageTitle>Solicitudes | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Prestador">
    <div class="mr-page">
        <div class="mr-container">
            <PageHeader Titulo="Solicitudes"
                        Descripcion="Pedidos pendientes de respuesta." />

            <EmptyState Titulo="No hay solicitudes pendientes"
                        Descripcion="Cuando un pasajero solicite un viaje lo vas a ver acá para aceptar, rechazar o contraofertar.">
                <a class="btn btn-outline-primary" href="/prestador">Volver al panel</a>
            </EmptyState>
        </div>
    </div>
</RoleGuard>
