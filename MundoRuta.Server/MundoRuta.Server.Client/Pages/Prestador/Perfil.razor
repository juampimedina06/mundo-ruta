@page "/prestador/perfil"

<PageTitle>Mi perfil | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Prestador">
    <div class="mr-page">
        <div class="mr-container">
            <PageHeader Titulo="Mi perfil"
                        Descripcion="Datos de la empresa y estado de la cuenta." />

            <EmptyState Titulo="Perfil en preparación"
                        Descripcion="Acá vas a poder actualizar razón social, CUIT y datos de contacto.">
                <a class="btn btn-outline-primary" href="/prestador">Volver al panel</a>
            </EmptyState>
        </div>
    </div>
</RoleGuard>
