@page "/prestador/choferes"
@layout PrestadorLayout
@using System.Net.Http.Json
@using MundoRuta.Shared.DTO
@using MundoRuta.Shared
@using MundoRuta.Servicios.Sesion
@inject HttpClient Http
@inject SesionEstado Sesion
@implements IDisposable

<PageTitle>Gestión de Choferes | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Prestador">
    <div class="d-flex flex-column gap-4">
        <!-- Top Header & Primary CTAs -->
        <div class="pr-header-block">
            <div>
                <div class="pr-header-meta">
                    <span class="pr-tag pr-tag--mono">GET /api/prestador/{prestadorId}/choferes</span>
                    <span class="pr-tag pr-tag--emerald">ChoferDTO</span>
                    <span class="badge bg-primary text-white font-label-sm px-2 py-0.5 rounded-full" style="font-size: 11px;">Operativo</span>
                </div>
                <h1 class="pr-page-title">Gestión de Choferes</h1>
                <p class="pr-page-subtitle">Listado y administración de choferes registrados según ChoferDTO.</p>
            </div>
            <div class="pr-header-actions">
                <button type="button" class="pr-btn pr-btn--outline" @onclick="ExportarNomina">
                    <span class="material-symbols-outlined text-[18px]">file_download</span>
                    <span>Exportar Nómina</span>
                </button>
                <button type="button" class="pr-btn pr-btn--emerald" @onclick="AbrirModalAlta">
                    <span class="material-symbols-outlined text-[20px]">person_add</span>
                    <span>+ Registrar Chofer</span>
                </button>
            </div>
        </div>

        @if (error is not null)
        {
            <div class="pr-alert pr-alert--error">
                <div class="d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">error</span>
                    <span>@error</span>
                </div>
                <button type="button" class="pr-icon-btn pr-icon-btn--danger" @onclick="() => error = null">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }

        @if (mensajeExito is not null)
        {
            <div class="pr-alert pr-alert--success">
                <div class="d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    <span>@mensajeExito</span>
                </div>
                <button type="button" class="pr-icon-btn" @onclick="() => mensajeExito = null">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }

        <!-- Quick Metrics / Fleet KPIs Strip -->
        <div class="pr-kpi-grid">
            <!-- KPI 1: Total Choferes -->
            <div class="pr-kpi-card">
                <div class="pr-kpi-header">
                    <span class="pr-kpi-label">Total Choferes</span>
                    <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--navy">
                        <span class="material-symbols-outlined text-[20px]">badge</span>
                    </div>
                </div>
                <div class="pr-kpi-body">
                    <div class="pr-kpi-value-row">
                        <span class="pr-kpi-value pr-tnum">@TotalChoferes</span>
                        <span class="pr-kpi-badge pr-kpi-badge--emerald">Nómina</span>
                    </div>
                    <div class="pr-kpi-subtext">Registrados en la plataforma</div>
                    <div class="pr-kpi-progress">
                        <div class="pr-kpi-progress-bar pr-kpi-progress-bar--navy" style="width: 100%;"></div>
                    </div>
                </div>
            </div>

            <!-- KPI 2: En Servicio / Activos -->
            <div class="pr-kpi-card">
                <div class="pr-kpi-header">
                    <span class="pr-kpi-label">Activos / Disponibles</span>
                    <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--emerald">
                        <span class="material-symbols-outlined text-[20px]">local_shipping</span>
                    </div>
                </div>
                <div class="pr-kpi-body">
                    <div class="pr-kpi-value-row">
                        <span class="pr-kpi-value pr-tnum">@TotalActivos</span>
                        <span class="pr-kpi-badge pr-kpi-badge--emerald">@PorcentajeActivos% activos</span>
                    </div>
                    <div class="pr-kpi-subtext">Listos para tomar viajes</div>
                    <div class="pr-kpi-progress">
                        <div class="pr-kpi-progress-bar pr-kpi-progress-bar--emerald" style="width: @(PorcentajeActivos)%;"></div>
                    </div>
                </div>
            </div>

            <!-- KPI 3: Licencias Habilitadas -->
            <div class="pr-kpi-card">
                <div class="pr-kpi-header">
                    <span class="pr-kpi-label">Licencias Habilitadas</span>
                    <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--amber">
                        <span class="material-symbols-outlined text-[20px]">verified_user</span>
                    </div>
                </div>
                <div class="pr-kpi-body">
                    <div class="pr-kpi-value-row">
                        <span class="pr-kpi-value pr-tnum">@TotalChoferes</span>
                        <span class="pr-kpi-badge pr-kpi-badge--amber">CNRT / Nac.</span>
                    </div>
                    <div class="pr-kpi-subtext">Documentación al día</div>
                    <div class="pr-kpi-progress">
                        <div class="pr-kpi-progress-bar pr-kpi-progress-bar--amber" style="width: 100%;"></div>
                    </div>
                </div>
            </div>

            <!-- KPI 4: Inactivos / Ocupados -->
            <div class="pr-kpi-card">
                <div class="pr-kpi-header">
                    <span class="pr-kpi-label">Ocupados / Inactivos</span>
                    <div class="pr-kpi-icon-wrap pr-kpi-icon-wrap--slate">
                        <span class="material-symbols-outlined text-[20px]">pause_circle</span>
                    </div>
                </div>
                <div class="pr-kpi-body">
                    <div class="pr-kpi-value-row">
                        <span class="pr-kpi-value pr-tnum">@TotalInactivos</span>
                        <span class="pr-kpi-badge pr-kpi-badge--emerald">En ruta / turno</span>
                    </div>
                    <div class="pr-kpi-subtext">En viaje o fuera de turno</div>
                    <div class="pr-kpi-progress">
                        <div class="pr-kpi-progress-bar pr-kpi-progress-bar--navy" style="width: @(TotalChoferes > 0 ? (TotalInactivos * 100 / TotalChoferes) : 0)%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search & Filters Toolbar -->
        <div class="pr-toolbar">
            <div class="pr-toolbar-row">
                <!-- Search Input -->
                <div class="pr-search-box">
                    <span class="material-symbols-outlined">search</span>
                    <input type="text"
                           class="pr-search-input"
                           placeholder="Buscar por ID, nombre, licencia o estado..."
                           @bind="_filtroTexto"
                           @bind:event="oninput" />
                </div>

                <!-- Status Filter Pills -->
                <div class="pr-filter-pills">
                    <button type="button"
                            class="pr-filter-pill @(_filtroEstado == "TODOS" ? "active" : "")"
                            @onclick='() => _filtroEstado = "TODOS"'>
                        <span>Todos</span>
                        <span class="pr-filter-pill__count">@TotalChoferes</span>
                    </button>
                    <button type="button"
                            class="pr-filter-pill @(_filtroEstado == "DISPONIBLE" ? "active" : "")"
                            @onclick='() => _filtroEstado = "DISPONIBLE"'>
                        <span>Activos</span>
                        <span class="pr-filter-pill__count">@TotalActivos</span>
                    </button>
                    <button type="button"
                            class="pr-filter-pill @(_filtroEstado == "OCUPADO" ? "active" : "")"
                            @onclick='() => _filtroEstado = "OCUPADO"'>
                        <span>Ocupados / Inactivos</span>
                        <span class="pr-filter-pill__count">@TotalInactivos</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Choferes Data Grid -->
        @if (!TienePrestador)
        {
            <div class="pr-alert pr-alert--error">No se indicó el prestador y no hay una sesión activa.</div>
        }
        else if (choferes is null)
        {
            <div class="pr-loading">
                <div class="pr-spinner"></div>
                <span>Cargando nómina de choferes...</span>
            </div>
        }
        else if (!choferes.Any())
        {
            <div class="pr-empty-state">
                <div class="pr-empty-icon">
                    <span class="material-symbols-outlined">badge</span>
                </div>
                <h3 class="pr-empty-title">Todavía no registraste choferes</h3>
                <p class="pr-empty-desc">Da de alta al primer conductor para comenzar a asignarle vehículos y viajes en la plataforma.</p>
                <button type="button" class="pr-btn pr-btn--emerald" @onclick="AbrirModalAlta">
                    <span class="material-symbols-outlined text-[18px]">person_add</span>
                    <span>Registrar primer chofer</span>
                </button>
            </div>
        }
        else if (!ChoferesFiltrados.Any())
        {
            <div class="pr-empty-state">
                <div class="pr-empty-icon">
                    <span class="material-symbols-outlined">search_off</span>
                </div>
                <h3 class="pr-empty-title">Sin resultados coincidentes</h3>
                <p class="pr-empty-desc">No encontramos ningún chofer que coincida con "@_filtroTexto".</p>
                <button type="button" class="pr-btn pr-btn--outline" @onclick="LimpiarFiltros">
                    <span>Limpiar filtros</span>
                </button>
            </div>
        }
        else
        {
            <div class="pr-table-card">
                <div class="pr-table-responsive">
                    <table class="pr-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">ID (#)</th>
                                <th>Nombre y Apellido</th>
                                <th>Licencia</th>
                                <th>Estado</th>
                                <th>ID Usuario</th>
                                <th class="text-end" style="width: 100px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var chofer in ChoferesFiltrados)
                            {
                                <tr>
                                    <td>
                                        <span class="pr-badge-id">#@chofer.Id</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="pr-topbar__avatar" style="width: 28px; height: 28px; font-size: 11px;">
                                                @(string.IsNullOrWhiteSpace(chofer.Nombre) ? "C" : chofer.Nombre.Substring(0, 1).ToUpperInvariant())
                                            </div>
                                            <span class="fw-bold text-dark" style="font-family: var(--pr-font-display);">@chofer.Nombre @chofer.Apellido</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="pr-tnum fw-semibold text-secondary">@chofer.Licencia</span>
                                    </td>
                                    <td>
                                        <span class="pr-status-chip @(EsActivo(chofer.Estado) ? "pr-status-chip--active" : "pr-status-chip--inactivo")">
                                            <span class="dot"></span>
                                            <span>@(EsActivo(chofer.Estado) ? "Activo" : "Inactivo")</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="pr-tnum text-muted font-monospace">@chofer.IdUsuario</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <button type="button" class="pr-icon-btn" title="Editar chofer">
                                                <span class="material-symbols-outlined text-[18px]">edit</span>
                                            </button>
                                            <button type="button" class="pr-icon-btn pr-icon-btn--danger" title="Eliminar chofer">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pr-table-footer">
                    <span>Mostrando @ChoferesFiltrados.Count de @(choferes.Count) choferes (ChoferDTO)</span>
                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="pr-btn pr-btn--subtle pr-btn-sm" disabled>Anterior</button>
                        <button type="button" class="pr-btn pr-btn--navy pr-btn-sm">1</button>
                        <button type="button" class="pr-btn pr-btn--subtle pr-btn-sm" disabled>Siguiente</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- MODAL OVERLAY: 'Nuevo Chofer' (POST /api/prestador/choferes -> ChoferAltaDTO) -->
    @if (_modalAltaAbierto)
    {
        <div class="pr-modal-backdrop" @onclick="CerrarModalSiBackdrop">
            <div class="pr-modal" @onclick:stopPropagation>
                <!-- Top Emerald Accent Stripe -->
                <div class="pr-modal__stripe"></div>

                <!-- Modal Header -->
                <div class="pr-modal__header">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="pr-tag pr-tag--mono">POST /api/prestador/choferes</span>
                            <span class="pr-tag pr-tag--emerald">ChoferAltaDTO</span>
                        </div>
                        <h2 class="pr-modal__title">Nuevo Chofer</h2>
                        <p class="pr-modal__subtitle">Completa los campos obligatorios del modelo ChoferAltaDTO.</p>
                    </div>
                    <button type="button" class="pr-modal__close-btn" aria-label="Cerrar" @onclick="CerrarModalAlta">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>

                <!-- Modal Form Body strictly adhering to ChoferAltaDTO -->
                <form class="pr-modal__body" @onsubmit="CrearChofer" @onsubmit:preventDefault>
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="pr-label">
                                IdPrestador <span class="required">*</span>
                            </label>
                            <input class="pr-input"
                                   type="number"
                                   value="@PrestadorIdEfectivo"
                                   disabled
                                   readonly />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="pr-label" for="alta-cuit">
                                CUIT <span class="required">*</span>
                            </label>
                            <input id="alta-cuit"
                                   class="pr-input"
                                   placeholder="20-34982011-2"
                                   required
                                   @bind="nuevoChofer.Cuit" />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="pr-label" for="alta-nombre">
                                Nombre <span class="required">*</span>
                            </label>
                            <input id="alta-nombre"
                                   class="pr-input"
                                   placeholder="Carlos"
                                   required
                                   @bind="nuevoChofer.Nombre" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="pr-label" for="alta-apellido">
                                Apellido <span class="required">*</span>
                            </label>
                            <input id="alta-apellido"
                                   class="pr-input"
                                   placeholder="Gómez"
                                   required
                                   @bind="nuevoChofer.Apellido" />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="pr-label" for="alta-tel">
                                Teléfono de Contacto <span class="required">*</span>
                            </label>
                            <input id="alta-tel"
                                   class="pr-input"
                                   type="number"
                                   placeholder="1148201122"
                                   required
                                   @bind="nuevoChofer.Telefono" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="pr-label" for="alta-licencia">
                                Licencia Nacional <span class="required">*</span>
                            </label>
                            <input id="alta-licencia"
                                   class="pr-input"
                                   placeholder="Ej: B2-94820112"
                                   required
                                   @bind="nuevoChofer.Licencia" />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="pr-label" for="alta-estado">
                                Estado Inicial <span class="required">*</span>
                            </label>
                            <select id="alta-estado" class="pr-select" @bind="nuevoChofer.Estado">
                                <option value="DISPONIBLE">DISPONIBLE</option>
                                <option value="OCUPADO">OCUPADO</option>
                            </select>
                        </div>
                    </div>

                    <!-- Credential Access Notice -->
                    <div class="pr-modal__alert-box">
                        <span class="material-symbols-outlined text-[20px] text-primary" style="margin-top: 1px;">lock</span>
                        <div>
                            <div class="fw-bold text-dark mb-0.5" style="font-size: 13px;">Aviso de acceso para el conductor</div>
                            <p class="mb-0 text-muted" style="font-size: 12px;">
                                Define una contraseña general inicial y registra el correo electrónico del chofer. Con estos datos, el conductor podrá iniciar sesión en la app oficial de Mundo Ruta y gestionar sus viajes asignados.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="pr-label" for="alta-email">
                                Correo Electrónico <span class="required">*</span>
                            </label>
                            <input id="alta-email"
                                   class="pr-input"
                                   type="email"
                                   placeholder="chofer@mundoruta.com"
                                   required
                                   @bind="nuevoChofer.Email" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="pr-label" for="alta-pass">
                                Contraseña Inicial <span class="required">*</span>
                            </label>
                            <input id="alta-pass"
                                   class="pr-input"
                                   type="password"
                                   placeholder="Clave de acceso provisoria"
                                   required
                                   @bind="nuevoChofer.Password" />
                        </div>
                    </div>

                    <!-- Modal Actions Footer -->
                    <div class="pr-modal__footer">
                        <button type="button" class="pr-btn pr-btn--subtle" @onclick="CerrarModalAlta" disabled="@enviando">
                            Cancelar
                        </button>
                        <button type="submit" class="pr-btn pr-btn--emerald" disabled="@(enviando || !TienePrestador)">
                            @if (enviando)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Registrando...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-[18px]">person_add</span>
                                <span>Registrar Chofer</span>
                            }
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
</RoleGuard>

@code {
    [Parameter] public int PrestadorId { get; set; }
    [SupplyParameterFromQuery(Name = "prestadorId")] public string? PrestadorIdQuery { get; set; }

    private int PrestadorIdEfectivo =>
        PrestadorId > 0
            ? PrestadorId
            : (int.TryParse(PrestadorIdQuery, out int id) && id > 0 ? id : Sesion.Id);

    private bool TienePrestador => PrestadorIdEfectivo > 0;

    private List<ChoferDTO>? choferes;
    private ChoferAltaDTO nuevoChofer = CrearFormularioVacio();
    private bool enviando;
    private string? error;
    private string? mensajeExito;

    private string _filtroTexto = string.Empty;
    private string _filtroEstado = "TODOS";
    private bool _modalAltaAbierto;

    private int TotalChoferes => choferes?.Count ?? 0;
    private int TotalActivos => choferes?.Count(c => EsActivo(c.Estado)) ?? 0;
    private int TotalInactivos => TotalChoferes - TotalActivos;
    private int PorcentajeActivos => TotalChoferes > 0 ? (TotalActivos * 100 / TotalChoferes) : 0;

    private List<ChoferDTO> ChoferesFiltrados =>
        (choferes ?? new List<ChoferDTO>())
            .Where(c =>
            {
                if (_filtroEstado != "TODOS")
                {
                    bool matchActivo = _filtroEstado == "DISPONIBLE" ? EsActivo(c.Estado) : !EsActivo(c.Estado);
                    if (!matchActivo) return false;
                }

                if (!string.IsNullOrWhiteSpace(_filtroTexto))
                {
                    string q = _filtroTexto.Trim().ToLowerInvariant();
                    string idStr = c.Id.ToString();
                    string nom = (c.Nombre ?? "").ToLowerInvariant();
                    string ape = (c.Apellido ?? "").ToLowerInvariant();
                    string lic = (c.Licencia ?? "").ToLowerInvariant();
                    string est = (c.Estado ?? "").ToLowerInvariant();

                    if (!idStr.Contains(q) && !nom.Contains(q) && !ape.Contains(q) && !lic.Contains(q) && !est.Contains(q))
                    {
                        return false;
                    }
                }

                return true;
            })
            .ToList();

    protected override void OnInitialized()
    {
        Sesion.CambioSesion += AlCambiarSesion;
    }

    protected override async Task OnParametersSetAsync()
    {
        error = null;
        mensajeExito = null;

        if (TienePrestador)
        {
            nuevoChofer.IdPrestador = PrestadorIdEfectivo;
            await CargarChoferes();
        }
    }

    public void Dispose()
    {
        Sesion.CambioSesion -= AlCambiarSesion;
    }

    private async void AlCambiarSesion()
    {
        if (TienePrestador && choferes is null)
        {
            nuevoChofer.IdPrestador = PrestadorIdEfectivo;
            await CargarChoferes();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarChoferes()
    {
        if (!TienePrestador) return;

        error = null;
        try
        {
            choferes = await Http.GetFromJsonAsync<List<ChoferDTO>>($"api/prestador/{PrestadorIdEfectivo}/choferes") ?? new();
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar los choferes: {ex.Message}";
        }
    }

    private void AbrirModalAlta()
    {
        error = null;
        mensajeExito = null;
        nuevoChofer = CrearFormularioVacio();
        nuevoChofer.IdPrestador = PrestadorIdEfectivo;
        _modalAltaAbierto = true;
    }

    private void CerrarModalAlta()
    {
        _modalAltaAbierto = false;
    }

    private void CerrarModalSiBackdrop()
    {
        _modalAltaAbierto = false;
    }

    private void LimpiarFiltros()
    {
        _filtroTexto = string.Empty;
        _filtroEstado = "TODOS";
    }

    private void ExportarNomina()
    {
        // Feedback informativo de exportación
        mensajeExito = "Nómina de choferes exportada a formato compatible con despacho.";
    }

    private async Task CrearChofer()
    {
        error = null;
        mensajeExito = null;

        if (!TienePrestador)
        {
            error = "No se indicó el prestador y no hay sesión activa.";
            return;
        }

        string? validacion = ValidarFormulario();
        if (validacion is not null)
        {
            error = validacion;
            return;
        }

        enviando = true;
        try
        {
            nuevoChofer.IdPrestador = PrestadorIdEfectivo;
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/prestador/choferes", nuevoChofer);

            if (!response.IsSuccessStatusCode)
            {
                string detalle = (await response.Content.ReadAsStringAsync()).Trim('"');
                error = string.IsNullOrWhiteSpace(detalle)
                    ? "No se pudo registrar el chofer."
                    : detalle;
                return;
            }

            mensajeExito = "Chofer registrado correctamente.";
            _modalAltaAbierto = false;
            nuevoChofer = CrearFormularioVacio();
            nuevoChofer.IdPrestador = PrestadorIdEfectivo;
            await CargarChoferes();
        }
        catch (Exception ex)
        {
            error = $"No se pudo registrar el chofer: {ex.Message}";
        }
        finally
        {
            enviando = false;
        }
    }

    private string? ValidarFormulario()
    {
        if (string.IsNullOrWhiteSpace(nuevoChofer.Nombre))
            return "El nombre es obligatorio.";
        if (string.IsNullOrWhiteSpace(nuevoChofer.Apellido))
            return "El apellido es obligatorio.";
        if (string.IsNullOrWhiteSpace(nuevoChofer.Licencia))
            return "La licencia es obligatoria.";
        if (string.IsNullOrWhiteSpace(nuevoChofer.Email) || !nuevoChofer.Email.Contains('@'))
            return "El email es obligatorio y debe ser válido.";
        if (string.IsNullOrWhiteSpace(nuevoChofer.Password))
            return "La contraseña es obligatoria.";
        if (nuevoChofer.Telefono <= 0)
            return "El teléfono es obligatorio.";
        if (string.IsNullOrWhiteSpace(nuevoChofer.Cuit))
            return "El CUIT es obligatorio.";
        return null;
    }

    private static ChoferAltaDTO CrearFormularioVacio() => new()
    {
        IdPrestador = 0,
        Nombre = string.Empty,
        Apellido = string.Empty,
        Licencia = string.Empty,
        Estado = "DISPONIBLE",
        Telefono = 0,
        Cuit = string.Empty,
        Email = string.Empty,
        Password = string.Empty
    };

    private static bool EsActivo(string? estado) =>
        string.Equals(estado, "DISPONIBLE", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(estado, "ACTIVO", StringComparison.OrdinalIgnoreCase);
}
