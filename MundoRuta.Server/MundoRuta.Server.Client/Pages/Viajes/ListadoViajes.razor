@page "/viajes"
@page "/usuario/viajes"
@using MundoRuta.Shared
@using MundoRuta.Shared.DTO
@inject IHttpServices Http
@inject SesionEstado Sesion
@inject NavigationManager Navegacion

<PageTitle>Mis viajes | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="@Roles.Usuario">
    <div class="mr-page">
        <div class="mr-container">
            <PageHeader Titulo="Mis viajes"
                        Descripcion="Historial y estado de tus solicitudes." />

            @if (!Sesion.Restaurada)
            {
                <div class="mr-loading">Cargando sesi��n...</div>
            }
            else if (!Sesion.EstaLogueado || Sesion.Id <= 0)
            {
                <div class="mr-alert mr-alert--error">No hay sesi��n activa. Inici�� sesi��n para ver tus viajes.</div>
                <a class="btn btn-primary mt-3" href="/login">Iniciar sesi��n</a>
            }
            else
            {
                <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
                    <div class="fw-semibold">Filtrar por estado:</div>
                    <button class="btn @( _filtroEstado == "TODOS" ? "btn-primary" : "btn-outline-primary" )" @onclick='() => CambiarFiltro("TODOS")'>Todos</button>
                    <button class="btn @( _filtroEstado == EstadosViaje.Buscando ? "btn-primary" : "btn-outline-primary" )" @onclick='() => CambiarFiltro(EstadosViaje.Buscando)'>Buscando</button>
                    <button class="btn @( _filtroEstado == EstadosViaje.Asignado ? "btn-primary" : "btn-outline-primary" )" @onclick='() => CambiarFiltro(EstadosViaje.Asignado)'>Asignado</button>
                    <button class="btn @( _filtroEstado == EstadosViaje.CargaSubida ? "btn-primary" : "btn-outline-primary" )" @onclick='() => CambiarFiltro(EstadosViaje.CargaSubida)'>Carga subida</button>
                    <button class="btn @( _filtroEstado == EstadosViaje.EnTransito ? "btn-primary" : "btn-outline-primary" )" @onclick='() => CambiarFiltro(EstadosViaje.EnTransito)'>En tr��nsito</button>
                    <button class="btn @( _filtroEstado == EstadosViaje.LlegadaDestino ? "btn-primary" : "btn-outline-primary" )" @onclick='() => CambiarFiltro(EstadosViaje.LlegadaDestino)'>Llegada destino</button>
                    <button class="btn @( _filtroEstado == EstadosViaje.Finalizado ? "btn-primary" : "btn-outline-primary" )" @onclick='() => CambiarFiltro(EstadosViaje.Finalizado)'>Finalizado</button>
                    <button class="btn @( _filtroEstado == EstadosViaje.Cancelado ? "btn-primary" : "btn-outline-primary" )" @onclick='() => CambiarFiltro(EstadosViaje.Cancelado)'>Cancelado</button>
                </div>

                @if (_cargando)
                {
                    <div class="mr-loading">Cargando viajes...</div>
                }
                else if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="mr-alert mr-alert--error">@_error</div>
                }
                else if (_viajes is null || _viajes.Count == 0)
                {
                    <EmptyState Titulo="No hay viajes para mostrar"
                                Descripcion="Cuando solicites un viaje lo vas a ver ac�� con su estado y su detalle.">
                        <a class="btn btn-primary" href="/usuario/solicitar">Solicitar un viaje</a>
                    </EmptyState>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (ListadoViajeDTO viaje in _viajes)
                        {
                            <article class="mr-card">
                                <div class="mr-card__body d-flex flex-column flex-md-row justify-content-between gap-3">
                                    <div class="flex-grow-1">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                            <h3 class="mr-card__title mb-0">Viaje #@viaje.Id</h3>
                                            <EstadoBadge Estado="@viaje.Estado" />
                                        </div>
                                        <div class="mb-1"><strong>Origen:</strong> @viaje.Origen</div>
                                        <div class="mb-1"><strong>Destino:</strong> @viaje.Destino</div>
                                        <div class="mb-1"><strong>Fecha:</strong> @viaje.Fecha.ToString("dd/MM/yyyy")</div>
                                        <div class="mb-0"><strong>Monto:</strong> $@viaje.Monto.ToString("N2")</div>
                                    </div>
                                    <div class="d-flex align-items-start align-items-md-center">
                                        <button class="btn btn-outline-primary" @onclick="() => VerDetalle(viaje.Id)">Ver detalle</button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            }
        </div>
    </div>
</RoleGuard>

@code {
    private List<ListadoViajeDTO>? _viajes;
    private bool _cargando = true;
    private string? _error;
    private string _filtroEstado = "TODOS";

    protected override async Task OnParametersSetAsync()
    {
        if (Sesion.Restaurada)
        {
            await CargarViajesAsync();
        }
    }

    protected override void OnInitialized()
    {
        Sesion.CambioSesion += AlCambiarSesion;
    }

    private void AlCambiarSesion()
    {
        _ = InvokeAsync(async () =>
        {
            if (Sesion.Restaurada && !_cargando)
            {
                await CargarViajesAsync();
                StateHasChanged();
            }
            else if (Sesion.Restaurada)
            {
                await CargarViajesAsync();
                StateHasChanged();
            }
        });
    }

    private async Task CambiarFiltro(string filtro)
    {
        _filtroEstado = filtro;
        await CargarViajesAsync();
    }

    private async Task CargarViajesAsync()
    {
        if (!Sesion.EstaLogueado || Sesion.Id <= 0)
        {
            _cargando = false;
            return;
        }

        _cargando = true;
        _error = null;

        string url = $"api/pasajero/{Sesion.Id}/viajes";
        if (_filtroEstado != "TODOS")
        {
            url += $"?estado={Uri.EscapeDataString(_filtroEstado)}";
        }

        HttpResp<List<ListadoViajeDTO>> respuesta = await Http.GetAsync<List<ListadoViajeDTO>>(url);

        if (respuesta.Error)
        {
            _error = await respuesta.ObtenerMensajeAsync("No pudimos cargar el listado de viajes.");
            _viajes = new List<ListadoViajeDTO>();
        }
        else
        {
            _viajes = respuesta.Respuesta ?? new List<ListadoViajeDTO>();
        }

        _cargando = false;
        StateHasChanged();
    }

    private void VerDetalle(int viajeId)
    {
        Navegacion.NavigateTo($"/viajes/{viajeId}");
    }

    public void Dispose()
    {
        Sesion.CambioSesion -= AlCambiarSesion;
    }
}
