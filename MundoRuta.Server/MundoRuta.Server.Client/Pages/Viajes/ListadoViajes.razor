    private async Task DescargarReporteCsv()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("ID Viaje,Fecha Viaje,Hora Viaje,Fecha Reserva,Origen,Destino,Tipo Solicitud,Equipaje Carga,Estado,Estado Pago,Metodo Pago,Monto,Monto Estimado");

            foreach (var v in ViajesFiltrados)
            {
                string fechaViaje = FormatearFecha(v.Fecha);
                string horaViaje = FormatearHora(v.Hora);
                string fechaReserva = FormatearFecha(v.FechaHoraReserva == default ? v.Fecha : v.FechaHoraReserva);
                string horaReserva = FormatearHoraReserva(v.FechaHoraReserva == default ? v.Fecha : v.FechaHoraReserva);
                string equipaje = v.EquipajeCarga ? "Si" : "No";

                sb.AppendLine($"\"#MR-{v.Id}\",\"{fechaViaje}\",\"{horaViaje}\",\"{fechaReserva} {horaReserva}\",\"{EscaparCsv(v.Origen)}\",\"{EscaparCsv(v.Destino)}\",\"{v.TipoSolicitud}\",\"{equipaje}\",\"{v.Estado}\",\"{v.EstadoPago}\",\"{v.MetodoDePago}\",\"{v.Monto}\",\"{v.MontoEstimado}\"");
            }

            byte[] bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            string base64 = Convert.ToBase64String(bytes);
            string script = $"const a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8;base64,{base64}'; a.download = 'mis_viajes_mundo_ruta.csv'; document.body.appendChild(a); a.click(); document.body.removeChild(a);";
            await JS.InvokeVoidAsync("eval", script);
        }
        catch
        {
            // Fallback silencioso en caso de error de JS
        }
    }

    private static string EscaparCsv(string valor)
    {
        if (string.IsNullOrEmpty(valor)) return string.Empty;
        return valor.Replace("\"", "\"\"");
    }

    // FORMATTERS
    private static string FormatearFecha(DateTime fecha)
    {
        if (fecha == default) return "-";
        return fecha.ToString("dd MMM yyyy", new CultureInfo("es-ES"));
    }

    private static string FormatearHora(TimeSpan hora)
    {
        try
        {
            return DateTime.Today.Add(hora).ToString("hh:mm tt", CultureInfo.InvariantCulture).ToUpper();
        }
        catch
        {
            return hora.ToString(@"hh\:mm");
        }
    }

    private static string FormatearHoraReserva(DateTime fechaHora)
    {
        if (fechaHora == default) return "-";
        return fechaHora.ToString("HH:mm tt", CultureInfo.InvariantCulture).ToUpper();
    }

    private static string FormatearMonto(decimal monto)
    {
        return "$" + monto.ToString("N0", new CultureInfo("es-AR"));
    }

    private static string FormatearTipoSolicitud(string tipo)
    {
        if (string.IsNullOrWhiteSpace(tipo)) return "Individual";
        string t = tipo.Trim().ToLowerInvariant();
        if (t.Contains("carga")) return "Con Carga";
        if (t.Contains("compartido")) return "Compartido";
        if (t.Contains("individual")) return "Individual";
        return Capitalizar(tipo);
    }

    private static string FormatearNombreEstado(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado)) return "Buscando";
        string e = estado.Trim().ToUpperInvariant();
        return e switch
        {
            "BUSCANDO" => "Asignando",
            "ASIGNADO" => "Confirmado",
            "EN_TRANSITO" => "En Curso",
            "CARGA_SUBIDA" => "Carga Subida",
            "LLEGADA_DESTINO" => "Llegada Destino",
            "FINALIZADO" => "Finalizado",
            "CANCELADO" => "Cancelado",
            "RECHAZADO" => "Rechazado",
            "CONTRAOFERTADO" => "Contraoferta",
            _ => Capitalizar(estado.Replace('_', ' '))
        };
    }

    private static string ObtenerClaseBadgeEstado(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado)) return "mr-badge-status--buscando";
        string e = estado.Trim().ToUpperInvariant();
        return e switch
        {
            "BUSCANDO" => "mr-badge-status--buscando",
            "ASIGNADO" => "mr-badge-status--confirmado",
            "EN_TRANSITO" => "mr-badge-status--en-curso",
            "CARGA_SUBIDA" => "mr-badge-status--carga-subida",
            "LLEGADA_DESTINO" => "mr-badge-status--llegada-destino",
            "FINALIZADO" => "mr-badge-status--finalizado",
            "CANCELADO" => "mr-badge-status--cancelado",
            "RECHAZADO" => "mr-badge-status--rechazado",
            "CONTRAOFERTADO" => "mr-badge-status--contraofertado",
            _ => "mr-badge-status--default"
        };
    }

    private static string FormatearEstadoPago(string estadoPago)
    {
        if (string.IsNullOrWhiteSpace(estadoPago)) return "Pendiente";
        string ep = estadoPago.Trim().ToUpperInvariant();
        if (ep == "PAGADO") return "Pagado";
        if (ep == "PENDIENTE") return "Pendiente";
        return Capitalizar(estadoPago);
    }

    private static string ObtenerClaseBadgePago(string estadoPago)
    {
        if (string.IsNullOrWhiteSpace(estadoPago)) return "mr-badge-pago--pendiente";
        string ep = estadoPago.Trim().ToUpperInvariant();
        return ep == "PAGADO" ? "mr-badge-pago--pagado" : "mr-badge-pago--pendiente";
    }

    private static string FormatearMetodoPago(string metodo)
    {
        if (string.IsNullOrWhiteSpace(metodo)) return "Efectivo";
        string m = metodo.Trim().ToUpperInvariant();
        return m switch
        {
            "EFECTIVO" => "Efectivo",
            "TRANSFERENCIA" => "Transferencia",
            "TARJETA" => "Tarjeta",
            "MERCADOPAGO" => "Mercado Pago",
            _ => Capitalizar(metodo)
        };
    }

    private static string Capitalizar(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return string.Empty;
        return char.ToUpper(texto[0]) + texto.Substring(1).ToLower();
    }

