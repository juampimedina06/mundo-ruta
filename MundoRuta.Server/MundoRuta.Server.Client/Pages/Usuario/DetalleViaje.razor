@page "/usuario/viajes/{ViajeId:int}"
@inject NavigationManager Navegacion

@code {
    [Parameter]
    public int ViajeId { get; set; }

    protected override void OnInitialized()
    {
        string query = new Uri(Navegacion.Uri).Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            Navegacion.NavigateTo($"/viajes/{ViajeId}", replace: true);
        }
        else
        {
            Navegacion.NavigateTo($"/viajes/{ViajeId}{query}", replace: true);
        }
    }
}
