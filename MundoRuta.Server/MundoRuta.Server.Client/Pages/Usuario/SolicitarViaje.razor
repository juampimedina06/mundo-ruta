@page "/usuario/solicitar"

<PageTitle>Solicitar viaje | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Usuario">
    <div class="mr-page">
        <div class="mr-container">
            <PageHeader Titulo="Solicitar viaje"
                        Descripcion="Indicá origen, destino y tipo de servicio." />

            <EmptyState Titulo="Formulario en preparación"
                        Descripcion="Acá vas a poder cargar origen, destino, fecha, tipo de servicio, equipaje y método de pago.">
                <a class="btn btn-outline-primary" href="/usuario">Volver al panel</a>
            </EmptyState>
        </div>
    </div>
</RoleGuard>
