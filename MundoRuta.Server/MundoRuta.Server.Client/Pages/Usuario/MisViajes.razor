@page "/usuario/viajes"
@inject NavigationManager Navegacion

@code {
    protected override void OnInitialized()
    {
        string query = new Uri(Navegacion.Uri).Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            Navegacion.NavigateTo("/viajes", replace: true);
        }
        else
        {
            Navegacion.NavigateTo($"/viajes{query}", replace: true);
        }
    }
}
