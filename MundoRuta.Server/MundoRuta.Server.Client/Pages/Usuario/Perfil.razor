@page "/usuario/perfil"

<PageTitle>Mi perfil | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Usuario">
    <div class="mr-page">
        <div class="mr-container">
            <PageHeader Titulo="Mi perfil"
                        Descripcion="Tus datos personales y de contacto." />

            <EmptyState Titulo="Edición de perfil en preparación"
                        Descripcion="Acá vas a poder actualizar nombre, email y teléfono.">
                <a class="btn btn-outline-primary" href="/usuario">Volver al panel</a>
            </EmptyState>
        </div>
    </div>
</RoleGuard>
