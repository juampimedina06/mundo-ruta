@page "/usuario/perfil"
@using System.Text.Json
@using System.Globalization
@using MundoRuta.Shared.DTO
@inject SesionEstado Sesion
@inject IUsuarioServicio UsuarioServicio
@implements IDisposable

<PageTitle>Mi Perfil | Mundo Ruta</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<RoleGuard Permitidos="Roles.Usuario">
    <div class="perfil-page">
        <div class="perfil-container">

            <!-- Migas de pan -->
            <nav class="perfil-breadcrumbs" aria-label="Breadcrumb">
                <a href="/usuario" class="perfil-breadcrumbs__link">Inicio</a>
                <svg class="perfil-breadcrumbs__sep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span class="perfil-breadcrumbs__current">Configuración de Usuario</span>
            </nav>

            <!-- Encabezado de Sección -->
            <div class="perfil-header">
                <div>
                    <h1 class="perfil-header__title">Mi Perfil</h1>
                    <p class="perfil-header__subtitle">Gestiona tu identidad, datos de contacto para fletes y estado de verificación.</p>
                </div>
                <div class="perfil-header__badge">
                    <svg class="perfil-header__badge-icon" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Rol: @ObtenerRolDisplay()</span>
                </div>
            </div>

            @if (_cargando)
            {
                <div class="perfil-card">
                    <div class="perfil-card__banner"></div>
                    <div class="perfil-loading">
                        <div class="perfil-loading__spinner"></div>
                        <p>Cargando tu perfil...</p>
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_errorCarga))
            {
                <div class="perfil-card">
                    <div class="perfil-card__banner"></div>
                    <div class="perfil-alert perfil-alert--error">
                        <svg class="perfil-alert__icon" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                        <span>@_errorCarga</span>
                    </div>
                    <a class="btn-perfil btn-perfil--editar" href="/usuario">Volver al panel</a>
                </div>
            }
            else if (_perfil is not null)
            {
                @if (!string.IsNullOrWhiteSpace(_exito))
                {
                    <div class="perfil-alert perfil-alert--exito" role="alert">
                        <svg class="perfil-alert__icon" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                        <span>@_exito</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="perfil-alert perfil-alert--error" role="alert">
                        <svg class="perfil-alert__icon" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                        <span>@_error</span>
                    </div>
                }

                <!-- Tarjeta Principal de Perfil -->
                <div class="perfil-card">
                    <!-- Banner superior decorativo -->
                    <div class="perfil-card__banner"></div>

                    <!-- Encabezado de Tarjeta con Datos y Badges -->
                    <div class="perfil-card__header">
                        <h2 class="perfil-card__name">@ObtenerNombreDisplay()</h2>
                        <p class="perfil-card__id">
                            ID Cliente: <span class="perfil-card__id-mono">MR-@(Sesion.Id > 0 ? $"{Sesion.Id:D4}-AR" : "8409-AR")</span> • Miembro desde @ObtenerFechaMiembro()
                        </p>

                        <div class="perfil-card__chips">
                            <div class="perfil-chip">
                                <svg class="perfil-chip__icon-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <span>Buenos Aires, Argentina</span>
                            </div>

                            <div class="perfil-chip">
                                <svg class="perfil-chip__icon-amber" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                                <span class="perfil-chip__rating">4.9 / 5.0</span>
                                <span class="perfil-chip__rating-sub">• Calificación</span>
                            </div>
                        </div>
                    </div>

                    <!-- Formulario de Perfil -->
                    <EditForm Model="_modelo" OnSubmit="GuardarAsync" class="perfil-form">
                        <div class="perfil-form__grid">
                            <!-- Campo: Nombre Completo -->
                            <div class="perfil-field">
                                <label class="perfil-field__label" for="input-name">
                                    Nombre Completo <span class="perfil-field__required">*</span>
                                </label>
                                <div class="perfil-input-wrap">
                                    <div class="perfil-input-icon">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                        </svg>
                                    </div>
                                    <input id="input-name"
                                           type="text"
                                           class="@($"perfil-input {(_editando ? "perfil-input--active" : "perfil-input--disabled")}")"
                                           disabled="@(!_editando)"
                                           autocomplete="name"
                                           placeholder="Ingresa tu nombre y apellido"
                                           value="@_modelo.NombreCompleto"
                                           @oninput="e => _modelo.NombreCompleto = e.Value?.ToString() ?? string.Empty" />
                                </div>
                                <p class="perfil-field__helper">Visible para los prestadores de transporte durante tus viajes.</p>
                            </div>

                            <!-- Campo: Teléfono -->
                            <div class="perfil-field">
                                <label class="perfil-field__label" for="input-phone">
                                    Teléfono de Contacto <span class="perfil-field__required">*</span>
                                </label>
                                <div class="perfil-input-wrap">
                                    <div class="perfil-input-icon">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                        </svg>
                                    </div>
                                    <input id="input-phone"
                                           type="tel"
                                           class="@($"perfil-input {(_editando ? "perfil-input--active" : "perfil-input--disabled")}")"
                                           disabled="@(!_editando)"
                                           autocomplete="tel"
                                           placeholder="+54 9 11 0000-0000"
                                           value="@_modelo.Telefono"
                                           @oninput="e => _modelo.Telefono = e.Value?.ToString() ?? string.Empty" />
                                </div>
                                <p class="perfil-field__helper">Utilizado para avisos logísticos por WhatsApp y SMS.</p>
                            </div>
                        </div>

                        <!-- Campos Complementarios (Solo Lectura) -->
                        <div class="perfil-form__grid perfil-form__grid--secondary">
                            <!-- Campo: Correo Electrónico Registrado -->
                            <div class="perfil-field">
                                <span class="perfil-field__label perfil-field__label--muted">Correo Electrónico (Registrado)</span>
                                <div class="perfil-static-box">
                                    <svg class="perfil-static-box__icon-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                    <span class="perfil-static-box__value">@_modelo.Email</span>
                                    <span class="perfil-badge-verified">@ObtenerEstadoBadge()</span>
                                </div>
                            </div>

                            <!-- Campo: Tipo de Usuario -->
                            <div class="perfil-field">
                                <span class="perfil-field__label perfil-field__label--muted">Tipo de Usuario</span>
                                <div class="perfil-static-box">
                                    <svg class="perfil-static-box__icon-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                    </svg>
                                    <span class="perfil-static-box__value">Usuario Particular &amp; Remitente B2C</span>
                                </div>
                            </div>
                        </div>

                        <!-- Barra de Acciones y CTA -->
                        <div class="perfil-form__actions">
                            <div class="perfil-form__hint">
                                @if (_editando)
                                {
                                    <svg class="perfil-hint-icon perfil-hint-icon--warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                    </svg>
                                    <span>Editando campos obligatorios. Presiona "Guardar Cambios" para confirmar.</span>
                                }
                                else
                                {
                                    <svg class="perfil-hint-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span>Presiona "Editar Perfil" para desbloquear y modificar tus datos.</span>
                                }
                            </div>

                            <div class="perfil-form__buttons">
                                @if (_editando)
                                {
                                    <button type="button"
                                            class="btn-perfil btn-perfil--cancelar"
                                            @onclick="CancelarEdicion"
                                            disabled="@_guardando">
                                        Cancelar
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn-perfil btn-perfil--editar"
                                            @onclick="IniciarEdicion">
                                        <svg class="btn-perfil__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                        </svg>
                                        <span>Editar Perfil</span>
                                    </button>
                                }

                                <button type="submit"
                                        class="btn-perfil btn-perfil--guardar"
                                        disabled="@(!_editando || _guardando)">
                                    @if (_guardando)
                                    {
                                        <svg class="btn-perfil__spinner" viewBox="0 0 24 24" fill="none">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                        </svg>
                                        <span>Guardando...</span>
                                    }
                                    else
                                    {
                                        <svg class="btn-perfil__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                        <span>Guardar Cambios</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            }
        </div>
    </div>
</RoleGuard>

@code {
    private PerfilModelo _modelo = new PerfilModelo();
    private UsuarioDTO? _perfil;
    private bool _cargando = true;
    private bool _cargaIniciada;
    private bool _guardando;
    private bool _editando;
    private string _originalNombreCompleto = string.Empty;
    private string _originalTelefono = string.Empty;
    private string? _error;
    private string? _errorCarga;
    private string? _exito;

    protected override void OnInitialized()
    {
        Sesion.CambioSesion += AlCambiarSesion;
        IntentarCargar();
    }

    private void AlCambiarSesion()
    {
        _ = InvokeAsync(() =>
        {
            IntentarCargar();
            StateHasChanged();
        });
    }

    private void IntentarCargar()
    {
        if (_cargaIniciada || !Sesion.Restaurada || !Sesion.EstaLogueado)
        {
            return;
        }

        _cargaIniciada = true;
        _ = CargarAsync();
    }

    private async Task CargarAsync()
    {
        HttpResp<UsuarioDTO> respuesta = await UsuarioServicio.ObtenerPorIdAsync(Sesion.Id);

        if (respuesta.Error)
        {
            string mensaje = await respuesta.ObtenerMensajeAsync("No pudimos cargar tu perfil.");
            _errorCarga = ExtraerMensaje(mensaje);
        }
        else if (respuesta.Respuesta is null)
        {
            _errorCarga = "No pudimos cargar tu perfil.";
        }
        else
        {
            _perfil = respuesta.Respuesta;
            string nombreCompleto = $"{_perfil.Nombre} {_perfil.Apellido}".Trim();
            if (string.IsNullOrWhiteSpace(nombreCompleto))
            {
                nombreCompleto = Sesion.Nombre ?? string.Empty;
            }

            _modelo = new PerfilModelo
            {
                NombreCompleto = nombreCompleto,
                Email = _perfil.Email ?? string.Empty,
                Telefono = _perfil.Telefono ?? string.Empty
            };

            _originalNombreCompleto = _modelo.NombreCompleto;
            _originalTelefono = _modelo.Telefono;
        }

        _cargando = false;
        await InvokeAsync(StateHasChanged);
    }

    private void IniciarEdicion()
    {
        _originalNombreCompleto = _modelo.NombreCompleto;
        _originalTelefono = _modelo.Telefono;
        _error = null;
        _exito = null;
        _editando = true;
    }

    private void CancelarEdicion()
    {
        _modelo.NombreCompleto = _originalNombreCompleto;
        _modelo.Telefono = _originalTelefono;
        _error = null;
        _editando = false;
    }

    private async Task GuardarAsync()
    {
        if (!_editando || _guardando)
        {
            return;
        }

        _error = null;
        _exito = null;

        if (string.IsNullOrWhiteSpace(_modelo.NombreCompleto)
            || string.IsNullOrWhiteSpace(_modelo.Telefono))
        {
            _error = "Completá todos los campos obligatorios.";
            return;
        }

        string[] partes = _modelo.NombreCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        string nombre;
        string apellido;
        if (partes.Length <= 1)
        {
            nombre = partes.Length == 1 ? partes[0] : string.Empty;
            apellido = !string.IsNullOrWhiteSpace(_perfil?.Apellido) ? _perfil.Apellido : string.Empty;
        }
        else
        {
            nombre = string.Join(" ", partes.Take(partes.Length - 1));
            apellido = partes.Last();
        }

        UpdateUserRequestDto dto = new UpdateUserRequestDto
        {
            Nombre = nombre,
            Apellido = apellido,
            Email = _modelo.Email.Trim(),
            Telefono = _modelo.Telefono.Trim(),
            // El GET no devuelve la contraseña: se envía vacío y el server la conserva.
            Password = string.Empty,
            RazonSocial = _perfil?.RazonSocial ?? string.Empty,
            Cuit = _perfil?.Cuit ?? string.Empty
        };

        _guardando = true;

        HttpResp<object> respuesta = await UsuarioServicio.ActualizarAsync(Sesion.Id, dto);

        if (respuesta.Error)
        {
            string mensaje = await respuesta.ObtenerMensajeAsync("No pudimos guardar los cambios.");
            _error = ExtraerMensaje(mensaje);
        }
        else
        {
            _exito = "Perfil actualizado correctamente.";
            _perfil!.Nombre = dto.Nombre;
            _perfil.Apellido = dto.Apellido;
            _perfil.Telefono = dto.Telefono;
            _originalNombreCompleto = _modelo.NombreCompleto;
            _originalTelefono = _modelo.Telefono;
            _editando = false;

            // Refresca el nombre que muestra el navbar.
            Sesion.Iniciar(Sesion.Id, dto.Nombre, Sesion.Rol ?? string.Empty);

            // Auto-ocultar alerta de éxito tras 5 segundos
            _ = Task.Run(async () =>
            {
                await Task.Delay(5000);
                _exito = null;
                await InvokeAsync(StateHasChanged);
            });
        }

        _guardando = false;
        await InvokeAsync(StateHasChanged);
    }

    private string ObtenerNombreDisplay()
    {
        if (!string.IsNullOrWhiteSpace(_modelo.NombreCompleto))
        {
            return _modelo.NombreCompleto;
        }

        if (_perfil is not null)
        {
            string nombre = $"{_perfil.Nombre} {_perfil.Apellido}".Trim();
            if (!string.IsNullOrWhiteSpace(nombre))
            {
                return nombre;
            }
        }

        return !string.IsNullOrWhiteSpace(Sesion.Nombre) ? Sesion.Nombre : "Usuario";
    }

    private string ObtenerFechaMiembro()
    {
        if (_perfil?.FechaRegistro is not null && _perfil.FechaRegistro != default)
        {
            try
            {
                CultureInfo cultura = new CultureInfo("es-AR");
                string mes = cultura.DateTimeFormat.GetMonthName(_perfil.FechaRegistro.Month);
                mes = char.ToUpper(mes[0]) + mes[1..];
                return $"{mes} {_perfil.FechaRegistro.Year}";
            }
            catch
            {
                return _perfil.FechaRegistro.ToString("MM/yyyy");
            }
        }

        return "Octubre 2023";
    }

    private string ObtenerRolDisplay()
    {
        if (Sesion.Rol == Roles.Usuario)
        {
            return "Pasajero / Remitente";
        }

        return !string.IsNullOrWhiteSpace(Sesion.Rol) ? Sesion.Rol : "Pasajero / Remitente";
    }

    private string ObtenerEstadoBadge()
    {
        if (!string.IsNullOrWhiteSpace(_perfil?.Estado))
        {
            if (_perfil.Estado.Equals("Inactivo", StringComparison.OrdinalIgnoreCase))
            {
                return "INACTIVO";
            }
            return _perfil.Estado.ToUpper();
        }

        return "VERIFICADO";
    }

    private static string ExtraerMensaje(string contenido)
    {
        try
        {
            using JsonDocument documento = JsonDocument.Parse(contenido);

            if (documento.RootElement.ValueKind == JsonValueKind.Object
                && documento.RootElement.TryGetProperty("mensaje", out JsonElement mensaje))
            {
                string texto = mensaje.GetString() ?? string.Empty;

                if (!string.IsNullOrWhiteSpace(texto))
                {
                    return texto;
                }
            }
        }
        catch (JsonException)
        {
            // No es JSON: se muestra tal cual.
        }

        return contenido;
    }

    public void Dispose()
    {
        Sesion.CambioSesion -= AlCambiarSesion;
    }

    private sealed class PerfilModelo
    {
        public string NombreCompleto { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
    }
}
