@page "/usuario"
@using System.Globalization
@using MundoRuta.Shared
@using MundoRuta.Shared.DTO
@inject IHttpServices Http
@inject SesionEstado Sesion
@inject NavigationManager Navegacion
@implements IDisposable

<PageTitle>Inicio | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Usuario">
    <div class="mr-u-home">
        <div class="mr-u-container">
            <!-- Top Operational Context Strip -->
            <div class="mr-u-topbar">
                <div class="mr-u-topbar__left">
                    <span class="mr-u-context-pill">
                        <span class="mr-u-context-pill__dot"></span>
                        <span>PANEL DE PASAJERO • SESIÓN ACTIVA</span>
                    </span>
                </div>
            </div>

            <!-- Hero Section with Personalized Greeting -->
            <section class="mr-u-hero">
                <div class="mr-u-hero__glow-top"></div>
                <div class="mr-u-hero__glow-bottom"></div>

                <div class="mr-u-hero__content">
                    <div class="mr-u-hero__copy">
                        <div class="mr-u-hero__badge">
                            <span class="material-symbols-outlined mr-u-icon-16">local_shipping</span>
                            <span>Solicitudes de Fletes y Mudanzas • Subasta de hasta 5 ofertas</span>
                        </div>

                        <h1 class="mr-u-hero__title">
                            Hola, @ObtenerNombreSaludo() 👋 <br />
                            <span class="mr-u-hero__title-accent">¿Qué necesitas transportar hoy?</span>
                        </h1>

                        <p class="mr-u-hero__desc">
                            Publicá tu solicitud de viaje o flete, compará las ofertas y contraofertas de prestadores aprobados y seguí el estado de tu envío hasta validar la entrega con DNI.
                        </p>

                        <div class="mr-u-hero__actions">
                            <a class="mr-u-btn-primary" href="/usuario/solicitar">
                                <span class="material-symbols-outlined mr-u-icon-18">local_shipping</span>
                                <span>Solicitar viaje</span>
                                <span class="material-symbols-outlined mr-u-icon-18">arrow_forward</span>
                            </a>
                            <a class="mr-u-btn-secondary" href="/prestadores">
                                <span class="material-symbols-outlined mr-u-icon-18 mr-u-text-mint">verified_user</span>
                                <span>Ver prestadores</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Live Operation Alert + User Metrics Strip -->
            <section class="mr-u-mid-grid">
                <!-- Active Shipment Telemetry Card (8 Cols) -->
                <div class="mr-u-telemetry-card">
                    @if (_viajeActivo is not null)
                    {
                        <div>
                            <div class="mr-u-telemetry-card__header">
                                <div class="mr-u-telemetry-card__header-left">
                                    <span class="mr-u-live-pill">
                                        <span class="mr-u-live-pill__dot"></span>
                                        <span>@FormatearEstadoActivo(_viajeActivo.Estado)</span>
                                    </span>
                                    <span class="mr-u-shipment-id">
                                        Viaje #MR-@_viajeActivo.Id
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(_viajeActivo.DetalleCarga))
                                    {
                                        <span class="mr-u-shipment-meta">
                                            • @_viajeActivo.DetalleCarga
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_viajeActivo.DniReceptor))
                                    {
                                        <span class="mr-u-driver-box__cnrt">
                                            DNI Receptor: @_viajeActivo.DniReceptor
                                        </span>
                                    }
                                </div>

                                <div class="mr-u-telemetry-card__eta">
                                    <span class="mr-u-telemetry-card__eta-label">Horario Programado</span>
                                    <p class="mr-u-telemetry-card__eta-val">
                                        @_viajeActivo.Fecha.ToString("dd/MM/yyyy") • @FormatearHora(_viajeActivo.Hora)
                                    </p>
                                </div>
                            </div>

                            <!-- Telemetry Progress Track -->
                            <div class="mr-u-progress-wrap">
                                <div class="mr-u-progress-bar">
                                    <div class="mr-u-progress-bar__fill" style="width: @(ObtenerPorcentajeProgreso())%;"></div>
                                </div>
                                <div class="mr-u-progress-labels">
                                    <span class="mr-u-progress-stop">
                                        <span class="mr-u-progress-dot mr-u-progress-dot--active"></span>
                                        <span>@_viajeActivo.Origen</span>
                                    </span>
                                    <span class="mr-u-progress-mid">
                                        @FormatearMonto(_viajeActivo.Monto > 0 ? _viajeActivo.Monto : _viajeActivo.MontoEstimado)
                                    </span>
                                    <span class="mr-u-progress-stop">
                                        <span>@_viajeActivo.Destino</span>
                                        <span class="mr-u-progress-dot mr-u-progress-dot--end"></span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Driver and Vehicle Pill -->
                        <div class="mr-u-driver-box">
                            <div class="mr-u-driver-box__left">
                                <div class="mr-u-kpi-card__icon" style="width: 44px; height: 44px; border-radius: 12px;">
                                    <span class="material-symbols-outlined mr-u-icon-22">local_shipping</span>
                                </div>
                                <div>
                                    <div class="mr-u-driver-box__name-row">
                                        <span class="mr-u-driver-box__name">
                                            @(!string.IsNullOrWhiteSpace(_viajeActivo.NombreChofer)
                                                ? $"Chofer: {_viajeActivo.NombreChofer}"
                                                : (!string.IsNullOrWhiteSpace(_viajeActivo.NombrePrestador) ? $"Prestador: {_viajeActivo.NombrePrestador}" : "Esperando postulaciones de prestadores"))
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(_viajeActivo.NombrePrestador))
                                        {
                                            <span class="mr-u-driver-box__cnrt">@_viajeActivo.NombrePrestador</span>
                                        }
                                    </div>
                                    <p class="mr-u-driver-box__vehicle">
                                        @if (!string.IsNullOrWhiteSpace(_viajeActivo.Patente))
                                        {
                                            @($"{_viajeActivo.Marca} • Patente {_viajeActivo.Patente}")
                                        }
                                        else
                                        {
                                            <text>Todavía sin unidad asignada (en etapa de selección de oferta)</text>
                                        }
                                    </p>
                                </div>
                            </div>

                            <div class="mr-u-driver-box__actions">
                                <a class="mr-u-btn-gps" href="@ObtenerUrlSeguimiento()">
                                    <span class="material-symbols-outlined mr-u-icon-18 mr-u-text-mint">visibility</span>
                                    <span>@(EstadosViaje.Normalizar(_viajeActivo.Estado) is "buscando" or "contraofertado" ? "Ver Propuestas" : "Ver Seguimiento")</span>
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column justify-content-between h-100 gap-3">
                            <div class="mr-u-telemetry-card__header">
                                <div class="mr-u-telemetry-card__header-left">
                                    <span class="mr-u-live-pill" style="background: #f1f5f9; color: #475569;">
                                        <span>SIN VIAJES ACTIVOS</span>
                                    </span>
                                    <span class="mr-u-shipment-id">No tenés envíos en curso en este momento</span>
                                </div>
                            </div>
                            <p class="text-muted mb-0" style="font-size: 0.92rem;">
                                Cuando publiques una solicitud de flete o tengas un viaje asignado, vas a poder consultar acá mismo su estado, el chofer, el vehículo y el DNI del receptor.
                            </p>
                            <div class="mr-u-driver-box">
                                <div class="mr-u-driver-box__left">
                                    <div class="mr-u-kpi-card__icon">
                                        <span class="material-symbols-outlined mr-u-icon-22">add_road</span>
                                    </div>
                                    <div>
                                        <span class="mr-u-driver-box__name">¿Necesitás programar un nuevo traslado?</span>
                                        <p class="mr-u-driver-box__vehicle">Publicá origen, destino y carga para recibir ofertas.</p>
                                    </div>
                                </div>
                                <div class="mr-u-driver-box__actions">
                                    <a class="mr-u-btn-gps" href="/usuario/solicitar">
                                        <span class="material-symbols-outlined mr-u-icon-18 mr-u-text-mint">add</span>
                                        <span>Solicitar Viaje</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- User Snapshot KPIs (4 Cols) -->
                <div class="mr-u-kpis">
                    <!-- Metric 1: Total Viajes -->
                    <div class="mr-u-kpi-card">
                        <div class="mr-u-kpi-card__left">
                            <div class="mr-u-kpi-card__icon">
                                <span class="material-symbols-outlined mr-u-icon-22">local_shipping</span>
                            </div>
                            <div>
                                <p class="mr-u-kpi-card__label">Total de Viajes Solicitados</p>
                                <p class="mr-u-kpi-card__val">@_todosLosViajes.Count @(_todosLosViajes.Count == 1 ? "Viaje" : "Viajes")</p>
                            </div>
                        </div>
                        <span class="mr-u-kpi-card__delta">@ViajesCompletadosCount finalizados</span>
                    </div>

                    <!-- Metric 2: En Curso / En Subasta -->
                    <div class="mr-u-kpi-card">
                        <div class="mr-u-kpi-card__left">
                            <div class="mr-u-kpi-card__icon">
                                <span class="material-symbols-outlined mr-u-icon-22">pending_actions</span>
                            </div>
                            <div>
                                <p class="mr-u-kpi-card__label">Viajes en Curso / Subasta</p>
                                <div class="mr-u-kpi-card__rep-row">
                                    <span class="mr-u-kpi-card__val">@ViajesActivosCount @((ViajesActivosCount == 1) ? "Activo" : "Activos")</span>
                                    <span class="mr-u-kpi-card__tier">(@ViajesCanceladosCount cancelados)</span>
                                </div>
                            </div>
                        </div>
                        <span class="material-symbols-outlined mr-u-kpi-card__verified">verified</span>
                    </div>
                </div>
            </section>

            <!-- Recent Shipments Section -->
            <section class="mr-u-history">
                <div class="mr-u-history__header">
                    <div>
                        <h2 class="mr-u-history__title">Últimos Viajes Solicitados</h2>
                        <p class="mr-u-history__subtitle">
                            Consultá el estado de tus solicitudes recientes, el DNI del receptor y el detalle de cada operación.
                        </p>
                    </div>
                    <div class="mr-u-history__actions">
                        <a class="mr-u-btn-tool" href="/usuario/viajes">
                            <span class="material-symbols-outlined mr-u-icon-18">list_alt</span>
                            <span>Ver todos mis viajes</span>
                        </a>
                    </div>
                </div>

                <!-- Logistics Grid Table Container -->
                <div class="mr-u-table-card">
                    <div class="mr-u-table-scroll">
                        <table class="mr-u-table">
                            <thead>
                                <tr>
                                    <th>ID de Viaje</th>
                                    <th>Ruta (Origen → Destino)</th>
                                    <th>DNI Receptor / Pago</th>
                                    <th>Fecha y Hora</th>
                                    <th class="mr-u-text-right">Monto</th>
                                    <th>Estado</th>
                                    <th class="mr-u-text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_todosLosViajes.Count > 0)
                                {
                                    @foreach (ListadoViajeDTO viaje in _todosLosViajes.OrderByDescending(v => v.Fecha).ThenByDescending(v => v.Id).Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <span class="mr-u-cell-id">#MR-@viaje.Id</span>
                                                <span class="mr-u-cell-sub">@FormatearTipoSolicitud(viaje.TipoSolicitud)</span>
                                            </td>
                                            <td>
                                                <div class="mr-u-route-line">
                                                    <span class="mr-u-route-node">@viaje.Origen</span>
                                                    <span class="material-symbols-outlined mr-u-route-arrow">arrow_right_alt</span>
                                                    <span class="mr-u-route-node">@viaje.Destino</span>
                                                </div>
                                                <span class="mr-u-cell-sub">@(viaje.EquipajeCarga ? "Con equipaje / carga declarada" : "Traslado estándar")</span>
                                            </td>
                                            <td>
                                                <div class="mr-u-cell-main">DNI: @(string.IsNullOrWhiteSpace(viaje.DniReceptor) ? "—" : viaje.DniReceptor)</div>
                                                <div class="mr-u-cell-sub">@(string.IsNullOrWhiteSpace(viaje.MetodoDePago) ? "Efectivo" : viaje.MetodoDePago) (@(string.IsNullOrWhiteSpace(viaje.EstadoPago) ? "PENDIENTE" : viaje.EstadoPago))</div>
                                            </td>
                                            <td class="mr-u-cell-date">
                                                @FormatearFechaTabla(viaje.Fecha, viaje.Hora)
                                            </td>
                                            <td class="mr-u-text-right mr-u-cell-price">
                                                @FormatearMonto(viaje.Monto > 0 ? viaje.Monto : viaje.MontoEstimado)
                                            </td>
                                            <td>
                                                <span class="mr-u-status-pill">
                                                    <span class="mr-u-status-pill__dot"></span>
                                                    <span>@FormatearEstadoTabla(viaje.Estado)</span>
                                                </span>
                                            </td>
                                            <td class="mr-u-text-center">
                                                <a class="mr-u-btn-reorder" href="@ObtenerUrlViaje(viaje)">
                                                    <span class="material-symbols-outlined mr-u-icon-16">visibility</span>
                                                    <span>Ver Detalle</span>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            Todavía no registraste solicitudes de viaje en tu cuenta. Podés crear la primera desde <strong>Solicitar viaje</strong>.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mr-u-table-footer">
                        <span>
                            Mostrando @(Math.Min(5, _todosLosViajes.Count)) de @_todosLosViajes.Count @(_todosLosViajes.Count == 1 ? "viaje registrado" : "viajes registrados") en tu cuenta
                        </span>
                        <a class="mr-u-table-footer__link" href="/usuario/viajes">
                            <span>Ir a Mis Viajes</span>
                            <span class="material-symbols-outlined mr-u-icon-16">chevron_right</span>
                        </a>
                    </div>
                </div>
            </section>
        </div>
    </div>
</RoleGuard>

@code {
    private List<ListadoViajeDTO> _todosLosViajes = new List<ListadoViajeDTO>();
    private ViajeDetalladoDTO? _viajeActivo;

    private int ViajesCompletadosCount => _todosLosViajes.Count(v => string.Equals(EstadosViaje.Normalizar(v.Estado), "finalizado", StringComparison.OrdinalIgnoreCase));
    private int ViajesCanceladosCount => _todosLosViajes.Count(v =>
    {
        string n = EstadosViaje.Normalizar(v.Estado);
        return n == "cancelado" || n == "rechazado";
    });
    private int ViajesActivosCount => _todosLosViajes.Count - ViajesCompletadosCount - ViajesCanceladosCount;

    private static string ObtenerUrlViaje(ListadoViajeDTO viaje)
    {
        string estadoNorm = EstadosViaje.Normalizar(viaje.Estado);
        if (estadoNorm == "buscando" || estadoNorm == "contraofertado")
        {
            return $"/viajes/{viaje.Id}/propuestas";
        }
        return $"/viajes/{viaje.Id}";
    }

    protected override void OnInitialized()
    {
        Sesion.CambioSesion += AlCambiarSesion;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Sesion.Restaurada && Sesion.EstaLogueado)
        {
            await CargarDatosAsync();
        }
    }

    public void Dispose()
    {
        Sesion.CambioSesion -= AlCambiarSesion;
    }

    private void AlCambiarSesion()
    {
        _ = InvokeAsync(async () =>
        {
            if (Sesion.Restaurada && Sesion.EstaLogueado)
            {
                await CargarDatosAsync();
            }
            StateHasChanged();
        });
    }

    private async Task CargarDatosAsync()
    {
        if (!Sesion.EstaLogueado || Sesion.Id <= 0)
        {
            return;
        }

        string url = $"api/pasajero/{Sesion.Id}/viajes?estado=";
        HttpResp<List<ListadoViajeDTO>> respuesta = await Http.GetAsync<List<ListadoViajeDTO>>(url);

        if (!respuesta.Error && respuesta.Respuesta is not null)
        {
            _todosLosViajes = respuesta.Respuesta;

            ListadoViajeDTO? activo = _todosLosViajes
                .OrderByDescending(v => v.Id)
                .FirstOrDefault(v =>
                    !string.Equals(v.Estado, EstadosViaje.Finalizado, StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(v.Estado, EstadosViaje.Cancelado, StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(v.Estado, EstadosViaje.Rechazado, StringComparison.OrdinalIgnoreCase));

            if (activo is not null)
            {
                HttpResp<ViajeDetalladoDTO> detalleResp = await Http.GetAsync<ViajeDetalladoDTO>($"api/pasajero/{Sesion.Id}/viajes/{activo.Id}");
                if (!detalleResp.Error && detalleResp.Respuesta is not null)
                {
                    _viajeActivo = detalleResp.Respuesta;
                }
            }
        }
    }

    private string ObtenerNombreSaludo()
    {
        if (string.IsNullOrWhiteSpace(Sesion.Nombre))
        {
            return "Martín";
        }

        string[] partes = Sesion.Nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length > 0 ? partes[0] : Sesion.Nombre.Trim();
    }

    private string ObtenerUrlSeguimiento()
    {
        if (_viajeActivo is not null)
        {
            string estadoNorm = EstadosViaje.Normalizar(_viajeActivo.Estado);
            if (estadoNorm == "buscando" || estadoNorm == "contraofertado")
            {
                return $"/viajes/{_viajeActivo.Id}/propuestas";
            }

            return $"/viajes/{_viajeActivo.Id}";
        }

        return "/usuario/viajes";
    }

    private int ObtenerPorcentajeProgreso()
    {
        if (_viajeActivo is null)
        {
            return 75;
        }

        string estado = EstadosViaje.Normalizar(_viajeActivo.Estado);
        return estado switch
        {
            "buscando" or "contraofertado" => 25,
            "asignado" => 45,
            "carga-subida" => 65,
            "en-transito" => 80,
            "llegada-destino" => 95,
            _ => 75
        };
    }

    private static string FormatearEstadoActivo(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "EN TRÁNSITO ACTIVO";
        }

        string norm = EstadosViaje.Normalizar(estado);
        return norm switch
        {
            "buscando" => "BUSCANDO PRESTADOR",
            "contraofertado" => "OFERTAS RECIBIDAS",
            "asignado" => "CONDUCTOR ASIGNADO",
            "carga-subida" => "CARGA EN UNIDAD",
            "en-transito" => "EN TRÁNSITO ACTIVO",
            "llegada-destino" => "EN PUNTO DE ENTREGA",
            _ => "EN TRÁNSITO ACTIVO"
        };
    }

    private static string FormatearEstadoTabla(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "En Curso";
        }

        string norm = EstadosViaje.Normalizar(estado);
        return norm switch
        {
            "finalizado" => "Completado",
            "cancelado" => "Cancelado",
            "rechazado" => "Rechazado",
            "buscando" => "Buscando",
            "contraofertado" => "Con Ofertas",
            "asignado" => "Confirmado",
            _ => "En Tránsito"
        };
    }

    private static string FormatearTipoSolicitud(string tipo)
    {
        if (string.IsNullOrWhiteSpace(tipo))
        {
            return "Flete Express";
        }

        if (tipo.Contains("carga", StringComparison.OrdinalIgnoreCase))
        {
            return "Flete & Carga";
        }

        return tipo;
    }

    private static string FormatearFechaTabla(DateTime fecha, TimeSpan hora)
    {
        if (fecha == default)
        {
            return "-";
        }

        return $"{fecha:dd/MM/yyyy} • {hora:hh\\:mm}";
    }

    private static string FormatearHora(TimeSpan hora)
    {
        return $"{hora:hh\\:mm} hrs";
    }

    private static string FormatearMonto(decimal monto)
    {
        return "$" + monto.ToString("N0", new CultureInfo("es-AR"));
    }
}
