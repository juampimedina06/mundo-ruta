@page "/usuario"
@using System.Globalization
@using MundoRuta.Shared
@using MundoRuta.Shared.DTO
@inject IHttpServices Http
@inject SesionEstado Sesion
@inject NavigationManager Navegacion
@implements IDisposable

<PageTitle>Inicio | Mundo Ruta</PageTitle>

<RoleGuard Permitidos="Roles.Usuario">
    <div class="mr-u-home">
        <div class="mr-u-container">
            <!-- Top Operational Context Strip -->
            <div class="mr-u-topbar">
                <div class="mr-u-topbar__left">
                    <span class="mr-u-context-pill">
                        <span class="mr-u-context-pill__dot"></span>
                        <span>CUENTA CORPORATIVA ACTIVA</span>
                    </span>
                </div>
            </div>

            <!-- Hero Section with Personalized Greeting -->
            <section class="mr-u-hero">
                <div class="mr-u-hero__glow-top"></div>
                <div class="mr-u-hero__glow-bottom"></div>

                <div class="mr-u-hero__content">
                    <div class="mr-u-hero__copy">
                        <div class="mr-u-hero__badge">
                            <span class="material-symbols-outlined mr-u-icon-16">bolt</span>
                            <span>Despacho Inmediato • Tiempo promedio de asignación 3.5 min</span>
                        </div>

                        <h1 class="mr-u-hero__title">
                            Hola, @ObtenerNombreSaludo() 👋 <br />
                            <span class="mr-u-hero__title-accent">¿Qué necesitas transportar hoy?</span>
                        </h1>

                        <p class="mr-u-hero__desc">
                            Gestioná tus envíos corporativos, programá traslados con peones o solicitá una cotización instantánea con tarifa garantizada.
                        </p>

                        <div class="mr-u-hero__actions">
                            <a class="mr-u-btn-primary" href="/usuario/solicitar">
                                <span class="material-symbols-outlined mr-u-icon-18">local_shipping</span>
                                <span>Solicitar viaje</span>
                                <span class="material-symbols-outlined mr-u-icon-18">arrow_forward</span>
                            </a>
                            <a class="mr-u-btn-secondary" href="/prestadores">
                                <span class="material-symbols-outlined mr-u-icon-18 mr-u-text-mint">verified_user</span>
                                <span>Ver prestadores</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Live Operation Alert + User Metrics Strip -->
            <section class="mr-u-mid-grid">
                <!-- Active Shipment Telemetry Card (8 Cols) -->
                <div class="mr-u-telemetry-card">
                    <div>
                        <div class="mr-u-telemetry-card__header">
                            <div class="mr-u-telemetry-card__header-left">
                                <span class="mr-u-live-pill">
                                    <span class="mr-u-live-pill__dot"></span>
                                    <span>@(_viajeActivo is not null ? FormatearEstadoActivo(_viajeActivo.Estado) : "EN TRÁNSITO ACTIVO")</span>
                                </span>
                                <span class="mr-u-shipment-id">
                                    Envío #MR-@(_viajeActivo is not null ? _viajeActivo.Id.ToString(CultureInfo.InvariantCulture) : "8488")
                                </span>
                                <span class="mr-u-shipment-meta">
                                    • @(_viajeActivo is not null && !string.IsNullOrWhiteSpace(_viajeActivo.DetalleCarga) ? _viajeActivo.DetalleCarga : "4 Pallets Estándar (1.200 kg)")
                                </span>
                                @if (_viajeActivo is not null && !string.IsNullOrWhiteSpace(_viajeActivo.DniReceptor))
                                {
                                    <span class="mr-u-driver-box__cnrt">
                                        DNI Receptor: @_viajeActivo.DniReceptor
                                    </span>
                                }
                            </div>

                            <div class="mr-u-telemetry-card__eta">
                                <span class="mr-u-telemetry-card__eta-label">ETA Estimado</span>
                                <p class="mr-u-telemetry-card__eta-val">
                                    @(_viajeActivo is not null ? FormatearHora(_viajeActivo.Hora) : "12 min (14:38 hrs)")
                                </p>
                            </div>
                        </div>

                        <!-- Telemetry Progress Track -->
                        <div class="mr-u-progress-wrap">
                            <div class="mr-u-progress-bar">
                                <div class="mr-u-progress-bar__fill" style="width: @(ObtenerPorcentajeProgreso())%;"></div>
                            </div>
                            <div class="mr-u-progress-labels">
                                <span class="mr-u-progress-stop">
                                    <span class="mr-u-progress-dot mr-u-progress-dot--active"></span>
                                    <span>@(_viajeActivo is not null ? _viajeActivo.Origen : "Terminal Norte (13:10)")</span>
                                </span>
                                <span class="mr-u-progress-mid">
                                    @(_viajeActivo is not null ? "Ruta monitoreada por GPS" : "Km 28.4 / Autopista Central")
                                </span>
                                <span class="mr-u-progress-stop">
                                    <span>@(_viajeActivo is not null ? _viajeActivo.Destino : "Parque Logístico Sur (Destino)")</span>
                                    <span class="mr-u-progress-dot mr-u-progress-dot--end"></span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Driver and Vehicle Pill -->
                    <div class="mr-u-driver-box">
                        <div class="mr-u-driver-box__left">
                            <img class="mr-u-driver-box__avatar"
                                 alt="Conductor asignado"
                                 src="https://lh3.googleusercontent.com/aida-public/AB6AXuCSOUu6NPm_379o5CeOScojDTNGAkA8AfZZ9ty16cW80hruBO3xt3YAvRCGZwREj4jXrG2gosx0GtYZBhWLlvOkFa1tryKwHD_ryp_sHPY3bukkM5-2KUpI2jQE2pUQ81TLNUq1tbaBniZMYoKYea6FRaBVvA6G4RePTwL1yNfIKSBzzDf4Gf9P6h58qzwiAkTxFcgxhvT8dJvZ5T6kOahqtpPu4SR2esVhyvVx" />
                            <div>
                                <div class="mr-u-driver-box__name-row">
                                    <span class="mr-u-driver-box__name">
                                        @(_viajeActivo is not null && !string.IsNullOrWhiteSpace(_viajeActivo.NombreChofer) ? _viajeActivo.NombreChofer : "Esteban Ruiz")
                                    </span>
                                    <span class="mr-u-driver-box__rating">
                                        <span class="material-symbols-outlined mr-u-star-filled">star</span>
                                        <span>4.96</span>
                                    </span>
                                    <span class="mr-u-driver-box__cnrt">Habilitación CNRT OK</span>
                                </div>
                                <p class="mr-u-driver-box__vehicle">
                                    @if (_viajeActivo is not null && !string.IsNullOrWhiteSpace(_viajeActivo.Patente))
                                    {
                                        @($"{_viajeActivo.Marca} • Patente {_viajeActivo.Patente}")
                                    }
                                    else
                                    {
                                        <text>Renault Kangoo Maxi • Patente LK-7921 • Precinto #99214</text>
                                    }
                                </p>
                            </div>
                        </div>

                        <div class="mr-u-driver-box__actions">
                            <a class="mr-u-btn-contact" href="@ObtenerUrlSeguimiento()">
                                <span class="material-symbols-outlined mr-u-icon-18">phone</span>
                                <span>Contactar</span>
                            </a>
                            <a class="mr-u-btn-gps" href="@ObtenerUrlSeguimiento()">
                                <span class="material-symbols-outlined mr-u-icon-18 mr-u-text-mint">my_location</span>
                                <span>Seguimiento GPS en Vivo</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- User Snapshot KPIs (4 Cols) -->
                <div class="mr-u-kpis">
                    <!-- Metric 1 -->
                    <div class="mr-u-kpi-card">
                        <div class="mr-u-kpi-card__left">
                            <div class="mr-u-kpi-card__icon">
                                <span class="material-symbols-outlined mr-u-icon-22">local_shipping</span>
                            </div>
                            <div>
                                <p class="mr-u-kpi-card__label">Despachos este mes</p>
                                <p class="mr-u-kpi-card__val">@(_todosLosViajes.Count > 0 ? $"{_todosLosViajes.Count} Viajes" : "14 Viajes")</p>
                            </div>
                        </div>
                        <span class="mr-u-kpi-card__delta">+22% vs mes ant.</span>
                    </div>

                    <!-- Metric 2 -->
                    <div class="mr-u-kpi-card">
                        <div class="mr-u-kpi-card__left">
                            <div class="mr-u-kpi-card__icon">
                                <span class="material-symbols-outlined mr-u-icon-22 mr-u-star-filled">star</span>
                            </div>
                            <div>
                                <p class="mr-u-kpi-card__label">Tu Reputación Remitente</p>
                                <div class="mr-u-kpi-card__rep-row">
                                    <span class="mr-u-kpi-card__val">4.92 / 5.0</span>
                                    <span class="mr-u-kpi-card__tier">(Nivel Oro)</span>
                                </div>
                            </div>
                        </div>
                        <span class="material-symbols-outlined mr-u-kpi-card__verified">verified</span>
                    </div>
                </div>
            </section>

            <!-- Recent Shipments & One-Click Reorder Section -->
            <section class="mr-u-history">
                <div class="mr-u-history__header">
                    <div>
                        <h2 class="mr-u-history__title">Historial Reciente de Envíos</h2>
                        <p class="mr-u-history__subtitle">
                            Reordená rutas frecuentes con un solo clic o descargá tus remitos y facturas comerciales.
                        </p>
                    </div>
                    <div class="mr-u-history__actions">
                        <a class="mr-u-btn-tool" href="/usuario/viajes">
                            <span class="material-symbols-outlined mr-u-icon-18">tune</span>
                            <span>Filtrar</span>
                        </a>
                        <a class="mr-u-btn-tool" href="/usuario/viajes">
                            <span class="material-symbols-outlined mr-u-icon-18">download</span>
                            <span>Descargar Excel</span>
                        </a>
                    </div>
                </div>

                <!-- Logistics Grid Table Container -->
                <div class="mr-u-table-card">
                    <div class="mr-u-table-scroll">
                        <table class="mr-u-table">
                            <thead>
                                <tr>
                                    <th>ID de Envío</th>
                                    <th>Ruta (Origen → Destino)</th>
                                    <th>Unidad / Chofer</th>
                                    <th>Fecha de Entrega</th>
                                    <th class="mr-u-text-right">Tarifa Abonada</th>
                                    <th>Estado</th>
                                    <th class="mr-u-text-center">Acción Directa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_todosLosViajes.Count > 0)
                                {
                                    @foreach (ListadoViajeDTO viaje in _todosLosViajes.OrderByDescending(v => v.Fecha).ThenByDescending(v => v.Id).Take(3))
                                    {
                                        <tr>
                                            <td>
                                                <span class="mr-u-cell-id">#MR-@viaje.Id</span>
                                                <span class="mr-u-cell-sub">@FormatearTipoSolicitud(viaje.TipoSolicitud)</span>
                                            </td>
                                            <td>
                                                <div class="mr-u-route-line">
                                                    <span class="mr-u-route-node">@viaje.Origen</span>
                                                    <span class="material-symbols-outlined mr-u-route-arrow">arrow_right_alt</span>
                                                    <span class="mr-u-route-node">@viaje.Destino</span>
                                                </div>
                                                <span class="mr-u-cell-sub">@(viaje.EquipajeCarga ? "Servicio con carga verificada" : "Traslado directo")</span>
                                            </td>
                                            <td>
                                                <div class="mr-u-cell-main">Red Homologada</div>
                                                <div class="mr-u-cell-sub">Unidad Asignada CNRT</div>
                                            </td>
                                            <td class="mr-u-cell-date">
                                                @FormatearFechaTabla(viaje.Fecha, viaje.Hora)
                                            </td>
                                            <td class="mr-u-text-right mr-u-cell-price">
                                                @FormatearMonto(viaje.Monto > 0 ? viaje.Monto : viaje.MontoEstimado)
                                            </td>
                                            <td>
                                                <span class="mr-u-status-pill">
                                                    <span class="mr-u-status-pill__dot"></span>
                                                    <span>@FormatearEstadoTabla(viaje.Estado)</span>
                                                </span>
                                            </td>
                                            <td class="mr-u-text-center">
                                                <a class="mr-u-btn-reorder" href="/usuario/solicitar">
                                                    <span class="material-symbols-outlined mr-u-icon-16">replay</span>
                                                    <span>Repetir Viaje</span>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <!-- Row 1 -->
                                    <tr>
                                        <td>
                                            <span class="mr-u-cell-id">#MR-904</span>
                                            <span class="mr-u-cell-sub">Flete Express</span>
                                        </td>
                                        <td>
                                            <div class="mr-u-route-line">
                                                <span class="mr-u-route-node">Terminal Norte</span>
                                                <span class="material-symbols-outlined mr-u-route-arrow">arrow_right_alt</span>
                                                <span class="mr-u-route-node">Parque Industrial Sur</span>
                                            </div>
                                            <span class="mr-u-cell-sub">Distancia: 34.2 km • 800 kg carga seca</span>
                                        </td>
                                        <td>
                                            <div class="mr-u-cell-main">Carlos Méndez</div>
                                            <div class="mr-u-cell-sub">Ford Transit (AB-441-CD)</div>
                                        </td>
                                        <td class="mr-u-cell-date">
                                            18/10/2025 • 11:20
                                        </td>
                                        <td class="mr-u-text-right mr-u-cell-price">
                                            $24.500
                                        </td>
                                        <td>
                                            <span class="mr-u-status-pill">
                                                <span class="mr-u-status-pill__dot"></span>
                                                <span>Completado</span>
                                            </span>
                                        </td>
                                        <td class="mr-u-text-center">
                                            <a class="mr-u-btn-reorder" href="/usuario/solicitar">
                                                <span class="material-symbols-outlined mr-u-icon-16">replay</span>
                                                <span>Repetir Viaje</span>
                                            </a>
                                        </td>
                                    </tr>

                                    <!-- Row 2 -->
                                    <tr>
                                        <td>
                                            <span class="mr-u-cell-id">#MR-871</span>
                                            <span class="mr-u-cell-sub">Paquetería B2B</span>
                                        </td>
                                        <td>
                                            <div class="mr-u-route-line">
                                                <span class="mr-u-route-node">CD Pudahuel (Bodega Central)</span>
                                                <span class="material-symbols-outlined mr-u-route-arrow">arrow_right_alt</span>
                                                <span class="mr-u-route-node">Sede Providencia</span>
                                            </div>
                                            <span class="mr-u-cell-sub">Distancia: 19.8 km • 12 bultos etiquetados</span>
                                        </td>
                                        <td>
                                            <div class="mr-u-cell-main">Ignacio Salgado</div>
                                            <div class="mr-u-cell-sub">Peugeot Partner (GH-109-LM)</div>
                                        </td>
                                        <td class="mr-u-cell-date">
                                            14/10/2025 • 16:45
                                        </td>
                                        <td class="mr-u-text-right mr-u-cell-price">
                                            $18.900
                                        </td>
                                        <td>
                                            <span class="mr-u-status-pill">
                                                <span class="mr-u-status-pill__dot"></span>
                                                <span>Completado</span>
                                            </span>
                                        </td>
                                        <td class="mr-u-text-center">
                                            <a class="mr-u-btn-reorder" href="/usuario/solicitar">
                                                <span class="material-symbols-outlined mr-u-icon-16">replay</span>
                                                <span>Repetir Viaje</span>
                                            </a>
                                        </td>
                                    </tr>

                                    <!-- Row 3 -->
                                    <tr>
                                        <td>
                                            <span class="mr-u-cell-id">#MR-852</span>
                                            <span class="mr-u-cell-sub">Carga Especial</span>
                                        </td>
                                        <td>
                                            <div class="mr-u-route-line">
                                                <span class="mr-u-route-node">Estación Central</span>
                                                <span class="material-symbols-outlined mr-u-route-arrow">arrow_right_alt</span>
                                                <span class="mr-u-route-node">Aeropuerto Internacional SCL</span>
