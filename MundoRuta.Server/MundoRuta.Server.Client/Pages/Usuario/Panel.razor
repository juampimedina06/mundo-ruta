                    <div class="mr-u-table-footer">
                        <span>
                            Mostrando los últimos @(_todosLosViajes.Count > 0 ? Math.Min(3, _todosLosViajes.Count) : 3) envíos de @(_todosLosViajes.Count > 0 ? _todosLosViajes.Count : 42) registrados en tu cuenta
                        </span>
                        <a class="mr-u-table-footer__link" href="/usuario/viajes">
                            <span>Ver historial completo de despachos</span>
                            <span class="material-symbols-outlined mr-u-icon-16">chevron_right</span>
                        </a>
