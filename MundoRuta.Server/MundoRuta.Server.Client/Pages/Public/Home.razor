@code {
    protected override void OnInitialized()
    {
        Sesion.CambioSesion += AlCambiarSesion;
        RedirigirSiCorresponde();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            RedirigirSiCorresponde();
        }
    }

    public void Dispose()
    {
        Sesion.CambioSesion -= AlCambiarSesion;
    }

    private void AlCambiarSesion()
    {
        _ = InvokeAsync(() =>
        {
            RedirigirSiCorresponde();
            StateHasChanged();
        });
    }

    private void RedirigirSiCorresponde()
    {
        if (!Sesion.EstaLogueado)
        {
            return;
        }

        string destino = RutaInicioPorRol.Obtener(Sesion.Rol);
        if (!string.Equals(destino, "/", StringComparison.Ordinal))
        {
            Navegacion.NavigateTo(destino, replace: true);
        }
    }
}
