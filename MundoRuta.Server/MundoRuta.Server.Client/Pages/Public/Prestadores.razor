@page "/servicios/fletes"
@page "/prestadores"
@using System.Globalization
@using MundoRuta.Shared.DTO
@inject IHttpServices Http

<PageTitle>Catálogo de Servicios de Fletes | Mundo Ruta</PageTitle>

<div class="mr-catalogo-page">
    <div class="mr-container mr-catalogo">
        @* Barra superior de migas de pan y fecha *@
        <div class="mr-catalogo__topbar">
            <nav class="mr-catalogo__breadcrumb" aria-label="Ubicación">
                <span class="material-symbols-outlined mr-catalogo__icon-sm">home</span>
                <span>/</span>
                <span class="mr-catalogo__breadcrumb-strong">Centro de Control</span>
                <span>/</span>
                <span class="mr-catalogo__breadcrumb-active">Catálogo de Servicios</span>
            </nav>

            <div class="mr-catalogo__fecha">
                <span class="material-symbols-outlined mr-catalogo__icon-xs">calendar_today</span>
                <span>@_fechaActual</span>
            </div>
        </div>

        @* Header de Búsqueda y Filtros Simplificados *@
        <section class="mr-catalogo__search-card">
            <div class="mr-catalogo__header-row">
                <div class="mr-catalogo__header-info">
                    <div class="mr-catalogo__title-wrap">
                        <h1 class="mr-catalogo__title">Catálogo de Servicios de Fletes</h1>
                        <span class="mr-catalogo__badge-b2b">Red Verificada B2B</span>
                    </div>
                    <p class="mr-catalogo__subtitle">
                        Encontrá transportistas y empresas de mudanzas con habilitación y póliza vigente.
                    </p>
                </div>

                <div class="mr-catalogo__audit">
                    <span class="material-symbols-outlined mr-catalogo__audit-icon">verified</span>
                    <span>Auditado CNRT / RNR</span>
                </div>
            </div>

            <div class="mr-catalogo__filters">
                <div class="mr-catalogo__search-box">
                    <span class="material-symbols-outlined mr-catalogo__field-icon">search</span>
                    <input type="text"
                           class="mr-catalogo__search-input"
                           placeholder="Buscar fletes, empresa, correo, teléfono o ID..."
                           @bind="_busqueda"
                           @bind:event="oninput" />
                </div>

                <div class="mr-catalogo__zone-box">
                    <span class="material-symbols-outlined mr-catalogo__field-icon">location_on</span>
                    <select class="mr-catalogo__zone-select" @bind="_zonaSeleccionada" aria-label="Zona de cobertura">
                        <option value="CABA y GBA Norte">CABA y GBA Norte</option>
                        <option value="Gran Buenos Aires Sur y Oeste">Gran Buenos Aires Sur y Oeste</option>
                        <option value="Córdoba y Zona Centro">Córdoba y Zona Centro</option>
                        <option value="Rosario / Litoral">Rosario / Litoral</option>
                        <option value="Todo el país">Todo el país</option>
                    </select>
                    <span class="material-symbols-outlined mr-catalogo__select-chevron">expand_more</span>
                </div>
            </div>
        </section>

        @* Listado Principal Limpio y Espacioso de Prestadores *@
        @if (_cargando)
        {
            <div class="mr-loading">Cargando prestadores...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mr-alert mr-alert--error">@_error</div>
        }
        else if (_prestadores is null || _prestadores.Count == 0)
        {
            <EmptyState Titulo="Todavía no hay prestadores disponibles"
                        Descripcion="Estamos sumando empresas. Volvé a intentar más adelante." />
        }
        else
        {
            List<PrestadorCatalogoDTO> prestadoresMostrados = ObtenerPrestadoresFiltrados();

            <section class="mr-catalogo__list-section">
                <div class="mr-catalogo__toolbar">
                    <span class="mr-catalogo__count">
                        Mostrando <strong>@prestadoresMostrados.Count @(prestadoresMostrados.Count == 1 ? "empresa verificada" : "empresas verificadas")</strong> @(prestadoresMostrados.Count == 1 ? "disponible" : "disponibles") en tu zona
                    </span>

                    <div class="mr-catalogo__sort">
                        <span class="mr-catalogo__sort-label">Ordenar por:</span>
                        <select class="mr-catalogo__sort-select" @bind="_ordenSeleccionado" aria-label="Ordenar prestadores">
                            <option value="calificados">Mejor Calificados</option>
                            <option value="flota">Mayor Flota</option>
                            <option value="disponibilidad">Disponibilidad Inmediata</option>
                        </select>
                    </div>
                </div>

                @if (prestadoresMostrados.Count == 0)
                {
                    <EmptyState Titulo="Sin resultados para tu búsqueda"
                                Descripcion="Probá con otro correo, teléfono o número de ID." />
                }
                else
                {
                    <div class="mr-catalogo__grid">
                        @foreach (PrestadorCatalogoDTO prestador in prestadoresMostrados)
                        {
                            bool esDestacado = prestador.Id == _prestadorSeleccionadoId;
                            string nombreMostrado = ObtenerNombreMostrado(prestador);

                            <article class="mr-prestador-card @(esDestacado ? "mr-prestador-card--destacado" : string.Empty)"
                                     @onclick="() => AbrirModalDetalleAsync(prestador)">
                                <div class="mr-prestador-card__top">
                                    <div class="mr-prestador-card__header">
                                        <div class="mr-prestador-card__identity">
                                            <div class="mr-prestador-card__id-box @(esDestacado ? "mr-prestador-card__id-box--destacado" : string.Empty)">
                                                #@prestador.Id
                                            </div>
                                            <div class="mr-prestador-card__meta">
                                                <span class="mr-prestador-card__id-label">@nombreMostrado</span>
                                                <span class="mr-prestador-card__role-pill @(esDestacado ? "mr-prestador-card__role-pill--destacado" : string.Empty)">
                                                    Prestador
                                                </span>
                                            </div>
                                        </div>

                                        <span class="mr-prestador-card__status mr-prestador-card__status--activo">
                                            <span class="mr-prestador-card__status-dot"></span>
                                            <span>Activo</span>
                                        </span>
                                    </div>

                                    <div class="mr-prestador-card__contacts">
                                        <div class="mr-prestador-card__contact-row">
                                            <span class="material-symbols-outlined mr-prestador-card__contact-icon">mail</span>
                                            <a class="mr-prestador-card__contact-link mr-prestador-card__contact-link--truncate"
                                               href="mailto:@prestador.Email"
                                               @onclick:stopPropagation="true">
                                                @prestador.Email
                                            </a>
                                        </div>

                                        <div class="mr-prestador-card__contact-row">
                                            <span class="material-symbols-outlined mr-prestador-card__contact-icon">phone</span>
                                            <a class="mr-prestador-card__contact-link"
                                               href="tel:@prestador.Telefono"
                                               @onclick:stopPropagation="true">
                                                @prestador.Telefono
                                            </a>
                                        </div>

                                        <div class="mr-prestador-card__contact-row">
                                            <span class="material-symbols-outlined mr-prestador-card__contact-icon">star</span>
                                            <span class="mr-prestador-card__contact-link">
                                                @if (prestador.TotalCalificaciones > 0)
                                                {
                                                    <text>
                                                        @prestador.PromedioCalificacion.ToString("0.0", CultureInfo.InvariantCulture)
                                                        (@prestador.TotalCalificaciones @(prestador.TotalCalificaciones == 1 ? "calificación" : "calificaciones"))
                                                    </text>
                                                }
                                                else
                                                {
                                                    <text>Sin calificaciones todavía</text>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mr-prestador-card__actions">
                                    <button type="button"
                                            class="mr-prestador-card__btn @(esDestacado ? "mr-prestador-card__btn--destacado" : string.Empty)"
                                            @onclick="() => AbrirModalDetalleAsync(prestador)"
                                            @onclick:stopPropagation="true">
                                        <span>Ver Perfil Público</span>
                                        <span class="material-symbols-outlined mr-prestador-card__btn-arrow">arrow_forward</span>
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    </div>

    @* MODAL DETALLADO DEL PRESTADOR: GET /api/prestador/{id}/perfil-publico *@
    @if (_modalAbierto)
    {
        <div class="mr-pmodal-backdrop" @onclick="CerrarModal">
            <div class="mr-pmodal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                @if (_cargandoDetalle)
                {
                    <div class="mr-pmodal__loading">
                        <span class="spinner-border text-primary me-2" role="status"></span>
                        <span>Cargando perfil del prestador...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_errorDetalle))
                {
                    <div class="mr-pmodal__header">
                        <h2 class="mr-pmodal__title">Detalle del Prestador</h2>
                        <button type="button" class="mr-pmodal__close" title="Cerrar" @onclick="CerrarModal">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <div class="mr-pmodal__body">
                        <div class="mr-alert mr-alert--error">@_errorDetalle</div>
                    </div>
                    <div class="mr-pmodal__footer">
                        <button type="button" class="mr-pmodal__btn-cancel" @onclick="CerrarModal">Cerrar</button>
                    </div>
                }
                else if (_perfilDetalle is not null)
                {
                    @* Encabezado del Perfil Público *@
                    <div class="mr-pmodal__header">
                        <div class="mr-pmodal__header-left">
                            <div class="mr-pmodal__id-box">
                                #@_perfilDetalle.Id
                            </div>
                            <div class="mr-pmodal__header-meta">
                                <div class="mr-pmodal__title-row">
                                    <h2 class="mr-pmodal__title">@ObtenerTituloPerfil(_perfilDetalle)</h2>
                                    <span class="mr-pmodal__badge-active">
                                        <span class="material-symbols-outlined mr-pmodal__badge-icon">check_circle</span>
                                        <span>Activo</span>
                                    </span>
                                    <span class="mr-pmodal__badge-role">
                                        Rol: @(string.IsNullOrWhiteSpace(_perfilDetalle.Rol) ? "Prestador" : _perfilDetalle.Rol)
                                    </span>
                                </div>
                                <div class="mr-pmodal__sub-row">
                                    <span class="mr-pmodal__cuit">
                                        <strong>ID de Registro:</strong> #@_perfilDetalle.Id
                                    </span>
                                    <span>•</span>
                                    <span>
                                        @if (_perfilDetalle.TotalCalificaciones > 0)
                                        {
                                            <text>Calificación: @_perfilDetalle.PromedioCalificacion.ToString("0.0", CultureInfo.InvariantCulture) / 5.0 (@_perfilDetalle.TotalCalificaciones)</text>
                                        }
                                        else
                                        {
                                            <text>Prestador Verificado CNRT</text>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>

                        <button type="button" class="mr-pmodal__close" title="Cerrar" @onclick="CerrarModal">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>

                    @* Contenido Scrollable del Perfil Detallado *@
                    <div class="mr-pmodal__body">
                        @* Bloque de Datos Personales / Contacto del DTO *@
                        <div class="mr-pmodal__section">
                            <h3 class="mr-pmodal__section-title">Datos del Prestador</h3>
                            <div class="mr-pmodal__info-grid">
                                <div class="mr-pmodal__info-item">
                                    <span class="mr-pmodal__info-label">Nombre y Apellido</span>
                                    <span class="mr-pmodal__info-val">@ObtenerNombreApellido(_perfilDetalle)</span>
                                </div>
                                <div class="mr-pmodal__info-item">
                                    <span class="mr-pmodal__info-label">Fecha de Registro</span>
                                    <span class="mr-pmodal__info-val">@_perfilDetalle.FechaRegistro.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="mr-pmodal__info-item">
                                    <span class="mr-pmodal__info-label">Email</span>
                                    <span class="mr-pmodal__info-val mr-pmodal__info-val--truncate">@_perfilDetalle.Email</span>
                                </div>
                                <div class="mr-pmodal__info-item">
                                    <span class="mr-pmodal__info-label">Teléfono</span>
                                    <span class="mr-pmodal__info-val">@_perfilDetalle.Telefono</span>
                                </div>
                            </div>
                        </div>

                        @* Bloque List<VehiculoDTO> Vehiculos *@
                        <div class="mr-pmodal__section">
                            <div class="mr-pmodal__section-header">
                                <h3 class="mr-pmodal__section-title">Vehículos Registrados</h3>
                                <span class="mr-pmodal__vehiculos-count">
                                    @(_perfilDetalle.Vehiculos?.Count ?? 0) @((_perfilDetalle.Vehiculos?.Count ?? 0) == 1 ? "unidad registrada" : "unidades registradas")
                                </span>
                            </div>

                            @if (_perfilDetalle.Vehiculos is null || _perfilDetalle.Vehiculos.Count == 0)
                            {
                                <div class="mr-pmodal__empty-vehicles">
                                    Este prestador no registra unidades cargadas actualmente.
                                </div>
                            }
                            else
                            {
                                <div class="mr-pmodal__vehicles-grid">
                                    @foreach (VehiculoDTO vehiculo in _perfilDetalle.Vehiculos)
                                    {
                                        <div class="mr-pmodal__vehicle-card">
                                            <div class="mr-pmodal__vehicle-top">
                                                <span class="mr-pmodal__vehicle-name">
                                                    @(!string.IsNullOrWhiteSpace(vehiculo.Nombre) ? vehiculo.Nombre : vehiculo.Marca)
                                                </span>
                                                <span class="mr-pmodal__vehicle-tag">
                                                    @(!string.IsNullOrWhiteSpace(vehiculo.TipoVehiculo) ? vehiculo.TipoVehiculo : (!string.IsNullOrWhiteSpace(vehiculo.Marca) ? vehiculo.Marca : "Furgón"))
                                                </span>
                                            </div>
                                            <span class="mr-pmodal__vehicle-cap">
                                                @(!string.IsNullOrWhiteSpace(vehiculo.CapacidadCarga) ? $"Capacidad: {vehiculo.CapacidadCarga}" : $"Licencia: {vehiculo.Licencia}")
                                            </span>
                                            <span class="mr-pmodal__vehicle-plate">
                                                Patente: @vehiculo.Patente
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* Footer de Acciones del Modal *@
                    <div class="mr-pmodal__footer">
                        <button type="button" class="mr-pmodal__btn-cancel" @onclick="CerrarModal">
                            Cerrar
                        </button>
                        <a class="mr-pmodal__btn-contact" href="tel:@_perfilDetalle.Telefono">
                            <span class="material-symbols-outlined mr-pmodal__contact-icon">call</span>
                            <span>Contactar Prestador</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<PrestadorCatalogoDTO>? _prestadores;
    private bool _cargando = true;
    private string? _error;
    private string _busqueda = string.Empty;
    private string _zonaSeleccionada = "CABA y GBA Norte";
    private string _ordenSeleccionado = "calificados";
    private int? _prestadorSeleccionadoId;
    private readonly string _fechaActual = FormatearFechaActual();

    private bool _modalAbierto;
    private bool _cargandoDetalle;
    private string? _errorDetalle;
    private PrestadorPerfilPublicoDTO? _perfilDetalle;

    protected override async Task OnInitializedAsync()
    {
        HttpResp<List<PrestadorCatalogoDTO>> respuesta = await Http.GetAsync<List<PrestadorCatalogoDTO>>("api/servicios/fletes");

        if (respuesta.Error)
        {
            _error = await respuesta.ObtenerMensajeAsync("No pudimos cargar los prestadores.");
        }
        else
        {
            _prestadores = respuesta.Respuesta;

            if (_prestadores is { Count: > 0 })
            {
                _prestadorSeleccionadoId = _prestadores[0].Id;
            }
        }

        _cargando = false;
    }

    private async Task AbrirModalDetalleAsync(PrestadorCatalogoDTO prestador)
    {
        _prestadorSeleccionadoId = prestador.Id;
        _modalAbierto = true;
        _cargandoDetalle = true;
        _errorDetalle = null;
        _perfilDetalle = null;

        HttpResp<PrestadorPerfilPublicoDTO> respuesta =
            await Http.GetAsync<PrestadorPerfilPublicoDTO>($"api/prestador/{prestador.Id}/perfil-publico");

        if (respuesta.Error)
        {
            _errorDetalle = await respuesta.ObtenerMensajeAsync("No pudimos cargar el perfil del prestador.");
        }
        else
        {
            _perfilDetalle = respuesta.Respuesta;
        }

        _cargandoDetalle = false;
    }

    private void CerrarModal()
    {
        _modalAbierto = false;
    }

    private List<PrestadorCatalogoDTO> ObtenerPrestadoresFiltrados()
    {
        if (_prestadores is null || _prestadores.Count == 0)
        {
            return [];
        }

        IEnumerable<PrestadorCatalogoDTO> consulta = _prestadores;

        if (!string.IsNullOrWhiteSpace(_busqueda))
        {
            string termino = _busqueda.Trim();
            consulta = consulta.Where(p =>
                (p.Nombre?.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.RazonSocial?.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Email?.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Telefono?.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false) ||
                p.Id.ToString(CultureInfo.InvariantCulture).Contains(termino, StringComparison.OrdinalIgnoreCase));
        }

        consulta = _ordenSeleccionado switch
        {
            "flota" => consulta.OrderByDescending(p => p.Id),
            "disponibilidad" => consulta.OrderBy(p => p.Id),
            _ => consulta.OrderByDescending(p => p.PromedioCalificacion)
                         .ThenByDescending(p => p.TotalCalificaciones)
                         .ThenBy(p => p.Id)
        };

        return consulta.ToList();
    }

    private static string ObtenerNombreMostrado(PrestadorCatalogoDTO prestador)
    {
        string razonSocial = prestador.RazonSocial?.Trim() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(razonSocial))
        {
            return razonSocial;
        }

        string nombre = prestador.Nombre?.Trim() ?? string.Empty;
        return string.IsNullOrWhiteSpace(nombre) ? $"ID: {prestador.Id}" : nombre;
    }

    private static string ObtenerTituloPerfil(PrestadorPerfilPublicoDTO perfil)
    {
        if (!string.IsNullOrWhiteSpace(perfil.RazonSocial))
        {
            return perfil.RazonSocial.Trim();
        }

        string nombreCompleto = $"{perfil.Nombre} {perfil.Apellido}".Trim();
        return string.IsNullOrWhiteSpace(nombreCompleto) ? $"Prestador #{perfil.Id}" : nombreCompleto;
    }

    private static string ObtenerNombreApellido(PrestadorPerfilPublicoDTO perfil)
    {
        string nombreCompleto = $"{perfil.Nombre} {perfil.Apellido}".Trim();
        return string.IsNullOrWhiteSpace(nombreCompleto) ? ObtenerTituloPerfil(perfil) : nombreCompleto;
    }

    private static string FormatearFechaActual()
    {
        CultureInfo cultura = new CultureInfo("es-AR");
        string fecha = DateTime.Now.ToString("dd MMM yyyy", cultura).Replace(".", string.Empty);
        return $"{fecha} • GMT-3";
    }
}
