@page "/registro"
@using MundoRuta.Shared.DTO
@inject IAuthServicio Auth
@inject NavigationManager Navegacion

<PageTitle>Crear cuenta | Mundo Ruta</PageTitle>

<div class="mr-register-page">
    <!-- Fondos de profundidad ambiental (glows difuminados) -->
    <div class="mr-glow mr-glow--left" aria-hidden="true"></div>
    <div class="mr-glow mr-glow--right" aria-hidden="true"></div>

    <div class="mr-register-container">
        <div class="mr-register-card">
            <!-- Encabezado -->
            <div class="mr-header">
                <div class="mr-header__pill">
                    <span class="mr-header__pill-dot"></span>
                    <span class="mr-header__pill-text">Plataforma Logística</span>
                </div>
                <h1 class="mr-header__title">Crea tu cuenta</h1>
                <p class="mr-header__subtitle">Únete a la red líder de logística y fletes en tiempo real</p>
            </div>

            <!-- Stepper Indicator -->
            <div class="mr-stepper">
                <span class="mr-stepper__title">Selecciona tu perfil</span>
                <span class="mr-stepper__badge">Paso 1 de 2</span>
            </div>

            <!-- Selector Interactivo de Perfil -->
            <div class="mr-roles">
                <!-- Perfil 1: Usuario -->
                <div class="mr-role-card @(!_esPrestador ? "mr-role-card--active" : "")"
                     @onclick="SeleccionarUsuario"
                     role="button"
                     tabindex="0"
                     aria-pressed="@(!_esPrestador)">
                    <div class="mr-role-card__top">
                        <div class="mr-role-card__icon">
                            <span class="material-symbols-outlined">package_2</span>
                        </div>
                        <span class="mr-role-card__badge">Empresa o Particular</span>
                    </div>
                    <div class="mr-role-card__main">
                        <div class="mr-role-card__title-row">
                            <h2 class="mr-role-card__title">Soy Usuario</h2>
                            <div class="mr-role-card__check">
                                <span class="material-symbols-outlined">check</span>
                            </div>
                        </div>
                        <p class="mr-role-card__desc">Quiero enviar fletes, cargas o encomiendas</p>
                    </div>
                </div>

                <!-- Perfil 2: Prestador -->
                <div class="mr-role-card @(_esPrestador ? "mr-role-card--active" : "")"
                     @onclick="SeleccionarPrestador"
                     role="button"
                     tabindex="0"
                     aria-pressed="@_esPrestador">
                    <div class="mr-role-card__top">
                        <div class="mr-role-card__icon">
                            <span class="material-symbols-outlined">local_shipping</span>
                        </div>
                        <span class="mr-role-card__badge">Conductor / Flota</span>
                    </div>
                    <div class="mr-role-card__main">
                        <div class="mr-role-card__title-row">
                            <h2 class="mr-role-card__title">Soy Prestador</h2>
                            <div class="mr-role-card__check">
                                <span class="material-symbols-outlined">check</span>
                            </div>
                        </div>
                        <p class="mr-role-card__desc">Tengo vehículo y quiero brindar servicios de transporte</p>
                    </div>
                </div>
            </div>

            <!-- Alerta de Error -->
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="mr-alert mr-alert--error" role="alert">
                    <span class="material-symbols-outlined mr-alert__icon">error</span>
                    <div>@_error</div>
                </div>
            }

            <!-- Formulario de Registro -->
            <EditForm Model="_modelo" OnSubmit="RegistrarAsync" class="mr-auth-form">
                <div class="mr-form-grid">
                    <!-- Nombre -->
                    <div class="mr-field">
                        <label class="mr-field__label" for="reg-nombre">
                            Nombre <span class="mr-field__req">*</span>
                        </label>
                        <div class="mr-input-box">
                            <span class="material-symbols-outlined mr-input-icon">person</span>
                            <input id="reg-nombre"
                                   class="mr-input"
                                   type="text"
                                   autocomplete="given-name"
                                   placeholder="Juan"
                                   @bind="_modelo.Nombre" />
                        </div>
                    </div>

                    <!-- Apellido -->
                    <div class="mr-field">
                        <label class="mr-field__label" for="reg-apellido">
                            Apellido <span class="mr-field__req">*</span>
                        </label>
                        <div class="mr-input-box">
                            <span class="material-symbols-outlined mr-input-icon">badge</span>
                            <input id="reg-apellido"
                                   class="mr-input"
                                   type="text"
                                   autocomplete="family-name"
                                   placeholder="Pérez"
                                   @bind="_modelo.Apellido" />
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="mr-field">
                        <label class="mr-field__label" for="reg-email">
                            Correo Electrónico <span class="mr-field__req">*</span>
                        </label>
                        <div class="mr-input-box">
                            <span class="material-symbols-outlined mr-input-icon">mail</span>
                            <input id="reg-email"
                                   class="mr-input"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="ejemplo@mundoruta.com"
                                   @bind="_modelo.Email" />
                        </div>
                    </div>

                    <!-- Teléfono -->
                    <div class="mr-field">
                        <label class="mr-field__label" for="reg-telefono">
                            Teléfono <span class="mr-field__req">*</span>
                        </label>
                        <div class="mr-input-box">
                            <span class="material-symbols-outlined mr-input-icon">phone</span>
                            <input id="reg-telefono"
                                   class="mr-input"
                                   type="tel"
                                   autocomplete="tel"
                                   placeholder="+54 9 11 1234-5678"
                                   @bind="_modelo.Telefono" />
                        </div>
                    </div>

                    <!-- Campos Condicionales de Empresa/Prestador -->
                    @if (_esPrestador)
                    {
                        <div class="mr-field">
                            <label class="mr-field__label" for="reg-razon">
                                Razón Social <span class="mr-field__req">*</span>
                            </label>
                            <div class="mr-input-box">
                                <span class="material-symbols-outlined mr-input-icon">business</span>
                                <input id="reg-razon"
                                       class="mr-input"
                                       type="text"
                                       placeholder="Transportes Ruta S.A."
                                       @bind="_modelo.RazonSocial" />
                            </div>
                        </div>

                        <div class="mr-field">
                            <label class="mr-field__label" for="reg-cuit">
                                CUIT <span class="mr-field__req">*</span>
                            </label>
                            <div class="mr-input-box">
                                <span class="material-symbols-outlined mr-input-icon">pin</span>
                                <input id="reg-cuit"
                                       class="mr-input"
                                       type="text"
                                       placeholder="30-12345678-9"
                                       @bind="_modelo.Cuit" />
                            </div>
                        </div>
                    }
                </div>

                <!-- Contraseña -->
                <div class="mr-field mt-2">
                    <div class="mr-field__header">
                        <label class="mr-field__label" for="reg-password">
                            Contraseña <span class="mr-field__req">*</span>
                        </label>
                        <span class="mr-field__hint">Mínimo 6 caracteres</span>
                    </div>
                    <div class="mr-input-box">
                        <span class="material-symbols-outlined mr-input-icon">lock</span>
                        <input id="reg-password"
                               class="mr-input mr-input--toggle"
                               type="@(_mostrarPassword ? "text" : "password")"
                               autocomplete="new-password"
                               placeholder="Crea una clave segura"
                               @bind="_modelo.Password"
                               @bind:event="oninput" />
                        <button type="button"
                                class="mr-toggle-btn"
                                @onclick="() => _mostrarPassword = !_mostrarPassword"
                                title="@(_mostrarPassword ? "Ocultar contraseña" : "Mostrar contraseña")"
                                tabindex="-1">
                            <span class="material-symbols-outlined">@(_mostrarPassword ? "visibility_off" : "visibility")</span>
                        </button>
                    </div>

                    <!-- Indicador de Fortaleza -->
                    <div class="mr-strength">
                        <div class="mr-strength__bars">
                            <div class="mr-strength__bar @(NivelFortaleza >= 1 ? "mr-strength__bar--active " + ClaseFortaleza : "")"></div>
                            <div class="mr-strength__bar @(NivelFortaleza >= 2 ? "mr-strength__bar--active " + ClaseFortaleza : "")"></div>
                            <div class="mr-strength__bar @(NivelFortaleza >= 3 ? "mr-strength__bar--active " + ClaseFortaleza : "")"></div>
                        </div>
                        <span class="mr-strength__label @ClaseFortaleza">@EtiquetaFortaleza</span>
                    </div>
                </div>

                <!-- Confirmar Contraseña -->
                <div class="mr-field mt-2">
                    <label class="mr-field__label" for="reg-confirmar">
                        Confirmar Contraseña <span class="mr-field__req">*</span>
                    </label>
                    <div class="mr-input-box">
                        <span class="material-symbols-outlined mr-input-icon">gpp_maybe</span>
                        <input id="reg-confirmar"
                               class="mr-input mr-input--toggle"
                               type="@(_mostrarConfirmar ? "text" : "password")"
                               autocomplete="new-password"
                               placeholder="Repite tu contraseña"
                               @bind="_modelo.ConfirmarPassword" />
                        <button type="button"
                                class="mr-toggle-btn"
                                @onclick="() => _mostrarConfirmar = !_mostrarConfirmar"
                                title="@(_mostrarConfirmar ? "Ocultar contraseña" : "Mostrar contraseña")"
                                tabindex="-1">
                            <span class="material-symbols-outlined">@(_mostrarConfirmar ? "visibility_off" : "visibility")</span>
                        </button>
                    </div>
                </div>

                <!-- Botón CTA Registrar -->
                <button type="submit" class="mr-btn-cta" disabled="@_cargando">
                    <span>@(_cargando ? "Creando cuenta..." : "Crear cuenta")</span>
                    <span class="material-symbols-outlined">arrow_forward</span>
                </button>
            </EditForm>

            <!-- Link Iniciar Sesión -->
            <div class="mr-card-footer">
                <span>¿Ya tienes cuenta?</span>
                <a class="mr-card-footer__link" href="@ObtenerLoginUrl()">Iniciar sesión</a>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly RegistroModelo _modelo = new RegistroModelo();
    private bool _esPrestador;
    private bool _cargando;
    private bool _mostrarPassword;
    private bool _mostrarConfirmar;
    private string? _error;

    [SupplyParameterFromQuery(Name = "redirect")]
    public string? RedirectUrl { get; set; }

    private void SeleccionarUsuario()
    {
        _esPrestador = false;
    }

    private void SeleccionarPrestador()
    {
        _esPrestador = true;
    }

    private int NivelFortaleza
    {
        get
        {
            string p = _modelo.Password ?? string.Empty;
            if (string.IsNullOrEmpty(p)) return 0;
            if (p.Length < 6) return 1;
            if (p.Length < 10) return 2;
            return 3;
        }
    }

    private string EtiquetaFortaleza => NivelFortaleza switch
    {
        1 => "Débil",
        2 => "Media",
        3 => "Segura",
        _ => "Fortaleza"
    };

    private string ClaseFortaleza => NivelFortaleza switch
    {
        1 => "mr-strength--debil",
        2 => "mr-strength--media",
        3 => "mr-strength--segura",
        _ => ""
    };

    private async Task RegistrarAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_modelo.Nombre)
            || string.IsNullOrWhiteSpace(_modelo.Apellido)
            || string.IsNullOrWhiteSpace(_modelo.Email)
            || string.IsNullOrWhiteSpace(_modelo.Telefono)
            || string.IsNullOrWhiteSpace(_modelo.Password))
        {
            _error = "Completá todos los campos obligatorios.";
            return;
        }

        if (_modelo.Password.Length < 6)
        {
            _error = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        if (!string.Equals(_modelo.Password, _modelo.ConfirmarPassword, StringComparison.Ordinal))
        {
            _error = "Las contraseñas no coinciden.";
            return;
        }

        if (_esPrestador
            && (string.IsNullOrWhiteSpace(_modelo.RazonSocial) || string.IsNullOrWhiteSpace(_modelo.Cuit)))
        {
            _error = "Completá la razón social y el CUIT.";
            return;
        }

        RegisterRequestDto dto = new RegisterRequestDto
        {
            Nombre = _modelo.Nombre.Trim(),
            Apellido = _modelo.Apellido.Trim(),
            Email = _modelo.Email.Trim(),
            Telefono = _modelo.Telefono.Trim(),
            Password = _modelo.Password,
            Rol = _esPrestador ? Roles.Prestador : Roles.Usuario,
            RazonSocial = _esPrestador ? _modelo.RazonSocial.Trim() : string.Empty,
            Cuit = _esPrestador ? _modelo.Cuit.Trim() : string.Empty
        };

        _cargando = true;

        HttpResp<int> respuesta = await Auth.RegistrarAsync(dto);

        if (respuesta.Error)
        {
            _error = await respuesta.ObtenerMensajeAsync("No pudimos crear la cuenta.");
            _cargando = false;
            return;
        }

        string registrado = _esPrestador ? "2" : "1";
        _cargando = false;
        Navegacion.NavigateTo(ObtenerLoginUrl(registrado));
    }

    private string ObtenerLoginUrl()
    {
        string registrado = _esPrestador ? "2" : "1";
        return ObtenerLoginUrl(registrado);
    }

    private string ObtenerLoginUrl(string registrado)
    {
        string url = "/login?registrado=" + registrado;
        string redirect = ObtenerRedirectValido(RedirectUrl);

        if (!string.IsNullOrEmpty(redirect))
        {
            url += "&redirect=" + Uri.EscapeDataString(redirect);
        }

        return url;
    }

    private static string ObtenerRedirectValido(string? redirect)
    {
        if (!string.IsNullOrWhiteSpace(redirect)
            && redirect.StartsWith('/')
            && !redirect.StartsWith("//"))
        {
            return redirect;
        }

        return string.Empty;
    }

    private sealed class RegistroModelo
    {
        public string Nombre { get; set; } = string.Empty;
        public string Apellido { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmarPassword { get; set; } = string.Empty;
        public string RazonSocial { get; set; } = string.Empty;
        public string Cuit { get; set; } = string.Empty;
    }
}
