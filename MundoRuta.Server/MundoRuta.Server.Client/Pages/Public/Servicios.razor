@page "/servicios"
@inject SesionEstado Sesion

<PageTitle>Servicios | Mundo Ruta</PageTitle>

<div class="mr-page">
    <div class="mr-container">
        <PageHeader Titulo="Nuestros servicios"
                    Descripcion="Soluciones de transporte para personas, cargas y empresas." />

        <div class="mr-grid">
            <article class="mr-card">
                <h2 class="mr-card__title">Fletes y mudanzas</h2>
                <p class="mr-muted">
                    Trasladá muebles, electrodomésticos y objetos voluminosos con prestadores
                    acostumbrados a coordinar cada detalle.
                </p>
                <a href="@ObtenerEnlaceSolicitud("Fletes y mudanzas")">Solicitar</a>
            </article>

            <article class="mr-card">
                <h2 class="mr-card__title">Transporte de carga</h2>
                <p class="mr-muted">
                    Mové mercadería entre localidades con vehículos habilitados y seguimiento
                    del estado del viaje.
                </p>
                <a href="@ObtenerEnlaceSolicitud("Transporte de carga")">Solicitar</a>
            </article>

            <article class="mr-card">
                <h2 class="mr-card__title">Envíos programados</h2>
                <p class="mr-muted">
                    Agendá retiros y entregas recurrentes para que tu operación no se detenga.
                </p>
                <a href="@ObtenerEnlaceSolicitud("Envíos programados")">Solicitar</a>
            </article>

            <article class="mr-card">
                <h2 class="mr-card__title">Empresas</h2>
                <p class="mr-muted">
                    Centralizá las solicitudes de tu equipo y coordiná los viajes con una red
                    de prestadores aprobados.
                </p>
                <a href="@ObtenerEnlaceSolicitud("Empresas")">Solicitar</a>
            </article>
        </div>

        <p class="mr-muted mt-4 mb-0">
            ¿No encontrás lo que buscás? <a href="@ObtenerEnlaceSolicitud(null)">Contanos qué necesitás</a>.
        </p>
    </div>
</div>

@code {
    private string ObtenerEnlaceSolicitud(string? categoria = null)
    {
        string destino = string.IsNullOrWhiteSpace(categoria)
            ? "/usuario/solicitar"
            : $"/usuario/solicitar?categoria={Uri.EscapeDataString(categoria)}";

        return Sesion.EstaLogueado
            ? destino
            : $"/registro?redirect={Uri.EscapeDataString(destino)}";
    }
}
