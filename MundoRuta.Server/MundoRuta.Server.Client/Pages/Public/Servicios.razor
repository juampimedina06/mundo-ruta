@page "/servicios"

<PageTitle>Servicios | Mundo Ruta</PageTitle>

<div class="mr-page">
    <div class="mr-container">
        <PageHeader Titulo="Nuestros servicios"
                    Descripcion="Soluciones de transporte para personas, cargas y empresas." />

        <div class="mr-grid">
            <article class="mr-card">
                <h2 class="mr-card__title">Fletes y mudanzas</h2>
                <p class="mr-muted">
                    Trasladá muebles, electrodomésticos y objetos voluminosos con prestadores
                    acostumbrados a coordinar cada detalle.
                </p>
                <a href="/registro">Solicitar</a>
            </article>

            <article class="mr-card">
                <h2 class="mr-card__title">Transporte de carga</h2>
                <p class="mr-muted">
                    Mové mercadería entre localidades con vehículos habilitados y seguimiento
                    del estado del viaje.
                </p>
                <a href="/registro">Solicitar</a>
            </article>

            <article class="mr-card">
                <h2 class="mr-card__title">Envíos programados</h2>
                <p class="mr-muted">
                    Agendá retiros y entregas recurrentes para que tu operación no se detenga.
                </p>
                <a href="/registro">Solicitar</a>
            </article>

            <article class="mr-card">
                <h2 class="mr-card__title">Empresas</h2>
                <p class="mr-muted">
                    Centralizá las solicitudes de tu equipo y coordiná los viajes con una red
                    de prestadores aprobados.
                </p>
                <a href="/registro">Solicitar</a>
            </article>
        </div>

        <p class="mr-muted mt-4 mb-0">
            ¿No encontrás lo que buscás? <a href="/registro">Contanos qué necesitás</a>.
        </p>
    </div>
</div>
