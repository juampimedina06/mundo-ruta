@page "/prestador/{PrestadorId:int}/viajes"
@inject HttpClient Http

<PageTitle>Viajes de la Empresa</PageTitle>

<h1>Viajes de la Empresa</h1>
<PrestadorTabs PrestadorId="PrestadorId" />

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <ListadoViajes Viajes="viajes" MensajeVacio="Todavía no hay viajes registrados." />
}

@code {
    [Parameter] public int PrestadorId { get; set; }

    private List<ViajePrestadorDTO>? viajes;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            viajes = await Http.GetFromJsonAsync<List<ViajePrestadorDTO>>($"api/prestador/{PrestadorId}/viajes") ?? new();
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar los viajes: {ex.Message}";
        }
    }
}