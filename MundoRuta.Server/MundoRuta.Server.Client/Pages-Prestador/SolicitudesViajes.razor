@page "/prestador/{PrestadorId:int}/solicitudes"
@inject HttpClient Http

<PageTitle>Solicitudes de Viajes</PageTitle>

<h1>Solicitudes de Viajes</h1>
<PrestadorTabs PrestadorId="PrestadorId" />

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <ListadoViajes Viajes="solicitudes" MensajeVacio="No hay solicitudes pendientes." />
}

@code {
    [Parameter] public int PrestadorId { get; set; }

    private List<ViajePrestadorDTO>? solicitudes;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            solicitudes = await Http.GetFromJsonAsync<List<ViajePrestadorDTO>>($"api/prestador/{PrestadorId}/solicitudes") ?? new();
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar las solicitudes: {ex.Message}";
        }
    }
}
